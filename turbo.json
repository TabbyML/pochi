{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "tsc": {
      "dependsOn": ["^tsc"]
    },
    "test": {},
    "test:integration": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "DISPLAY",
        "VSCODE_VERSION",
        "POCHI_E2E_MODEL",
        "POCHI_E2E_VSCODE_EXECUTABLE"
      ]
    },
    "build": {
      "outputLogs": "errors-only",
      "dependsOn": ["tsc"],
      "outputs": ["dist/**"]
    }
  },
  "globalPassThroughEnv": ["NODE_ENV", "POCHI_API_KEY"],
  "boundaries": {
    "implicitDependencies": ["vitest"],
    "tags": {
      "public": {
        "dependencies": {
          "allow": ["public"]
        }
      }
    }
  }
}
