pe":"heading","url":"/developer-updates#weekly-update-4","content":"Weekly Update #4"},"1844":{"id":"/developer-updates-340","page_id":"/developer-updates","type":"heading","url":"/developer-updates#sep-19-2025","content":"Sep 19, 2025"},"1845":{"id":"/developer-updates-341","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-4-1","content":"Weekly Update #4"},"1846":{"id":"/developer-updates-342","page_id":"/developer-updates","type":"heading","url":"/developer-updates#tldr-37","content":"TL;DR"},"1847":{"id":"/developer-updates-343","page_id":"/developer-updates","type":"heading","url":"/developer-updates#features-","content":"Features 🚀"},"1848":{"id":"/developer-updates-344","page_id":"/developer-updates","type":"heading","url":"/developer-updates#enhancements-","content":"Enhancements ✨"},"1849":{"id":"/developer-updates-345","page_id":"/developer-updates","type":"heading","url":"/developer-updates#bug-fixes-","content":"Bug fixes 🐛"},"1850":{"id":"/developer-updates-346","page_id":"/developer-updates","type":"heading","url":"/developer-updates#new-contributors-","content":"New Contributors 🐾"},"1851":{"id":"/developer-updates-347","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-3","content":"Weekly Update #3"},"1852":{"id":"/developer-updates-348","page_id":"/developer-updates","type":"heading","url":"/developer-updates#sep-12-2025","content":"Sep 12, 2025"},"1853":{"id":"/developer-updates-349","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-3-1","content":"Weekly Update #3"},"1854":{"id":"/developer-updates-350","page_id":"/developer-updates","type":"heading","url":"/developer-updates#tldr-38","content":"TL;DR"},"1855":{"id":"/developer-updates-351","page_id":"/developer-updates","type":"heading","url":"/developer-updates#features--1","content":"Features 🚀"},"1856":{"id":"/developer-updates-352","page_id":"/developer-updates","type":"heading","url":"/developer-updates#enhancements--1","content":"Enhancements ✨"},"1857":{"id":"/developer-updates-353","page_id":"/developer-updates","type":"heading","url":"/developer-updates#bug-fixes--1","content":"Bug fixes 🐛"},"1858":{"id":"/developer-updates-354","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-2","content":"Weekly Update #2"},"1859":{"id":"/developer-updates-355","page_id":"/developer-updates","type":"heading","url":"/developer-updates#sep-5-2025","content":"Sep 5, 2025"},"1860":{"id":"/developer-updates-356","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-2-1","content":"Weekly Update #2"},"1861":{"id":"/developer-updates-357","page_id":"/developer-updates","type":"heading","url":"/developer-updates#tldr-39","content":"TL;DR"},"1862":{"id":"/developer-updates-358","page_id":"/developer-updates","type":"heading","url":"/developer-updates#features--2","content":"Features 🚀"},"1863":{"id":"/developer-updates-359","page_id":"/developer-updates","type":"heading","url":"/developer-updates#enhancements--2","content":"Enhancements ✨"},"1864":{"id":"/developer-updates-360","page_id":"/developer-updates","type":"heading","url":"/developer-updates#bug-fixes--2","content":"Bug Fixes 🐛"},"1865":{"id":"/developer-updates-361","page_id":"/developer-updates","type":"heading","url":"/developer-updates#new-contributors--1","content":"New Contributors 🐾"},"1866":{"id":"/developer-updates-362","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-1","content":"Weekly Update #1"},"1867":{"id":"/developer-updates-363","page_id":"/developer-updates","type":"heading","url":"/developer-updates#aug-29-2025","content":"Aug 29, 2025"},"1868":{"id":"/developer-updates-364","page_id":"/developer-updates","type":"heading","url":"/developer-updates#weekly-update-1-1","content":"Weekly Update #1"},"1869":{"id":"/developer-updates-365","page_id":"/developer-updates","type":"heading","url":"/developer-updates#tldr-40","content":"TL;DR"},"1870":{"id":"/developer-updates-366","page_id":"/developer-updates","type":"heading","url":"/developer-updates#enhancements--3","content":"Enhancements ✨"},"1871":{"id":"/developer-updates-367","page_id":"/developer-updates","type":"heading","url":"/developer-updates#bug-fixes--3","content":"Bug Fixes 🐛"},"1872":{"id":"/developer-updates-368","page_id":"/developer-updates","type":"text","url":"/developer-updates","content":"Welcome to the Pochi Developer Updates — a digest of what's new in the codebase."},"1873":{"id":"/developer-updates-369","page_id":"/developer-updates","type":"text","url":"/developer-updates","content":"Here you will find highlights on features, enhancements, and bug fixes, plus insights into how we're improving the developer experience. Come back often! 👋"},"1874":{"id":"/developer-updates-370","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr","content":"Pochi 0.70 is expected on September 9. It is shaping up to make long-running command work more continuous: commands that need more time will keep running in the background, completed jobs will reach Pochi sooner, and large pasted prompts will no longer make the chat input unresponsive. A unified place to manage background work is also on the way."},"1875":{"id":"/developer-updates-371","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr","content":"More below!"},"1876":{"id":"/developer-updates-372","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features","content":"Long commands will keep running instead of timing out: When a supported command reaches its foreground time limit, Pochi will move the same process into a background terminal instead of stopping or restarting it. Existing output and live updates will carry over, and the terminal will remain interactive while Pochi continues with other work."},"1877":{"id":"/developer-updates-373","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features","content":"This will be especially useful for builds, test suites, setup scripts, and other commands whose duration is difficult to predict. #1930"},"1878":{"id":"/developer-updates-374","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements","content":"Background-job results will reach Pochi sooner: When a background command finishes during an active task, Pochi will receive the result at the next safe step instead of waiting until the turn ends. This will let it react to completed tests, builds, and other jobs while the result is still useful, without resuming a task you intentionally paused. #1932"},"1879":{"id":"/developer-updates-375","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes","content":"Large pastes will keep the chat input responsive: Work planned for Pochi 0.70 will prevent the composer from becoming unresponsive for several seconds when you paste a large block of text."},"1880":{"id":"/developer-updates-376","page_id":"/developer-updates","type":"text","url":"/developer-updates#-coming-up","content":"Manage background work in one place: A unified panel in the chat will bring background tasks and terminals together, with live status indicators and collapsible history for busy sessions. This will make it easier to see what is still running and reopen the work you need without searching across separate views. #1926"},"1881":{"id":"/developer-updates-377","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-1","content":"Pochi 0.68 is expected on August 31. Alongside the run-and-verify workflows and long-history reliability previewed in the last update, this release will make generated widgets useful beyond the chat and smooth out everyday friction around live conversations, file mentions, and background jobs."},"1882":{"id":"/developer-updates-378","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-1","content":"More below!"},"1883":{"id":"/developer-updates-379","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-1","content":"Save and preview rendered widgets: Generated widgets will be able to open in a dedicated preview beside the chat or be saved as self-contained HTML files. Saved widgets will preserve their interactivity, styling, charts, and state, making it easy to share or use them outside the conversation where they were created."},"1884":{"id":"/developer-updates-380","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-1","content":"This will be especially useful for interactive explainers, dashboards, and visualizations that you want to inspect at a larger size or keep as standalone artifacts. #1907"},"1885":{"id":"/developer-updates-381","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-1","content":"Your browser does not support the video tag."},"1886":{"id":"/developer-updates-382","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-1","content":"Clearer background-job notifications: Sent and queued background-job updates will use the same compact command-and-status layout. Completed jobs will also retain a working link to their recorded output after the terminal closes, making the results of long-running commands easy to revisit. #1921"},"1887":{"id":"/developer-updates-383","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-1","content":"Live chats will follow new output without fighting your scroll: Streaming conversations will stay pinned to the latest response until you deliberately scroll up, at which point Pochi will preserve your reading position. Scrolling near the bottom will resume automatic following, and the chat will show only one scrollbar even when messages contain rendered math. #1917, #1920"},"1888":{"id":"/developer-updates-384","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-1","content":"File mentions will find non-Latin names: Searching with @ will match file names containing Chinese, Japanese, Korean, accented, and other non-ASCII characters instead of treating those characters as separators and returning no results. #1919"},"1889":{"id":"/developer-updates-385","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-1","content":"Forked and compacted tasks will keep their environment context: Tasks created from a compacted checkpoint, a forked conversation, or a regenerated response will continue receiving the repository, editor, terminal, and system details they need to work in the correct environment. #1916"},"1890":{"id":"/developer-updates-386","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-2","content":"Pochi 0.66 shipped on August 20 with the automatic background-job completion notifications and cleaner changed-files summary previewed in last week's update. With that release out, Pochi 0.68 is expected on August 31 and is shaping up to make agents better at exercising and verifying the software they build, while keeping very long task histories responsive and available instead of letting them overwhelm the chat view."},"1891":{"id":"/developer-updates-387","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-2","content":"More below!"},"1892":{"id":"/developer-updates-388","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-2","content":"Run and verify software through its real interface: Pochi is expected to gain built-in workflows for exercising CLI tools, servers, browser apps, desktop apps, terminal interfaces, libraries, and agent workflows. It will be able to run a project through the interface its users actually see, formally verify the result when asked, and create reusable project-specific run instructions for later tasks."},"1893":{"id":"/developer-updates-389","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-2","content":"This will be most useful when tests alone cannot show whether an interactive workflow behaves correctly from end to end. #1904"},"1894":{"id":"/developer-updates-390","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-2","content":"Long task histories will stay responsive: Pochi will render long conversations in manageable sections, keeping the newest work anchored in view while still letting you load earlier messages. This is expected to prevent large histories with many sub-agent steps from exhausting the chat view's memory or causing the page to collapse. #1900"},"1895":{"id":"/developer-updates-391","page_id":"/developer-updates","type":"text","url":"/developer-updates#-coming-up-1","content":"Save rendered widgets to a file: Planned work for 0.68 will let you save generated widget content to a file instead of leaving it only in the chat."},"1896":{"id":"/developer-updates-392","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-3","content":"Pochi 0.66 is expected on August 19. It is shaping up to make long-running commands easier to leave in the background without losing momentum, while keeping the changed-files summary focused by showing each edited file only once."},"1897":{"id":"/developer-updates-393","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-3","content":"More below!"},"1898":{"id":"/developer-updates-394","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-3","content":"Background jobs will report back automatically: In Pochi 0.66, long-running commands will be able to continue in the background while Pochi moves on to other work. When a job finishes, Pochi will receive a completion notification, and the job and its output will remain attached to the task so it can inspect the result without repeatedly checking whether the command is done."},"1899":{"id":"/developer-updates-395","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-3","content":"Today, a completed background job can sit unnoticed until Pochi polls it again, slowing down workflows built around development servers, test suites, and other long-running commands."},"1900":{"id":"/developer-updates-396","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-3","content":"This will be most useful on tasks where several steps can continue while a command runs."},"1901":{"id":"/developer-updates-397","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-3","content":"Each changed file will appear only once: The task's changed-files summary will recognize absolute and workspace-relative paths as the same file, preventing duplicate entries for a single edit. Diff and undo actions will continue to work from the one remaining entry. #1889"},"1902":{"id":"/developer-updates-398","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-4","content":"Pochi can now move work into a clean, isolated checkout without disturbing the changes already in your workspace. This release also gives you tighter control over the edits sent as context and makes long conversations more reliable across languages and live updates."},"1903":{"id":"/developer-updates-399","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-4","content":"More below!"},"1904":{"id":"/developer-updates-400","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-4","content":"Isolated workspaces without disturbing current work: Pochi can now create a separate Git worktree when a task needs another branch or committed source state. Your current files and in-progress changes stay untouched while the isolated task gets a complete checkout to inspect, build, test, or modify."},"1905":{"id":"/developer-updates-401","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-4","content":"This gives review agents a safe place for deeper validation, and also helps when your current workspace has pending work but you want Pochi to handle something else in parallel. #1820"},"1906":{"id":"/developer-updates-402","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-4","content":"Your browser does not support the video tag."},"1907":{"id":"/developer-updates-403","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-2","content":"Remove your edits from message context: Manual file edits detected by Pochi now have a remove action in the chat input, letting you leave unrelated changes out before sending. Switching branches also clears stale edits so changes from the previous branch do not silently follow your next message. #1818, #1846, #1851"},"1908":{"id":"/developer-updates-404","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-4","content":"More accurate token estimates for Chinese, Japanese, and Korean text: Context estimates now account for how CJK text is tokenized and calibrate against the model's reported usage during the session. Previously the same flat character ratio was used for every language, which could substantially undercount CJK-heavy conversations. #1828"},"1909":{"id":"/developer-updates-405","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-4","content":"Streaming no longer steals your scroll position: When you scroll up to read earlier messages, incoming output now leaves you where you are instead of repeatedly forcing the task view back to the bottom. Background-task detail panels also size and follow their live output more reliably. #1816, #1830"},"1910":{"id":"/developer-updates-406","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-4","content":"Diff highlights fill the full row: Added and removed line backgrounds now extend across the complete width of the diff viewer, including while you scroll horizontally, instead of ending after the code text. #1819"},"1911":{"id":"/developer-updates-407","page_id":"/developer-updates","type":"text","url":"/developer-updates#-coming-up-2","content":"Richer terminal context: We're continuing to refine how Pochi captures and presents selected terminal text and command history before bringing the experience forward as a headline feature. #1812, #1824"},"1912":{"id":"/developer-updates-408","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-5","content":"This release makes long-running work more transparent and controllable. You get a clearer picture of where a task spends its context and its time, and quicker access to the controls that shape it."},"1913":{"id":"/developer-updates-409","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-5","content":"More below!"},"1914":{"id":"/developer-updates-410","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Pochi can read your existing terminals: Pochi can now inspect output from any terminal that is already open in VS Code, not only background jobs it started itself. Your own terminals stay read-only to Pochi, so it can read their output but can never close or kill them."},"1915":{"id":"/developer-updates-411","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Previously Pochi could only read output from background jobs it had started. A dev server or test watcher running in a terminal you opened yourself was invisible to it, so it had to spin up a duplicate process to see comparable output."},"1916":{"id":"/developer-updates-412","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Most useful when a development server, test watcher, or build is already running and you want Pochi to diagnose its latest output without starting a duplicate process. #1779"},"1917":{"id":"/developer-updates-413","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Your browser does not support the video tag."},"1918":{"id":"/developer-updates-414","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Predictable compaction for long tasks: You can now see and set the point where Pochi compacts a long conversation. The token-usage bar shows where compaction will trigger, and the default is 160k tokens, which advanced users can raise for models with larger context windows."},"1919":{"id":"/developer-updates-415","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Previously the compaction point was derived from the model's declared context window rather than a value you could see on the bar or set yourself. A long task could get summarized deep in the model's context window, the least reliable part."},"1920":{"id":"/developer-updates-416","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"This keeps very long tasks from pushing models into the least reliable part of their context window while still allowing larger windows when needed. #1774, #1796"},"1921":{"id":"/developer-updates-417","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-5","content":"Your browser does not support the video tag."},"1922":{"id":"/developer-updates-418","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-3","content":"See how long each task step took: Completed steps and tasks now show how long they took, so you can see where Pochi spent its time across model responses and tool work. #1775"},"1923":{"id":"/developer-updates-419","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-3","content":"One menu for context and working modes: The new Add Context menu lets you attach the active selection, files, or folders and switch Todo mode, all from the prompt toolbar."},"1924":{"id":"/developer-updates-420","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-3","content":"Clear badges show which context and mode will be used before you submit, and the Todo toggle that used to sit in the toolbar now lives inside this menu so the controls are in one place. #1753"},"1925":{"id":"/developer-updates-421","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-5","content":"Cleaner, persistent background-job terminals: Background-job tabs now use concise command names instead of filling the terminal bar with long commands. Their links also remain active after a command finishes, so you can still reopen the correct terminal until you close it. #1784, #1782"},"1926":{"id":"/developer-updates-422","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-5","content":"New sidebar tasks stay open: Tasks created from the sidebar now open as pinned tabs, so opening another editor no longer replaces the task you just started. #1771"},"1927":{"id":"/developer-updates-423","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-5","content":"Windows compatibility fixes: Command output from PowerShell and cmd now displays correctly instead of showing garbled text (mojibake) on non-UTF-8 consoles like Chinese Windows. Tasks and worktrees no longer disappear from the task list when git and VS Code format the same path differently. File search through ripgrep also now runs correctly instead of failing with a path-not-found error. #1785"},"1928":{"id":"/developer-updates-424","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-6","content":"Pochi is getting better at proving its work instead of just asserting it. This release keeps the agent from calling a task complete on its own say-so, and gives you more visibility into what it changes before those changes land, not after."},"1929":{"id":"/developer-updates-425","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-6","content":"More below!"},"1930":{"id":"/developer-updates-426","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-6","content":"Todo mode with automated completion auditing: When you work through a task that still has open todos, Pochi now runs a required completion checkpoint before it can close. A read-only audit sub-agent inspects the actual workspace, reading files, test output, and command results, and only lets the task finish when the work is genuinely done. If it isn't, Pochi picks the work back up and keeps going."},"1931":{"id":"/developer-updates-427","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-6","content":"Previously the agent could call a task done off its own summary, with nothing checking that summary against the real state of your files. A task could \"complete\" with todos still open and tests still failing."},"1932":{"id":"/developer-updates-428","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-6","content":"Most useful on long, multi-step tasks where it's easy to lose track of what's actually finished. The audit checks the work against real evidence before closing, so \"done\" means done. #1697"},"1933":{"id":"/developer-updates-429","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Diff preview before approval: You now see the exact change Pochi is about to make before you approve it. Edits from writeToFile, applyDiff, and multiApplyDiff render their full diff in a viewer while they wait for approval, so you Accept or Reject with the change in front of you."},"1934":{"id":"/developer-updates-430","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Previously the diff only appeared after the edit had already run, so approving a pending change meant approving it partly blind."},"1935":{"id":"/developer-updates-431","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"The preview is computed in memory without touching disk, so nothing is written until you approve. #1745"},"1936":{"id":"/developer-updates-432","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"One-click auto-approve toggle: The toolbar shield icon now toggles auto-approve directly on click, with a hover tooltip showing whether it's currently enabled or disabled. The full permissions menu is still one right-click away."},"1937":{"id":"/developer-updates-433","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Before, the icon only opened the popover, so flipping the master state took an extra step and there was no at-a-glance indication of the current mode. #1746"},"1938":{"id":"/developer-updates-434","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Read-before-write guard restored: Pochi again blocks a write to a file it hasn't read, and re-checks that the file hasn't changed on disk since it was last read, prompting a fresh read before the edit goes through."},"1939":{"id":"/developer-updates-435","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"This staleness check had been temporarily disabled, which let edits run against a file the agent had never actually opened. #1748"},"1940":{"id":"/developer-updates-436","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Task list scoped to the current repository: Pinned and archived tasks now only show for the repository you have open, instead of leaking across every project."},"1941":{"id":"/developer-updates-437","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"The task list previously returned every task regardless of workspace, so pins and archives from unrelated repos showed up together. #1742"},"1942":{"id":"/developer-updates-438","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"User edits tracked by workspace, not the active tab: Your manual edits since the last checkpoint are now tracked based on the workspace the task belongs to, so opening or focusing another file no longer drops that tracking."},"1943":{"id":"/developer-updates-439","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Tracking was gated on the Pochi task being the active editor tab. The moment you focused a file to edit it, the task went inactive and its edits were cleared, exactly when the changes were being made. #1740"},"1944":{"id":"/developer-updates-440","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Project memory disable applies to the current task: Turning off the Project Memory checkbox now removes project memory from the task you're in right away, instead of only taking effect on your next task."},"1945":{"id":"/developer-updates-441","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Previously, disabling only took effect when you started a new task — the task you were in kept its memory context either way. #1739"},"1946":{"id":"/developer-updates-442","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"User message kept on an early stream abort: If a stream finishes before the assistant's reply is added (for example, an immediate abort at task start), your message is now preserved instead of being dropped from the thread. #1733"},"1947":{"id":"/developer-updates-443","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-6","content":"Model preserved when compacting a task: A task you compact into a new one now keeps the model you had selected on the parent, instead of resetting to the default. #1725"},"1948":{"id":"/developer-updates-444","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-7","content":"This release tightens the everyday edges. Pochi now counts context tokens accurately, closes out tool calls when a stream dies, reuses the parent's prompt across background agents to cut costs and keeps the browser agent inside a tighter command boundary."},"1949":{"id":"/developer-updates-445","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-7","content":"More below!"},"1950":{"id":"/developer-updates-446","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Background agents reuse the parent's system prompt: Pochi now reuses the parent's system prompt when it spins up a background agent, instead of rebuilding one from scratch. It captures the resolved prompt once the parent's first request finishes and passes it down, so the cached prefix on Anthropic and OpenAI stays warm."},"1951":{"id":"/developer-updates-447","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Background scheduling waits for that snapshot before anything spins off. Previously each background agent built its own prompt and broke the shared cache prefix."},"1952":{"id":"/developer-updates-448","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Most noticeable in workflows that launch background agents often; every reused prefix is a cache hit instead of a full re-bill. #1691"},"1953":{"id":"/developer-updates-449","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Scoped commands for the browser agent: Pochi now keeps the browser agent inside a tight command boundary. Its executeCommand is limited to what it actually needs (agent-browser commands, the installer, and Chrome process checks) with the right paths for Windows (cmd and PowerShell) and macOS/Linux."},"1954":{"id":"/developer-updates-450","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Previously its command surface was wide open, far broader than the browsing work it does."},"1955":{"id":"/developer-updates-451","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"It's the same scoped-tool-access idea behind custom agents, now applied to the browser agent so it stays predictable when it's working in a real project. #1710"},"1956":{"id":"/developer-updates-452","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-4","content":"Clearer sub-agent expand toggle: The expand control on the sub-agent footer now uses a right-pointing chevron, making it clearer that the section opens out. #1707"},"1957":{"id":"/developer-updates-453","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Browser agent locates its binary after install: Pochi now checks $HOME/.pochi/bin and runs agent-browser from there directly when a fresh install hasn't refreshed the shell's PATH yet."},"1958":{"id":"/developer-updates-454","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Previously it looked in the wrong directory, so the browser agent could fail to find agent-browser right after installing it. #1692"},"1959":{"id":"/developer-updates-455","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Token usage breakdown corrected: Pochi now reports the context-window breakdown correctly, the tools segment especially. Each number comes from the resolved request snapshot, so System, Tools, Messages, Files, Tool Results, and Project Memory match what was actually sent."},"1960":{"id":"/developer-updates-456","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"The old counts came from per-message metadata and could drift, which is why the tools figure looked off. #1696"},"1961":{"id":"/developer-updates-457","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Unfinished tool calls no longer stuck on stream failure: When a stream fails like a cancel or a dropped transport, Pochi now closes out any tool calls still in flight as errors instead of leaving them to spin forever. An abort reads \"User aborted the tool call\"; other failures keep their own message and anything already finished is left untouched."},"1962":{"id":"/developer-updates-458","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Previously those half-finished calls were saved as-is, so the thread kept showing tool calls that would never resolve. #1708"},"1963":{"id":"/developer-updates-459","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Stalled streams now time out instead of hanging: Pochi aborts a stream that goes 15 seconds without receiving a chunk, so a stuck session ends on its own instead of waiting forever."},"1964":{"id":"/developer-updates-460","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Previously a stream that stopped producing chunks had no deadline, so a stalled response could sit open indefinitely with no way to recover short of restarting."},"1965":{"id":"/developer-updates-461","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-7","content":"Most useful on flaky connections or when a provider stalls mid-response, the session fails fast and frees you to retry. #1712"},"1966":{"id":"/developer-updates-462","page_id":"/developer-updates","type":"text","url":"/developer-updates#-coming-up-3","content":"Todo mode with automated continuation auditing: When you finish a task that still has open todos, a read-only audit sub-agent will check the workspace (files, tests, command output) before letting it close and pick the work back up if it isn't actually done."},"1967":{"id":"/developer-updates-463","page_id":"/developer-updates","type":"text","url":"/developer-updates#-coming-up-3","content":"Compaction point shown in the thread: Pochi will mark the compaction point inline with a separator and a summary action, so you can see exactly where context was compacted mid-task."},"1968":{"id":"/developer-updates-464","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-8","content":"This release removes friction from long runs and complex workflows."},"1969":{"id":"/developer-updates-465","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-8","content":"Pochi now compacts automatically when context fills up, interactive widgets return their state to the agent for follow-up reasoning, and the browser agent can target any viewport — including mobile."},"1970":{"id":"/developer-updates-466","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-8","content":"More below!"},"1971":{"id":"/developer-updates-467","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-7","content":"Auto Compact: Pochi now compacts your context automatically when it gets full mid-task, without stopping what it's doing. A \"Compacting...\" indicator appears in the thread while it runs, and the task picks up where it left off."},"1972":{"id":"/developer-updates-468","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-7","content":"Previously, hitting the context limit meant stopping to manually click \"Compact Task\" or start a new task with summary. Long tasks that ran into the limit mid-run would stall and wait for you."},"1973":{"id":"/developer-updates-469","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-7","content":"Most useful for extended sessions such as deep codebase exploration, long refactors or anything that runs for a while. If compaction fails, Pochi falls back gracefully and won't keep retrying on a bad state. #1627"},"1974":{"id":"/developer-updates-470","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-7","content":"Your browser does not support the video tag."},"1975":{"id":"/developer-updates-471","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Interactive Widgets with State Return: renderWidget now passes your widget's UI state back to Pochi after each message. When you interact with a rendered widget — adding entries, clicking buttons, making selections — Pochi sees what you did and can reason on it in the next turn."},"1976":{"id":"/developer-updates-472","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Before this, renderWidget returned only { success: boolean }. The widget was a sandboxed iframe and once rendered, Pochi had no visibility into what you did inside it. If you wanted Pochi to act on widget content, you had to describe it manually."},"1977":{"id":"/developer-updates-473","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"This is useful when you're building agents with interactive UI: a bookkeeping widget that gets summarized, a stock tracker with a News button that fires a live search, a form the agent reads and validates. The state feeds back automatically. #1621"},"1978":{"id":"/developer-updates-474","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Your browser does not support the video tag."},"1979":{"id":"/developer-updates-475","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Browser Agent with Viewport Size: Browser Agent sessions now let you pick a viewport size before running. Four presets: Large Desktop (1280×720), Small Desktop (900×600), Portrait (768×1024), and Mobile (360×640), selectable from a new dropdown in Browser Agent Settings. The recording scales to match."},"1980":{"id":"/developer-updates-476","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Before, the browser agent ran at a fixed viewport regardless of the site. If you were automating a mobile-first page, the agent was navigating the desktop layout with wrong breakpoints, wrong elements."},"1981":{"id":"/developer-updates-477","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Set Mobile (360×640) before running a task on a responsive site and the agent navigates what your mobile users actually see. Useful for mobile testing, scraping mobile-specific content, or anything that behaves differently at smaller breakpoints. #1620"},"1982":{"id":"/developer-updates-478","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-5","content":"Your browser does not support the video tag."},"1983":{"id":"/developer-updates-479","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Subtask Todos Visible Without Expanding: Subtask todo lists now show up in the collapsed newTask tool detail — you can see what a subagent is working on without having to expand the view."},"1984":{"id":"/developer-updates-480","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Previously, todos only rendered inside the expanded subtask view. #1618"},"1985":{"id":"/developer-updates-481","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Git Branch Badge Always Visible: The git branch badge no longer disappears while a command is running. The executing status now constrains to available space and truncates cleanly, rather than pushing the branch info out."},"1986":{"id":"/developer-updates-482","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Previously, the badge would vanish from task rows whenever a command was executing. #1613"},"1987":{"id":"/developer-updates-483","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Outline Button Consistent in Dark Mode: Outline buttons now look the same in dark mode as they do in light mode. The dark mode overrides that caused the inconsistency have been removed."},"1988":{"id":"/developer-updates-484","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-8","content":"Previously, outline buttons had separate dark mode rules that diverged from the light theme. #1612"},"1989":{"id":"/developer-updates-485","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-9","content":"This release reduces the setup tax: Pochi now renders interactive visual widgets directly in chat, Project Memory is on by default, and the Browser Agent ships with a dedicated settings UI. Task pinning rounds it out for anyone juggling multiple active worktrees."},"1990":{"id":"/developer-updates-486","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-9","content":"More below!"},"1991":{"id":"/developer-updates-487","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Generative UI: Pochi can now render interactive visual widgets directly in the chat panel using the renderWidget tool. Widgets stream live as the agent generates them — diagrams, charts, art, interactive components, and mockups all render in a sandboxed frame without leaving the task."},"1992":{"id":"/developer-updates-488","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Previously, Pochi's output was limited to text and code. There was no way to generate or display visual content natively — agents had to produce files or code for the user to run separately."},"1993":{"id":"/developer-updates-489","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Most powerful for agents that need to communicate visually: architecture diagrams, data charts, UI mockups, or any output where a picture is worth the code. Available to all agents by default with no additional configuration required. #1572, #1573"},"1994":{"id":"/developer-updates-490","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Your browser does not support the video tag."},"1995":{"id":"/developer-updates-491","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Project Memory: Project Memory is now enabled for all users out of the box. The Token Usage popover gains a new Memory section with two rows, Project and Task, each showing the file path and clickable to open the file directly in the editor. An inline checkbox next to the section heading toggles Project Memory on or off."},"1996":{"id":"/developer-updates-492","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Previously, Project Memory was opt-in via pochi.advanced.memory.enabled: true in VS Code settings, so persistent memory across tasks required deliberate setup."},"1997":{"id":"/developer-updates-493","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Over time, Pochi builds up a picture of your project, preferences, decisions, patterns and carries it forward automatically. Toggle it off anytime from the token usage panel. Disabling keeps your existing MEMORY.md intact. #1571"},"1998":{"id":"/developer-updates-494","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Your browser does not support the video tag."},"1999":{"id":"/developer-updates-495","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Browser Agent - Settings Panel: The Browser Agent now has a dedicated settings panel for runtime and recording configuration. Switch between Managed browser and Local Chrome, set a custom Chrome executable path and start parameters, and enable session recording — all from the UI."},"2000":{"id":"/developer-updates-496","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Previously, Browser Agent configuration required manually editing ~/.pochi/config.jsonc. There was no UI, and switching to Local Chrome meant knowing the exact config key and editing it by hand."},"2001":{"id":"/developer-updates-497","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Switch to Local Chrome in the panel and start a browser task, Pochi picks up your config automatically without needing to be told which runtime to use. Useful for anything behind a login: dashboards, internal tools, or services you're already authenticated with. #1552"},"2002":{"id":"/developer-updates-498","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-8","content":"Your browser does not support the video tag."},"2003":{"id":"/developer-updates-499","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-6","content":"Task Pinning: Tasks can now be pinned to keep them at the top of the task list regardless of recency. Pinned tasks appear in a dedicated Pinned section above all worktree groups, removed from their original position to avoid duplication."},"2004":{"id":"/developer-updates-500","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-6","content":"Task list ordering was purely recency-based, so a task you needed to return to repeatedly would sink as new tasks were created on top of it."},"2005":{"id":"/developer-updates-501","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-6","content":"Most useful when juggling multiple active worktrees. Pin and unpin from the hover menu on any task row. Archiving a pinned task automatically unpins it, and pinned tasks are excluded from the \"Archive old tasks\" batch action. Pinned state persists across VS Code reloads. #1561"},"2006":{"id":"/developer-updates-502","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-6","content":"Your browser does not support the video tag."},"2007":{"id":"/developer-updates-503","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-9","content":"VS Code Settings Page Stays Open: The VS Code Settings page and other built-in tabs like Keyboard Shortcuts and Extensions no longer closes when Pochi's auto-layout runs with only a task tab visible."},"2008":{"id":"/developer-updates-504","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-9","content":"Any non-task tab was being treated as a file-backed editor, causing the layout manager to trigger a re-layout and close it. #1570"},"2009":{"id":"/developer-updates-505","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-10","content":"Pochi can now operate inside your real Chrome browser: logged-in sessions, your cookies, your stored state. Task Memory is now inspectable mid-task so you know exactly what shapes compaction, and background jobs respect the same command policies as executeCommand, closing the last open gap in scoped tool access."},"2010":{"id":"/developer-updates-506","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-10","content":"More below!"},"2011":{"id":"/developer-updates-507","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Browser Agent - Local Chrome Support: Pochi's browser agent can now connect to and control your locally running Chrome browser. When you ask it to use local Chrome, the agent checks whether Chrome is already open, starts it with your default profile if needed, then connects via the Chrome DevTools Protocol to operate directly inside your session."},"2012":{"id":"/developer-updates-508","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Previously, the browser agent only ran headless sessions — no cookies, no stored logins, no saved state. Accessing anything that requires a login meant the agent was effectively locked out."},"2013":{"id":"/developer-updates-509","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Most useful when your task requires accessing GitHub, internal dashboards, or any service you're already authenticated with. Requires Chrome 144+ with remote debugging enabled at chrome://inspect/#remote-debugging. #1530"},"2014":{"id":"/developer-updates-510","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Your browser does not support the video tag."},"2015":{"id":"/developer-updates-511","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"View Task Memory: A Task Memory button now appears in the Token Usage popover once Pochi has extracted at least one memory entry. Clicking it opens memory.md — the structured session notes Pochi has been accumulating throughout your task."},"2016":{"id":"/developer-updates-512","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Task Memory was introduced in v0.46, but the extraction process was invisible. You couldn't verify what had been stored or how it would shape compaction."},"2017":{"id":"/developer-updates-513","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Now you can inspect the memory file directly at any point during a long task. #1528"},"2018":{"id":"/developer-updates-514","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Your browser does not support the video tag."},"2019":{"id":"/developer-updates-515","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Scoped Tool Access - startBackgroundJob Policy: startBackgroundJob now respects the same command-pattern policies as executeCommand. Declare startBackgroundJob(npm run dev) in your custom agent config to restrict which background commands the agent can launch."},"2020":{"id":"/developer-updates-516","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"v0.46 introduced scoped tool access for executeCommand, readFile, writeToFile, applyDiff, editNotebook, and webFetch — but startBackgroundJob was left out. An agent restricted to executeCommand(git *) could still run arbitrary shell commands via a background job."},"2021":{"id":"/developer-updates-517","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"The two tools are kept independent: an executeCommand(git *) rule does not authorize startBackgroundJob calls, and vice versa. The same syntax you already use for executeCommand works here. For the full policy configuration reference, check the custom agent docs. #1538"},"2022":{"id":"/developer-updates-518","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-9","content":"Your browser does not support the video tag."},"2023":{"id":"/developer-updates-519","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-7","content":"Auto-Expand Task Panel Input: The task panel input now expands as you type, up to 30% of viewport height or 420px, before switching to internal scrolling."},"2024":{"id":"/developer-updates-520","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-7","content":"Previously it was capped at 128px — roughly 4 visible lines. Pasting a multi-paragraph prompt or a long file path meant scrolling through a cramped box to review what you'd typed before sending."},"2025":{"id":"/developer-updates-521","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-7","content":"Most noticeable when dropping in detailed instructions or long context at the start of a task. #1531"},"2026":{"id":"/developer-updates-522","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-10","content":"Thinking Summary Display: The thinking summary block now displays correctly for Anthropic models. #1526"},"2027":{"id":"/developer-updates-523","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-10","content":"Browser Recording Codec and Canvas: Browser recordings no longer fail on platforms where the hard-coded H.264 codec isn't available — the recorder now detects a supported codec at runtime. Frames are also rendered to a consistent 854×480 canvas with letterboxing, fixing distorted or broken recordings from variable source dimensions. #1535, #1537"},"2028":{"id":"/developer-updates-524","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-10","content":"Collapsed Tool Container Chevron: The chevron icon for collapsed tool containers now points left again, as intended. A previous change had accidentally flipped it to point right. #1529"},"2029":{"id":"/developer-updates-525","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-11","content":"In this update, Pochi gets context-aware in two directions: tasks now maintain persistent memory that survives compaction, and custom agents that can precisely scope which files and domains they're allowed to touch."},"2030":{"id":"/developer-updates-526","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-11","content":"More below!"},"2031":{"id":"/developer-updates-527","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Task Memory: Pochi now maintains a persistent memory file throughout a task — including across context compaction."},"2032":{"id":"/developer-updates-528","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"A background agent extracts structured session notes into memory.md at regular intervals. When compaction kicks in, Pochi uses this memory file as the summary source instead of generating a fresh one from scratch."},"2033":{"id":"/developer-updates-529","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Most noticeable on long debugging or refactoring sessions where compaction previously felt like Pochi losing its place. #1480"},"2034":{"id":"/developer-updates-530","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Your browser does not support the video tag."},"2035":{"id":"/developer-updates-531","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Scoped Tool Access for Custom Agents: Custom agents can now declare precise access policies for file operations and web requests — restricting which paths they can read or write, and which domains they can fetch from."},"2036":{"id":"/developer-updates-532","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Previously, custom agents had full filesystem and web access with no hard enforcement. Scoping was prompt-only."},"2037":{"id":"/developer-updates-533","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Use executeCommand(npm *) to whitelist commands, readFile(src/**) to limit file reads, or webFetch(domain:*.``example.com``) to restrict web access. Policies are enforced at the tool level."},"2038":{"id":"/developer-updates-534","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"For the full list of supported configurations, check the custom agent docs. #1497, #1495"},"2039":{"id":"/developer-updates-535","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-10","content":"Your browser does not support the video tag."},"2040":{"id":"/developer-updates-536","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Microbatch Parallel Tool Execution: Tool calls now execute in micro-batches based on side-effect profile. Reads and git commands run concurrently; writes serialize automatically."},"2041":{"id":"/developer-updates-537","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Pochi already ran tool calls in parallel, but with no side-effect awareness — reads and writes could race, and a failed call wouldn't cancel downstream dependencies."},"2042":{"id":"/developer-updates-538","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Most noticeable on tasks that span multiple files and git history simultaneously. #1477"},"2043":{"id":"/developer-updates-539","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Your browser does not support the video tag."},"2044":{"id":"/developer-updates-540","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Compact File Preservation: When compaction kicks in, Pochi snapshots the files you were actively reading and carries them forward — full content where they fit, file references where they're too large."},"2045":{"id":"/developer-updates-541","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Previously, compact summaries dropped file context entirely. After compaction, Pochi would re-read files it had already processed, burning tokens and losing step."},"2046":{"id":"/developer-updates-542","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Most useful for long refactoring or debugging sessions across multiple files. #1481"},"2047":{"id":"/developer-updates-543","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Attachment Preview in Chat Input: File attachment previews now appear inside the chat input form rather than outside it."},"2048":{"id":"/developer-updates-544","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"The previous placement made it easy to lose track of what was attached before sending — especially with multiple files queued. #1485"},"2049":{"id":"/developer-updates-545","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Web Search Multi-Query: The webSearch tool now accepts up to 5 queries in a single call, batching related searches into one request instead of N sequential ones."},"2050":{"id":"/developer-updates-546","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Researching multiple facets of a problem previously meant chaining search calls, each waiting on the last. #1479"},"2051":{"id":"/developer-updates-547","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Webview Performance: Message list rendering is faster on long sessions. Key components are now memoized and checkpoint calculation refactored from O(N²) to O(N)."},"2052":{"id":"/developer-updates-548","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-8","content":"Long tasks with many tool calls and diffs caused noticeable slowdowns as the message list grew. #1494"},"2053":{"id":"/developer-updates-549","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"Tool Call Input Null Fix: Pochi no longer throws a Field required error when retrying an interrupted task."},"2054":{"id":"/developer-updates-550","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"When a task was cancelled mid-stream, tool call inputs could be left as null. The Anthropic API requires a non-null object, so the next retry would fail immediately with a validation error. #1463"},"2055":{"id":"/developer-updates-551","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"Reasoning UI Display Fix: The reasoning block now shows the correct loading state during streaming and after completion."},"2056":{"id":"/developer-updates-552","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"An incorrect isLoading condition prevented the reasoning component from re-rendering when its loading state changed. #1504"},"2057":{"id":"/developer-updates-553","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"VS Code 1.118 Task Panel Fix: Pochi no longer fails to open the task panel on VS Code 1.118."},"2058":{"id":"/developer-updates-554","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"VS Code 1.118 changed how its webview service worker routes internal resource requests. Workers launched without a webview ID couldn't route requests back to the correct panel, causing it to error on load."},"2059":{"id":"/developer-updates-555","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-11","content":"Workers now carry the webview ID through their bootstrap URL so VS Code routes requests correctly. SQLite assets are also inlined to sidestep the same routing issue. #1508"},"2060":{"id":"/developer-updates-556","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview","content":"Auto Memory + Auto Dream: We're building persistent memory across sessions — a MEMORY.md file that Pochi maintains over time."},"2061":{"id":"/developer-updates-557","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview","content":"Store context, preferences, and project notes that carry forward automatically."},"2062":{"id":"/developer-updates-558","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview","content":"Tell Pochi to \"remember\" or \"forget\" anything, and it updates the file directly."},"2063":{"id":"/developer-updates-559","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-12","content":"This release ships a dedicated agent for product questions and a set of improvements that make iterative coding workflows noticeably tighter: smarter file handling, scoped terminal access for agents and faster codebase exploration."},"2064":{"id":"/developer-updates-560","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-12","content":"Less context burns, fewer surprises."},"2065":{"id":"/developer-updates-561","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-12","content":"More below!"},"2066":{"id":"/developer-updates-562","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-11","content":"Product Guide Agent: Pochi now has a dedicated guide agent built for product questions — ask \"what can Pochi do?\" or \"set up a new GLM vendor\" and it fetches live docs from docs.getpochi.com and answers directly in context."},"2067":{"id":"/developer-updates-563","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-11","content":"Before this, product questions went to the main agent, which would burn context pulling from external docs or redirect you entirely. The guide agent handles documentation and configuration questions in one place, keeping your main agent focused on the actual task."},"2068":{"id":"/developer-updates-564","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-11","content":"Works for anything in the Pochi docs — features, config, vendor setup. No extra setup needed. #1449"},"2069":{"id":"/developer-updates-565","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-11","content":"Your browser does not support the video tag."},"2070":{"id":"/developer-updates-566","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Web-Search Domain Filter: You can now restrict agent web-search to specific domains using an allowlist (searchDomainFilter: ['github.com']) or denylist (['-reddit.com']). Pochi enforces filtering at the API level, not as a soft instruction to the model."},"2071":{"id":"/developer-updates-567","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Without this, agents could pull from any source during search. For teams in compliance-sensitive environments, that was a gap with no workaround."},"2072":{"id":"/developer-updates-568","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Available to all logged-in Pochi users. Supports up to 20 domains; allowlist and denylist modes cannot be mixed. #1457"},"2073":{"id":"/developer-updates-569","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Command Whitelist for Agents: Custom agents can now be restricted to a specific set of commands using syntax like executeCommand(npm) or executeCommand(npm *). Pochi rejects attempts outside the whitelist."},"2074":{"id":"/developer-updates-570","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Previously, deploying custom agents granted full terminal access. There was no way to scope what it could run."},"2075":{"id":"/developer-updates-571","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Teams can now deploy agents in restricted environments without worrying about what they'll touch. #1445"},"2076":{"id":"/developer-updates-572","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Explore Agent Parallelization: The Explore agent now runs searches, reads, and greps simultaneously rather than sequentially."},"2077":{"id":"/developer-updates-573","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"On large codebases or monorepos, exploration used to mean a long chain of sequential round trips — every grep waiting on the last one. That latency stacks up fast."},"2078":{"id":"/developer-updates-574","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Nothing to configure. It just runs faster. #1452"},"2079":{"id":"/developer-updates-575","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Large Tool Output Handling: Tool results over 50KB now save to a temporary file. The agent receives a preview (~2000 characters) and the file path, with full content available on demand."},"2080":{"id":"/developer-updates-576","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Build logs, search results, verbose command output — these used to land directly in the context window, eating tokens and degrading response quality on long sessions."},"2081":{"id":"/developer-updates-577","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"This keeps workflows responsive even when commands produce verbose output. #1447"},"2082":{"id":"/developer-updates-578","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"readFile LRU Cache: If you read a file and it hasn't changed, the next read returns a stub: \"File unchanged since last read.\" The full content isn't re-fetched."},"2083":{"id":"/developer-updates-579","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"In iterative workflows (edit, verify, edit again) the same files get read repeatedly. Each pass used to cost tokens even when nothing had changed."},"2084":{"id":"/developer-updates-580","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Token overhead drops on large codebases. Cache clears on compact and skips virtual and media files. #1441"},"2085":{"id":"/developer-updates-581","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"Edit Safety for Unread Files: Pochi now blocks writes to files that haven't been read first. Try to edit or overwrite a file the agent hasn't seen, and it throws an explicit error."},"2086":{"id":"/developer-updates-582","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-9","content":"The failure mode it prevents: an agent overwrites a file based on stale assumptions — no warning, no recovery. In iterative workflows, that's a hard-to-debug loss. #1441"},"2087":{"id":"/developer-updates-583","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-13","content":"This release brings last week’s preview features into full availability, with improved stability and performance."},"2088":{"id":"/developer-updates-584","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-13","content":"It also introduces new improvements like reduced prompt size for faster context and a cleaner worktree experience."},"2089":{"id":"/developer-updates-585","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-13","content":"More below!"},"2090":{"id":"/developer-updates-586","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Multi-step follow-up questions: We’ve improved how Pochi ask follow-up questions. Instead of being limited to a single question, Pochi is able to ask multiple structured questions in a single interaction, with support for different input types such as single-choice and multi-select."},"2091":{"id":"/developer-updates-587","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"The updated UI introduces a guided flow with progress (e.g., “1 of 3”), clearer option selection, and a more structured submission experience."},"2092":{"id":"/developer-updates-588","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This will make it easier to gather the right context from users before continuing execution. #1323"},"2093":{"id":"/developer-updates-589","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Your browser does not support the video tag."},"2094":{"id":"/developer-updates-590","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Reduced prompt size for faster and cleaner context: Pochi no longer includes a full file listing of the workspace in the initial system context."},"2095":{"id":"/developer-updates-591","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Previously, large repositories could add hundreds of files to the prompt, increasing token usage and slowing down responses. The agent now relies on tools like listFiles and globFiles to explore the workspace on demand."},"2096":{"id":"/developer-updates-592","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This reduces prompt noise, improves latency, and keeps context more relevant to the task. #1398"},"2097":{"id":"/developer-updates-593","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Cleaner worktree actions and open in new window: Worktree actions are now grouped into a dropdown menu to reduce visual clutter in the task panel."},"2098":{"id":"/developer-updates-594","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"You can also open a worktree in a new VS Code window directly from the toolbar, making it easier to work on multiple worktrees in parallel. #1399"},"2099":{"id":"/developer-updates-595","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Support for shared .agents/skills directory: Pochi now support loading skills from .agents/skills in addition to .pochi/skills."},"2100":{"id":"/developer-updates-596","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This aligns with emerging cross-agent conventions, making it possible to define skills once and reuse them across multiple AI coding tools without duplication. #1342"},"2101":{"id":"/developer-updates-597","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Built-in explore agent: We’re making the explore agent a built-in part of Pochi."},"2102":{"id":"/developer-updates-598","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This introduces a dedicated agent for understanding and navigating codebases, with support for safe, read-only operations and integration with other agents like the planner."},"2103":{"id":"/developer-updates-599","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This makes it easier to inspect projects, gather context, and delegate exploration before taking action. #1350"},"2104":{"id":"/developer-updates-600","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Improved permission controls in chat: We’re updating how auto-approve (permission) controls are accessed in the chat UI."},"2105":{"id":"/developer-updates-601","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Instead of a separate toolbar row, permissions will be moved into a compact button in the input bar, making them easier to access without taking up additional space."},"2106":{"id":"/developer-updates-602","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This results in a cleaner layout while keeping all permission controls quickly accessible when needed.#1347"},"2107":{"id":"/developer-updates-603","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Cleaner task archiving experience: We’ve improved how task archiving works to make it more consistent and easier to navigate."},"2108":{"id":"/developer-updates-604","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"Tasks are automatically archived when their worktree is deleted, and all archived tasks are grouped into a single unified view instead of being split across different sections."},"2109":{"id":"/developer-updates-605","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-10","content":"This simplifies the task panel and makes it easier to find past work without switching between multiple filters.#1346"},"2110":{"id":"/developer-updates-606","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-12","content":"Fix subagents getting stuck under high parallel load: Fixed an issue where subagents could become stuck when many agents were running in parallel and waiting on tool calls."},"2111":{"id":"/developer-updates-607","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-12","content":"This could cause multiple agents to remain in a waiting state without completing their tasks."},"2112":{"id":"/developer-updates-608","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-12","content":"Subagents now make consistent progress under high concurrency, ensuring tasks continue executing even when many agents are active at the same time.#1345"},"2113":{"id":"/developer-updates-609","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-12","content":"Fix styling issues in modern VS Code dark themes: Fixed an issue where parts of the Pochi webview could become hard to see or blend into the background when using newer VS Code dark themes."},"2114":{"id":"/developer-updates-610","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-12","content":"UI elements now maintain proper contrast and readability across different theme variants. #1351"},"2115":{"id":"/developer-updates-611","page_id":"/developer-updates","type":"text","url":"/developer-updates#10x-content-publishing-flow-with-pochi-1","content":"At Pochi, a big part of the marketing team’s work is publishing developer content such as tutorials, product updates, and technical deep dives. Writing the article is only one part of the workflow. Much of the work that follows is repetitive, involving the same steps each time to prepare content for the documentation site, manage artifacts like images and videos, and share it across developer platforms."},"2116":{"id":"/developer-updates-612","page_id":"/developer-updates","type":"text","url":"/developer-updates#10x-content-publishing-flow-with-pochi-1","content":"After going through this publishing process a few times, we realized that most of this work was not complex, but highly repetitive and structured."},"2117":{"id":"/developer-updates-613","page_id":"/developer-updates","type":"text","url":"/developer-updates#10x-content-publishing-flow-with-pochi-1","content":"Tasks that previously took over an hour and required multiple manual steps are now handled in seconds with the right automation, allowing us to publish consistently without delays or context switching."},"2118":{"id":"/developer-updates-614","page_id":"/developer-updates","type":"text","url":"/developer-updates#10x-content-publishing-flow-with-pochi-1","content":"In this post, we’ll walk through how our marketing team approached this as an engineering problem and used Pochi to automate it."},"2119":{"id":"/developer-updates-615","page_id":"/developer-updates","type":"text","url":"/developer-updates#manual-processes-now-getting-fully-automated","content":"Most of our  content starts in collaborative docs like Lark, Google Docs, or Notion to allow reviewing and collaboration, but documentation sites and developer platforms expect a very different format."},"2120":{"id":"/developer-updates-616","page_id":"/developer-updates","type":"text","url":"/developer-updates#manual-processes-now-getting-fully-automated","content":"To reduce this operational overhead, we started experimenting with Pochi to see if we could automate parts of our publishing pipeline. The result was two small internal workflows we built for our own process, which are now part of our day-to-day publishing workflow."},"2121":{"id":"/developer-updates-617","page_id":"/developer-updates","type":"text","url":"/developer-updates#docflow-automating-docs-publishing","content":"The first workflow we built with Pochi became DocFlow, a small CLI that automates documentation publishing by converting Lark, Notion, or Google Docs documents into Markdown for our documentation site."},"2122":{"id":"/developer-updates-618","page_id":"/developer-updates","type":"text","url":"/developer-updates#docflow-automating-docs-publishing","content":"Our documentation content is typically written in Lark for collaboration and feedback, while the site itself is built with Next.js and expects Markdown/MDX files with properly hosted assets. DocFlow fetches the document through Lark API and converts the block-based content into a structured AST. From there, it generates Markdown while preserving elements such as headings, code blocks, images, and videos."},"2123":{"id":"/developer-updates-619","page_id":"/developer-updates","type":"text","url":"/developer-updates#docflow-automating-docs-publishing","content":"Media blocks are uploaded to S3 and their references are automatically updated in the generated Markdown."},"2124":{"id":"/developer-updates-620","page_id":"/developer-updates","type":"text","url":"/developer-updates#docflow-automating-docs-publishing","content":"Your browser does not support the video tag."},"2125":{"id":"/developer-updates-621","page_id":"/developer-updates","type":"text","url":"/developer-updates#docflow-automating-docs-publishing","content":"Instead of manually converting the document, handling media uploads, and fixing asset links, the entire process becomes a single command. What used to take close to 40 minutes for longer posts now takes only 10 seconds - roughly a 300× productivity gain. For a publishing cadence of two posts a week, this translates to ~5 hours of manual work saved each month, removing a significant amount of repetitive effort from our workflow."},"2126":{"id":"/developer-updates-622","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"The second workflow we built with Pochi became Content Syndicator, which focuses on distributing developer articles across multiple platforms."},"2127":{"id":"/developer-updates-623","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Developer articles are often shared on platforms such as Dev.to, Hashnode, and Medium. Publishing to each platform manually quickly becomes repetitive since the same content needs to be formatted accordingly, media assets must be handled correctly, and posts need to be created separately on each platform."},"2128":{"id":"/developer-updates-624","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Content Syndicator automates this process. It fetches the article from Lark, converts the content into Markdown, and prepares media assets for publishing. Images are re-hosted to GitHub to ensure they are publicly accessible across platforms."},"2129":{"id":"/developer-updates-625","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Video blocks require a different workflow. Videos embedded in Lark documents are uploaded to YouTube using the YouTube API, and the generated embed links are inserted into the article. These embeds work across Dev.to and Hashnode, and can also be reused when importing the article into Medium."},"2130":{"id":"/developer-updates-626","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Your browser does not support the video tag."},"2131":{"id":"/developer-updates-627","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Previously, preparing and publishing a single article across multiple platforms could take over an hour of manual work. With Content Syndicator, the same process now takes less than a minute and can be triggered with a single command."},"2132":{"id":"/developer-updates-628","page_id":"/developer-updates","type":"text","url":"/developer-updates#content-syndicator-automating-blog-distribution","content":"Across a typical month of publishing, this reduces roughly 8 hours of manual work to under 10 minutes, removing a significant amount of repetitive effort from our workflow."},"2133":{"id":"/developer-updates-629","page_id":"/developer-updates","type":"text","url":"/developer-updates#process-automation-with-pochi","content":"Pochi made it possible to prototype and iterate on these workflows quickly. Instead of manually researching APIs and wiring everything together from scratch, we described the workflow we wanted and refined the implementation interactively."},"2134":{"id":"/developer-updates-630","page_id":"/developer-updates","type":"text","url":"/developer-updates#process-automation-with-pochi","content":"While building these tools, we used Pochi to explore the Lark API, scaffold the CLI structure, and iterate on the publishing pipelines for different platforms. When something broke, we could debug and adjust the implementation within the same workflow."},"2135":{"id":"/developer-updates-631","page_id":"/developer-updates","type":"text","url":"/developer-updates#process-automation-with-pochi","content":"What started as small automation scripts eventually evolved into reusable internal tools that now support our developer content publishing process."},"2136":{"id":"/developer-updates-632","page_id":"/developer-updates","type":"text","url":"/developer-updates#process-automation-with-pochi","content":"These workflows were never meant to be general-purpose tools. They were built specifically for our own publishing pipeline and the way our team works. The interesting part was how quickly Pochi made it possible to build something tailored exactly to our needs."},"2137":{"id":"/developer-updates-633","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-bigger-picture","content":"What changed for us was how we approached the problem. Instead of looking for the right tool or filing a ticket, we started treating gaps in our workflow as things we could solve ourselves."},"2138":{"id":"/developer-updates-634","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-bigger-picture","content":"Pochi makes that approach practical by shortening the distance between identifying a problem and building a solution, turning everyday workflow challenges into opportunities to create better, faster, and more tailored solutions."},"2139":{"id":"/developer-updates-635","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-bigger-picture","content":"In our case, it started with content publishing. Today, the same approach can be applied across every part of your work where existing tools fall short of how your team operates."},"2140":{"id":"/developer-updates-636","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-bigger-picture","content":"This is also why the idea of the GTM engineer is becoming increasingly popular. People closest to the workflow can build and iterate the tools they need themselves without waiting for dedicated engineering support."},"2141":{"id":"/developer-updates-637","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-bigger-picture","content":"With Pochi, you can reimagine your workflows, unlock new efficiencies, and create the tools your team has always needed starting today."},"2142":{"id":"/developer-updates-638","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-14","content":"This week we spent time stepping back and identifying key areas where Pochi can be improved, along with fixing a few reliability issues that were getting in the way."},"2143":{"id":"/developer-updates-639","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-14","content":"Here’s a preview of what’s currently in progress and expected to land in the next release 👇"},"2144":{"id":"/developer-updates-640","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Workflow & UX improvements"},"2145":{"id":"/developer-updates-641","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Multi-step follow-up questions: Agents will be able to ask structured, multi-question prompts (with progress, single/multi-select inputs) to gather better context before execution.  #1323"},"2146":{"id":"/developer-updates-642","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Cleaner task archiving: Tasks will auto-archive when worktrees are deleted and appear in a single unified view, making it easier to find past work.  #1346"},"2147":{"id":"/developer-updates-643","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Background subtask execution: Subtasks will run asynchronously in separate tabs without blocking the parent task, enabling smoother parallel workflows.  #1354"},"2148":{"id":"/developer-updates-644","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Built-in explore agent: We’re making the explore agent a built-in part of Pochi for navigating and understanding codebases, designed for safe, read-only exploration and better planning workflows.  #1350"},"2149":{"id":"/developer-updates-645","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Support for .agents/skills: Skills can be shared across tools via the .agents/skills directory, aligning with emerging cross-agent conventions.  #1349"},"2150":{"id":"/developer-updates-646","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Live updates for skills: Changes to skills will reflect instantly in settings without requiring a reload.  #1352"},"2151":{"id":"/developer-updates-647","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Improved permission controls: Auto-approve settings will move into a compact input bar button, reducing clutter and improving accessibility.  #1347"},"2152":{"id":"/developer-updates-648","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Bug fixes"},"2153":{"id":"/developer-updates-649","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Subagents no longer get stuck under load: We’re improving handling of parallel tool calls so agents continue making progress even under high concurrency.  #1345"},"2154":{"id":"/developer-updates-650","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-1","content":"Improved dark theme rendering: We’re also fixing an issue where parts of the Pochi webview could become hard to see or blend into the background when using newer VS Code dark themes.  #1351"},"2155":{"id":"/developer-updates-651","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-15","content":"This release introduces several improvements to how you interact with Pochi tasks and extend the agent with skills."},"2156":{"id":"/developer-updates-652","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-15","content":"Highlights include a detailed context window breakdown, a new toggleable Plan Mode, and built-in skills for discovering and creating new skills. We’ve also made parallel worktrees and command execution more reliable."},"2157":{"id":"/developer-updates-653","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-15","content":"Let's dive in!"},"2158":{"id":"/developer-updates-654","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"Context window usage breakdown: The context window panel now shows a detailed breakdown of token usage during a task."},"2159":{"id":"/developer-updates-655","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"Previously, the UI only displayed total token usage and a progress bar. It was difficult to understand which parts of the context were contributing to token consumption."},"2160":{"id":"/developer-updates-656","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"The panel now separates usage into categories such as system instructions, tool definitions, messages, files, and tool results, along with the percentage each section occupies in the context window."},"2161":{"id":"/developer-updates-657","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"This makes it easier to reason about where tokens are being spent, debug unexpectedly large prompts, and decide when to compact or summarize a task. #1330"},"2162":{"id":"/developer-updates-658","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"Toggle Plan Mode before submitting a task: Plan Mode can now be toggled directly from the sidebar input before submitting a prompt."},"2163":{"id":"/developer-updates-659","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"Previously, generating a plan required hovering over the send button and selecting Plan for each submission. With the new toggle, you can enable Plan Mode once from the submit menu or quickly using Shift + Tab while focused on the input and then write your prompt normally."},"2164":{"id":"/developer-updates-660","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"This makes it easier to review the agent’s proposed steps before execution, especially for larger or more complex tasks. #1333"},"2165":{"id":"/developer-updates-661","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-12","content":"Your browser does not support the video tag."},"2166":{"id":"/developer-updates-662","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"New Built-in Skills for discovering and creating skills: Pochi now includes a set of new built-in skills available out of the box:"},"2167":{"id":"/developer-updates-663","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"find-skills – discovers and installs community skills via npx --yes skills find <query> using the skills.sh registry; asks user to confirm project-level vs user-level scope before installing"},"2168":{"id":"/developer-updates-664","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"create-skill – guides users through creating a new SKILL.md with a structured interview, draft, and review workflow."},"2169":{"id":"/developer-updates-665","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"These built-in skills are provided internally by Pochi and are not stored as editable files in the repository. They also do not appear in the settings panel, preventing them from being accidentally modified."},"2170":{"id":"/developer-updates-666","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"This makes it easier to discover useful skills and author new ones without starting from scratch. #1342"},"2171":{"id":"/developer-updates-667","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Your browser does not support the video tag."},"2172":{"id":"/developer-updates-668","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Support .worktreeinclude for syncing gitignored files into new worktrees: When Pochi creates a new Git worktree for parallel agents, the checkout only contains files tracked by Git. In many real-world projects this means the worktree cannot run or build immediately because required local files are missing."},"2173":{"id":"/developer-updates-669","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Instead, Pochi now supports a .worktreeinclude file in the repository root. This file uses gitignore-style patterns to specify gitignored files that should be copied into newly created worktrees."},"2174":{"id":"/developer-updates-670","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Typical examples include .env files, local configuration files, development database files, and editor settings."},"2175":{"id":"/developer-updates-671","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"If .worktreeinclude exists, Pochi will automatically copy the matching files from the main worktree into the new one before initialization runs."},"2176":{"id":"/developer-updates-672","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"This allows parallel worktrees to start with the same local development environment without requiring manual file copying.\n#1329"},"2177":{"id":"/developer-updates-673","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Cleaner tool call panels: Tool call panels now keep their action buttons and expand controls hidden by default and reveal them on hover."},"2178":{"id":"/developer-updates-674","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"This reduces visual clutter in the conversation view while keeping controls easily accessible. When a panel is expanded, the controls remain visible so it’s always clear which actions are available. #1328, #1328"},"2179":{"id":"/developer-updates-675","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-11","content":"Your browser does not support the video tag."},"2180":{"id":"/developer-updates-676","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"Prevent command execution from hanging in non-interactive environments: Improved the command execution environment to ensure shell commands always run in a non-interactive mode."},"2181":{"id":"/developer-updates-677","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"Previously, some commands could hang indefinitely during agent execution if they attempted to read from stdin or triggered an interactive credential prompt (for example with Git). Pochi now disables interactive prompts and ensures child processes receive no stdin, preventing these situations from blocking agent execution."},"2182":{"id":"/developer-updates-678","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"This makes command execution more reliable when running tools, scripts, or background jobs. #1334"},"2183":{"id":"/developer-updates-679","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"Fix missing recordings when running multiple browser agents: Fixed an issue where browser recordings could fail to finalize when multiple browser agents were running in parallel."},"2184":{"id":"/developer-updates-680","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"Previously, only the last browser session in a message was tracked, which meant earlier sessions could miss their stopRecording event and never save their video output."},"2185":{"id":"/developer-updates-681","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-13","content":"All browser agent sessions are now handled correctly, ensuring recordings are finalized and saved even when multiple agents run simultaneously. #1327"},"2186":{"id":"/developer-updates-682","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-16","content":"A small but solid update this week. Pochi now ignores large dependency directories like node_modules when building the file context for a task, even if the repository doesn’t define a .gitignore. We also fixed a few edge cases that could cause checkpointing to hang."},"2187":{"id":"/developer-updates-683","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-16","content":"We also published a new tutorial on turning one-off migrations into reusable engineering standards, and shared a few experiments we've been building with Pochi."},"2188":{"id":"/developer-updates-684","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-16","content":"Let's dive in!"},"2189":{"id":"/developer-updates-685","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-12","content":"Ignore package manager cache directories during repository traversal: Directory traversal now ignores common package manager cache directories such as node_modules, even when a repository does not define a .gitignore."},"2190":{"id":"/developer-updates-686","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-12","content":"Previously, these directories could be scanned during traversal, which sometimes polluted the agent’s file context with large dependency trees. With this change, Pochi skips common cache directories by default, keeping prompts cleaner and reducing unnecessary context."},"2191":{"id":"/developer-updates-687","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-12","content":"This change does not affect explicit file access through tools like listFiles or globFiles. #1279"},"2192":{"id":"/developer-updates-688","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-14","content":"Fix checkpoint hangs in edge cases: Fixed several issues where Pochi could hang when checkpoint creation failed. This could happen in environments where Git was not available, or when the workspace contained certain hidden or nested repository directories that Git could not stage properly."},"2193":{"id":"/developer-updates-689","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-14","content":"Instead, checkpoint failures are now handled more robustly to prevent the UI from getting stuck in a loading state. #1310"},"2194":{"id":"/developer-updates-690","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources","content":"Manage Library Migration At Team Scale: Library migration is a common but tedious part of maintaining production systems in an engineering team. When these changes need to be repeated across multiple repositories, keeping everything consistent quickly becomes difficult."},"2195":{"id":"/developer-updates-691","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources","content":"In this article we show how a migration was evolved into a reusable Pochi Skill and enforced through CI and lint checks, turning a one-time prompt into a version-controlled engineering standard. Read the full tutorial."},"2196":{"id":"/developer-updates-692","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-17","content":"With Spring Festival marking a new beginning, we’re shipping a release that adds real momentum."},"2197":{"id":"/developer-updates-693","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-17","content":"You can now generate structured walkthroughs for completed tasks, run browser-powered agents directly from the CLI, and review changes with a much richer diff experience. We’ve also made browser sessions more predictable and easier to reason about."},"2198":{"id":"/developer-updates-694","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-17","content":"Let’s dive right in! 🏮"},"2199":{"id":"/developer-updates-695","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Theme-aware Pochi sidebar icon: We’ve added a new Pochi logo to the VS Code activity bar and made it properly theme-aware."},"2200":{"id":"/developer-updates-696","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"This sounds simple, but VS Code renders activity bar SVGs as masked (binary) icons. That means the icon isn’t rendered as a full-color SVG - it’s treated as purely opaque vs transparent. This makes theme support tricky because an icon that looks correct in dark mode can break visually in light mode (and vice versa)."},"2201":{"id":"/developer-updates-697","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"This meant one SVG couldn’t handle both cases cleanly. Instead of fighting the masking system, we leaned into it. We introduced two separate SVG variants and registered two activity bar containers, each with a when clause tied to pochi.isDarkTheme and pochi.themeContextReady. Only one is visible at a time, and it switches reactively when the user changes themes."},"2202":{"id":"/developer-updates-698","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Under the hood, this also meant adding theme context management and updating our test utilities to account for the new sidebar view types. #1274"},"2203":{"id":"/developer-updates-699","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Your browser does not support the video tag."},"2204":{"id":"/developer-updates-700","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Create Walkthrough action for completed tasks: You can now generate a structured walkthrough summary for any completed task directly from the VS Code WebUI."},"2205":{"id":"/developer-updates-701","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"The new Walkthrough action produces a concise Markdown document saved to ./pochi/walkthroughs/$taskId.md. It summarizes the changes made during the task and helps you quickly understand the current state of the codebase without rereading the entire conversation."},"2206":{"id":"/developer-updates-702","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"This is especially useful after larger refactors or multi-step tasks, where the final state matters more than the back-and-forth that led there. The walkthrough is designed to serve as lightweight documentation you can keep, review, or share. #818"},"2207":{"id":"/developer-updates-703","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Your browser does not support the video tag."},"2208":{"id":"/developer-updates-704","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Browser agent support in CLI: The Pochi CLI can now run browser-powered tasks.\nPreviously, browser sessions were managed inside the VS Code extension only. That meant any task requiring a live browser - navigating websites, extracting content, interacting with pages, etc wasn’t supported in the CLI."},"2209":{"id":"/developer-updates-705","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Now, the CLI now injects browser session environments just like VS Code does, and properly handles session lifecycle (creation, reuse, disposal)."},"2210":{"id":"/developer-updates-706","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"This brings feature parity between VS Code and CLI for browser-backed tasks, and lays the groundwork for more consistent multi-environment agent behavior going forward. #1269"},"2211":{"id":"/developer-updates-707","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-13","content":"Your browser does not support the video tag."},"2212":{"id":"/developer-updates-708","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"Improved Browser Session Lifecycle and Debugging (VS Code): Browser sessions in the VS Code WebUI are now more predictable and easier to reason about."},"2213":{"id":"/developer-updates-709","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"You can manually control browser recording when using the browser agent, making it easier to inspect navigation steps and debug unexpected behavior. Recording is no longer purely implicit — you have clearer visibility into what the agent is doing."},"2214":{"id":"/developer-updates-710","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"At the same time, browser sessions are now properly scoped to their parent task. When a task tab is closed, all associated browser sessions are automatically cleaned up. This prevents orphaned sessions from lingering in the background and ensures browser lifecycle matches task lifecycle."},"2215":{"id":"/developer-updates-711","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"Together, these changes make browser-backed workflows more stable, easier to debug, and less prone to subtle resource leaks. #1275, #1282"},"2216":{"id":"/developer-updates-712","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"Rich diff viewer with unified/split toggle: Diffs in Pochi are now rendered using a dedicated DiffViewer component, providing a clearer and more reliable visualization of code changes."},"2217":{"id":"/developer-updates-713","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-13","content":"You can switch between unified and split views and toggle line wrapping for better readability. Patches are now validated before rendering to prevent broken or partially trimmed diffs from being misinterpreted. If a patch is invalid, the UI safely falls back to a plain code block. #1279"},"2218":{"id":"/developer-updates-714","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-1","content":"Five Practical Tips to Save Token Consumption with Pochi: A deep dive into workflow patterns that reduce context bloat, isolate intent, and prevent runaway execution costs. The post covers task compaction, forks and subagents, scoped MCP servers, and strategies for keeping large tool outputs out of the model’s context."},"2219":{"id":"/developer-updates-715","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-1","content":"If you’ve ever noticed agents getting slower, more verbose, and more expensive over time, this guide explains why and how Pochi is designed to prevent it.\nRead the full post."},"2220":{"id":"/developer-updates-716","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-2","content":"Code Review Subagents: We’re working on a new createReview tool that will spawn a dedicated subagent specialized in reviewing code within your repository."},"2221":{"id":"/developer-updates-717","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-2","content":"Unlike general-purpose task agents, this review agent will operate with a focused review intent and structured output, making it easier to run targeted code reviews without polluting your main task context."},"2222":{"id":"/developer-updates-718","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-2","content":"This tool will not be enabled by default and will be triggered explicitly, allowing teams to opt into review workflows when needed."},"2223":{"id":"/developer-updates-719","page_id":"/developer-updates","type":"text","url":"/developer-updates#five-practical-tips-to-save-token-consumption-with-pochi-1","content":"The usual experience with coding agents is predictable - they start out sharp, then slowly become confused, verbose, and expensive. Instructions keep piling up, tools accumulate, and failed attempts linger in the conversation. By the time token costs start hitting the roof, the agent already feels harder to work with."},"2224":{"id":"/developer-updates-720","page_id":"/developer-updates","type":"text","url":"/developer-updates#five-practical-tips-to-save-token-consumption-with-pochi-1","content":"At that point, most teams reach for the usual fixes: improve the prompts, avoid the biggest models for small tasks, and aggressively cache tool calls. While all of these help, they come with their own overhead of constant tuning and close monitoring - and even then, they rarely address the root cause of runaway token usage."},"2225":{"id":"/developer-updates-721","page_id":"/developer-updates","type":"text","url":"/developer-updates#five-practical-tips-to-save-token-consumption-with-pochi-1","content":"This post breaks down practical workflow patterns you can apply to address common sources of context bloat, explains the principles behind them, and shows how Pochi supports these behaviors in day-to-day work. If you’ve ever felt like an agent got worse the longer you worked with it, these patterns are likely why, and how Pochi helps you fix it."},"2226":{"id":"/developer-updates-722","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Token usage grows over time as conversations accumulate failed attempts and abandoned approaches. This context debt increases token usage and degrades response quality, making agents more verbose and error-prone."},"2227":{"id":"/developer-updates-723","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"To solve this, Pochi periodically allows you two options to compact the context:"},"2228":{"id":"/developer-updates-724","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Compact Task: This summarizes the task context and replaces long conversational history with a concise, up-to-date representation of intent and state. Applicable when you want to stay in the same task and continue the conversation with the condensed context."},"2229":{"id":"/developer-updates-725","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Your browser does not support the video tag."},"2230":{"id":"/developer-updates-726","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Create a New Task with Summary: This creates a clean task with a summary of the previous conversation, helping you avoid hitting context limits while keeping all relevant information."},"2231":{"id":"/developer-updates-727","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Your browser does not support the video tag."},"2232":{"id":"/developer-updates-728","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"These mechanisms are especially useful during long debugging sessions, iterative refactors, or tasks with multiple rounds of clarification."},"2233":{"id":"/developer-updates-729","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"In these cases, the majority of the conversation history becomes irrelevant once a direction is chosen. Compacting ensures the agent doesn’t keep paying for that history over and over again."},"2234":{"id":"/developer-updates-730","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Steps:"},"2235":{"id":"/developer-updates-731","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"When a task gets long, compact the context regularly (e.g., after 3–5 iterations)."},"2236":{"id":"/developer-updates-732","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"Keep only the essential state and intent."},"2237":{"id":"/developer-updates-733","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-compact-context-aggressively-as-noise-accumulates","content":"If the direction changes, create a new task with a summary of the previous conversation."},"2238":{"id":"/developer-updates-734","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Explaining code changes in plain chat is one of the fastest ways to burn tokens. Each time you prompt the agent with queries like:"},"2239":{"id":"/developer-updates-735","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"The model has to re-read large parts of the context, reconstruct what changed, and infer your intent all over again. This kind of repetition adds up quickly."},"2240":{"id":"/developer-updates-736","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Pochi avoids this by attaching intent directly to code through Edits and Reviews."},"2241":{"id":"/developer-updates-737","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Edits track the exact diffs you introduce locally while iterating. If you tweak a variable, adjust logic, or partially rewrite a block, Pochi includes only those changes in the agent’s context the next time you send a prompt."},"2242":{"id":"/developer-updates-738","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Your browser does not support the video tag."},"2243":{"id":"/developer-updates-739","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Reviews, on the other hand, let you leave inline comments directly on generated code. Instead of re-explaining issues in chat, you comment on specific lines and batch that feedback into a single, focused update."},"2244":{"id":"/developer-updates-740","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Your browser does not support the video tag."},"2245":{"id":"/developer-updates-741","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Steps:"},"2246":{"id":"/developer-updates-742","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Use edits to track local diffs during iteration."},"2247":{"id":"/developer-updates-743","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Attach intent directly to code using inline comments."},"2248":{"id":"/developer-updates-744","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Batch feedback into a single update instead of multiple chat messages."},"2249":{"id":"/developer-updates-745","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Token usage often spikes when multiple ideas compete in the same context. You start with one goal, explore a few approaches, abandon some, and finally pivot to another direction. In this case, the agent is continuously juggling multiple lines of intent. Even with compaction, the model still has to reconcile what you meant before with what you want now."},"2250":{"id":"/developer-updates-746","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Language models are optimized for coherent, single-threaded intent. When a task mixes multiple implementation strategies, the model keeps all of that alive in context, even if only one direction is still relevant."},"2251":{"id":"/developer-updates-747","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"The answer is isolation. Separate tasks mean separate contexts, and separate contexts mean fewer tokens spent reconciling unrelated ideas."},"2252":{"id":"/developer-updates-748","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Pochi supports this through task forking and subagents:"},"2253":{"id":"/developer-updates-749","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Forking a task creates a new task from a snapshot of the current workspace and conversation at the moment of the fork. The new task starts from that point with its own independent execution, and the conversation history is clipped to the fork boundary so it doesn’t carry later discussion or exploration."},"2254":{"id":"/developer-updates-750","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"This makes it useful when you want to try a different approach or explore an alternative implementation without affecting the original task’s trajectory."},"2255":{"id":"/developer-updates-751","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Your browser does not support the video tag."},"2256":{"id":"/developer-updates-752","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Subagents allow focused exploration within the same repository while keeping contexts separate. Each subagent works with a clean, bounded scope instead of accumulating unrelated history. In practice, this kind of isolation can lead to dramatic token savings. Developers running large, multi-step workflows often split work across multiple subagents, each with its own narrow instruction set."},"2257":{"id":"/developer-updates-753","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Steps:"},"2258":{"id":"/developer-updates-754","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"When you explore multiple approaches, create a fork or a subagent."},"2259":{"id":"/developer-updates-755","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Keep each task focused on one implementation strategy."},"2260":{"id":"/developer-updates-756","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolate-intent-early-with-subagents-and-forks","content":"Use separate contexts for separate goals."},"2261":{"id":"/developer-updates-757","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Before an agent attempts to solve a problem, it evaluates what it can do with every enabled tool. Each additional MCP server expands the action space the model must reason over. Even if a tool is never used, the model still spends tokens evaluating whether it is relevant, how it compares to other options, and when it applies."},"2262":{"id":"/developer-updates-758","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"For example, if a task only requires database access, exposing ten additional MCP servers adds unnecessary reasoning overhead. More options mean more branches to evaluate, which translates directly into higher token usage."},"2263":{"id":"/developer-updates-759","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Scope MCP servers per task so the agent only reasons about tools relevant to the task. Only selected servers are loaded into context, contribute tool definitions, and influence model reasoning. All other tools are invisible to the agent."},"2264":{"id":"/developer-updates-760","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Your browser does not support the video tag."},"2265":{"id":"/developer-updates-761","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Steps to follow:"},"2266":{"id":"/developer-updates-762","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Before starting a task, decide which MCP servers are necessary."},"2267":{"id":"/developer-updates-763","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Disable all MCP servers not required for this task."},"2268":{"id":"/developer-updates-764","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"If the task changes, immediately rescope the tool set."},"2269":{"id":"/developer-updates-765","page_id":"/developer-updates","type":"text","url":"/developer-updates#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Keep a task template for common workflows (DB, infra, testing, etc.)."},"2270":{"id":"/developer-updates-766","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Once you’ve scoped tools correctly, the next source of runaway token usage often shows up during execution, typically inside MCP-backed workflows."},"2271":{"id":"/developer-updates-767","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The prompt may be short and the tool choice correct, yet execution tokens spike because large volumes of raw data are streamed into the model."},"2272":{"id":"/developer-updates-768","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Tool calls may return hundreds or thousands of rows, which then get streamed into the model as large JSON payloads. At that point, execution tokens dwarf everything else."},"2273":{"id":"/developer-updates-769","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The failure mode is asking the model to reason over this raw data. For example, we asked Pochi:"},"2274":{"id":"/developer-updates-770","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"In the first attempt, the agent queried the database, fetched all matching rows, and streamed them into the model so it could filter and count them."},"2275":{"id":"/developer-updates-771","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Your browser does not support the video tag."},"2276":{"id":"/developer-updates-772","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The answer was correct, but thousands of records flowed through the context just so the model could compute a single number."},"2277":{"id":"/developer-updates-773","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"A better approach is to separate what needs to be computed from how it is computed. Instead of reasoning over data, the model should generate code that performs the computation and returns only the result."},"2278":{"id":"/developer-updates-774","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Your browser does not support the video tag."},"2279":{"id":"/developer-updates-775","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Pochi generated the following script:"},"2280":{"id":"/developer-updates-776","page_id":"/developer-updates","type":"text","url":"/developer-updates#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Now when prompted again to fetch the number of failed orders, the model never sees the raw records. Only a short summary enters the context, dropping execution tokens from tens of thousands to a few hundred."},"2281":{"id":"/developer-updates-777","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"At this point, it’s reasonable to think that the agent can run the SQL query directly:"},"2282":{"id":"/developer-updates-778","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Why do we need to get the agent to write a separate script?"},"2283":{"id":"/developer-updates-779","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"And you’re right. Expect that agents often choose the least expensive path. Even when a database can do aggregation, agents frequently fall back to pull-and-process patterns:"},"2284":{"id":"/developer-updates-780","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"This is where token usage explodes, for several reasons:"},"2285":{"id":"/developer-updates-781","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Schema uncertainty: If the agent isn’t confident about column names, enums, joins, indexes, it plays it safe by fetching rows and reasoning in-text."},"2286":{"id":"/developer-updates-782","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Ambiguous instructions: If the prompt says: “Find refunded orders and tell me how many there are”, the agent may fetch records first, inspect fields, and thenthen count, Instead of jumping straight to COUNT(*)"},"2287":{"id":"/developer-updates-783","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Tool abstraction: Many MCP database tools expose run query, fetch rows, but don’t strongly bias the model toward aggregation-first queries. So the model takes the path it can reason about most reliably."},"2288":{"id":"/developer-updates-784","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Multi-step reasoning: If the question is slightly more complex: “How many refunded orders from customers who signed up last quarter?”. The agent might fetch orders, fetch users, join in its head and then count. That’s almost guaranteed to stream a lot of data."},"2289":{"id":"/developer-updates-785","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Databases are cheap at filtering and counting while language models are not. The solution is simple - let the model decide what to compute, and let code handle how the computation happens. Only the final result should enter the context. Having a script lets us review the code and make sure that it runs the same computation every time the same prompt is called."},"2290":{"id":"/developer-updates-786","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"This keeps execution costs predictable, even when working with large datasets."},"2291":{"id":"/developer-updates-787","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Steps:"},"2292":{"id":"/developer-updates-788","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Detect when tool results exceed ~100 rows."},"2293":{"id":"/developer-updates-789","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Instead of asking the model to reason over raw data, ask it to generate code that computes the result."},"2294":{"id":"/developer-updates-790","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Return only the final result to the model (summary, count, aggregation)."},"2295":{"id":"/developer-updates-791","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-not-just-run-a-count-query","content":"Use aggregation-first queries when possible."},"2296":{"id":"/developer-updates-792","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion","content":"If there’s one theme across all five guides, it’s that token usage is shaped long before a prompt is sent.\nMost token blowups don’t come from bad prompts or choosing the wrong model. They come from workflows that allow too much context, too many tools, and too many competing ideas to accumulate in the same place."},"2297":{"id":"/developer-updates-793","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion","content":"When each task has a clear goal, well-suited tools, and a clean context, the agent doesn’t have to waste tokens reconciling noise. It can converge faster, reason more clearly, and produce better results at lower cost."},"2298":{"id":"/developer-updates-794","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion","content":"At Pochi, this philosophy is baked into the product. The goal isn’t to make you think about tokens because we tailor an experience that naturally keeps context small, intent clear, and costs predictable."},"2299":{"id":"/developer-updates-795","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-18","content":"This release we shipped a built-in browser subagent so browser automation is no longer a black box, tightened up task and skill workflows that were breaking under real usage, and published new writing on why agent safety has to live below the prompt layer."},"2300":{"id":"/developer-updates-796","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-14","content":"Built-in browser subagent with live streaming: As soon as agents start using browsers for anything non-trivial like scraping, form-filling, navigating dashboards, it brings in a new layer of visibility of how the operation is being performed. Without the visibility, debugging involves a lot of back and forth with prompts to explicity define the failure modes. Pochi now includes a built-in browser subagent that runs through the same execution pipeline as other tools and streams its activity live in the UI. You can watch the agent navigate, click, and capture pages as it works. Browser sessions are persisted, so you can revisit screenshots or recordings after the task completes. #1107"},"2301":{"id":"/developer-updates-797","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-14","content":"Your browser does not support the video tag."},"2302":{"id":"/developer-updates-798","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-14","content":"Upgraded Plan Mode: One of the most common failure modes we see is agents confidently generating implementation plans on top of ambiguous or incomplete requirements. To address this, we’re adding a clarification phase to the planner workflow. Before generating a plan, the planner agent will ask targeted follow-up questions when it detects ambiguity, instead of silently making assumptions. This will enforce more clarification from the user’s side and will avoid plan generation until key decisions are resolved. #1254"},"2303":{"id":"/developer-updates-799","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-14","content":"Your browser does not support the video tag."},"2304":{"id":"/developer-updates-800","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-15","content":"Support symlinked directories in the skill loader: Skills are meant to be reusable building blocks, but developing them locally was more painful than it needed to be. Many users keep skills in separate repos and iterate on them alongside projects.\nWe allow Skills to be loaded from symlinked directories in both the CLI and VS Code extension, making it easy to develop a skill in isolation and symlink it into .pochi/skills during development. #1199"},"2305":{"id":"/developer-updates-801","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-15","content":"Fixed task forking to correctly fork subtasks: Forking is often used to explore alternatives or recover from a failed approach. When subtasks weren’t properly forked, it created hidden coupling between tasks.  To fix this, now when you fork a task, we also fork any subtasks created in its conversation history. Forked tasks are fully self-contained, with no references back to the original task’s subtasks. #1134"},"2306":{"id":"/developer-updates-802","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-2","content":"Alongside shipping features, we spent time documenting how we think about agent safety in practice, especially when agents interact with production systems. We submitted two resources:"},"2307":{"id":"/developer-updates-803","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-2","content":"How to give coding agents access to SSH and databases without breaking production: We published a deep dive on why common safety patterns like command allowlists, SQL filters, and approval dialogs fail with autonomous agents, and why safety must be enforced at the infrastructure and execution layer instead of through prompts or behavioral controls. Read blog"},"2308":{"id":"/developer-updates-804","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-2","content":"Secure production database access in Pochi: Following our earlier post on agent safety, we released a hands-on guide showing how to grant agents controlled database access using isolated environments and gated deployment flows, without exposing production credentials or allowing uncontrolled writes. Read tutorial"},"2309":{"id":"/developer-updates-805","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Task walkthroughs: We’ve been working on a walkthrough feature that can generate a concise, human-readable summary of a task’s outcome in respect to what changed, why, and where to look next. The goal is to make agent-driven work easier to review, revisit, and share, especially for long-running or browser-heavy tasks. This feature is still being finalized and will land in an upcoming release."},"2310":{"id":"/developer-updates-806","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Improving the browser subagent: Alongside shipping the first version of the browser subagent, we’ve been working on making it reliable for long-running, real-world use. This includes:"},"2311":{"id":"/developer-updates-807","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Tightening browser session lifecycle management so sessions are cleaned up correctly when tasks end or tabs are closed"},"2312":{"id":"/developer-updates-808","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Improving recording infrastructure to avoid race conditions and ensure consistent captures"},"2313":{"id":"/developer-updates-809","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Unifying browser session handling across VS Code and the CLI so browser automation behaves the same in all environments"},"2314":{"id":"/developer-updates-810","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-3","content":"Updating Pochi icon in VS Code Sidebar: The current sidebar icon uses the generic $(code) icon, which doesn’t clearly communicate the Pochi brand identity. We’re working on a new icon that better represents Pochi’s role as an agent and its relationship to the codebase."},"2315":{"id":"/developer-updates-811","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"As AI agents become more capable, teams are trying to limit the damage they can do when given access to SSH or production databases.\nCommon approaches include:"},"2316":{"id":"/developer-updates-812","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"Command allowlists: allow ls, cat, grep, tail; block rm, mv, chmod."},"2317":{"id":"/developer-updates-813","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"SQL filters: Allow SELECT; block INSERT, DELETE, DROP."},"2318":{"id":"/developer-updates-814","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"Manual approval flows: Run everything in read-only mode until a human explicitly accepts changes."},"2319":{"id":"/developer-updates-815","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"These practices assume that constraining agent behaviour through rules, filters, and approvals can prevent dangerous actions."},"2320":{"id":"/developer-updates-816","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"This assumption is wrong."},"2321":{"id":"/developer-updates-817","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"Allowlists, prompts, and approval dialogs are control surfaces that influence what an agent chooses to do. Shells, credentials, runtimes, and database roles function as execution surfaces, defining what the system can do."},"2322":{"id":"/developer-updates-818","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"Risk is determined by execution surfaces, not control surfaces."},"2323":{"id":"/developer-updates-819","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production-1","content":"Enforcing safety at the behavior layer isn’t the solution. What follows is why these approaches fail in practice - and what actually holds up in production."},"2324":{"id":"/developer-updates-820","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-database-level-controls-fail","content":"Human engineers rarely connect to primary databases with full access. They query replicas or views that cannot change production data. The same principle must apply to agents, but it is not enough to enforce this only at the query level."},"2325":{"id":"/developer-updates-821","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-database-level-controls-fail","content":"There are several reasons for this."},"2326":{"id":"/developer-updates-822","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-database-level-controls-fail","content":"First, SQL filtering is unreliable. Even if you block write statements, many databases still support queries that trigger full table scans. Constructs like SELECT INTO can introduce new tables, and functions can produce side effects."},"2327":{"id":"/developer-updates-823","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-database-level-controls-fail","content":"Second, read access alone is dangerous. It can expose authentication tokens, PII, or operational metadata. This is why databases themselves do not rely on client-side query validation and instead implement safety through roles, views, and replicas."},"2328":{"id":"/developer-updates-824","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-database-level-controls-fail","content":"Re-implementing parts of this logic in the agent layer with regexes or heuristics is both fragile and incomplete."},"2329":{"id":"/developer-updates-825","page_id":"/developer-updates","type":"text","url":"/developer-updates#agents-route-around-blocked-tools","content":"An agent’s goal is task completion. Blocking individual tools does not mean entire classes of state changes are prevented. For example, if the agent finds that direct deletion within a database schema is blocked, it will reach the same outcome by putting together other allowed operations."},"2330":{"id":"/developer-updates-826","page_id":"/developer-updates","type":"text","url":"/developer-updates#agents-route-around-blocked-tools","content":"In this case, even though direct access to the tool is blocked, it doesn't prevent many other possible walkarounds that could apply undesired changes to the production system."},"2331":{"id":"/developer-updates-827","page_id":"/developer-updates","type":"text","url":"/developer-updates#agents-route-around-blocked-tools","content":"In practice, this can include writing a script that performs deletion or just invoking a different tool that indirectly gives the expected outcome. This is not adversarial behavior. Instructions, allowlists, and approval dialogs influence behavior, but they do not define what the system is capable of doing."},"2332":{"id":"/developer-updates-828","page_id":"/developer-updates","type":"text","url":"/developer-updates#agents-route-around-blocked-tools","content":"For that reason, safety cannot live solely inside the model. It must be enforced outside the model through OS permissions, roles, and tool interfaces. Access control is not a prompting problem. It's an infrastructure problem that will require explicit separation between reasoning and execution, with enforcement applied at deterministic execution boundaries."},"2333":{"id":"/developer-updates-829","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"In one setup, we exposed production data to an agent exclusively through a read-only tool interface backed by a SELECT-only database role. On paper, this appeared safe - the agent could inspect data but had no explicit write tools."},"2334":{"id":"/developer-updates-830","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"However, as long as the agent retained access to a general execution surface (shell access, runtime file system, or database credentials), it simply routed around the restriction, generating its own script and updating the database through an unintended path."},"2335":{"id":"/developer-updates-831","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"Your browser does not support the video tag."},"2336":{"id":"/developer-updates-832","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"We removed the execution surface entirely and enforced read-only access at the infrastructure level. This involved revoking database write permissions and disabling shell execution. Post this, the agent could reason freely but could no longer apply any changes."},"2337":{"id":"/developer-updates-833","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"Your browser does not support the video tag."},"2338":{"id":"/developer-updates-834","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"Even when read-only access is enforced at the infrastructure level, production access still depends on human approval. Over time, these approvals tend to degrade into procedural steps. Auto-approve paths appear, reviews become mechanical, and the safety boundary weakens."},"2339":{"id":"/developer-updates-835","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"As a result, granting agents direct access to production databases, even in read-only mode, is best avoided. Agents are non-deterministic by design, and production systems should not be exposed to that uncertainty."},"2340":{"id":"/developer-updates-836","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-read-only-access-still-allows-irreversible-damage","content":"The challenge is that many legitimate tasks still require writes."},"2341":{"id":"/developer-updates-837","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-writes-must-flow-through-existing-deployment-pipelines","content":"Many engineering tasks involve backfills, schema updates, and data correction. All of these require write access."},"2342":{"id":"/developer-updates-838","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-writes-must-flow-through-existing-deployment-pipelines","content":"Giving an agent write access to production data under these circumstances is rarely acceptable. A more robust pattern is to let agents propose changes, generate and test migration scripts, and iterate freely. But applying those same changes to production will still wait on explicit human approval."},"2343":{"id":"/developer-updates-839","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-writes-must-flow-through-existing-deployment-pipelines","content":"This mirrors standard engineering practice. It avoids giving production credentials to agents and ensures all changes are auditable and reversible."},"2344":{"id":"/developer-updates-840","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-writes-must-flow-through-existing-deployment-pipelines","content":"The tradeoff is slower iteration, because agents can’t validate assumptions against real production data. This is where isolated writable environments become important."},"2345":{"id":"/developer-updates-841","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolated-writable-environments-enable-safe-iteration","content":"Isolated Writable Environments (IWEs) are disposable database instances that mirror production schema and data. Within these environments, agents can evolve schemas, validate queries, and test migrations freely. Once the changes are ready, the same test and migration scripts can be replayed through the original production pipelines."},"2346":{"id":"/developer-updates-842","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolated-writable-environments-enable-safe-iteration","content":"In practice, combining IWEs with gated production deployment yields the best results. You get the agent to perform actions against isolated databases while production remains gated by standard deployment processes."},"2347":{"id":"/developer-updates-843","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-isolated-writable-environments-enable-safe-iteration","content":"The same principle applies outside the database layer. With SSH and shell access, the execution surface becomes effectively unbounded unless similar infrastructure-level boundaries are enforced."},"2348":{"id":"/developer-updates-844","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-shells-make-safety-undefined","content":"A shell is a general-purpose programming environment. Once exposed, safety boundaries become undefined."},"2349":{"id":"/developer-updates-845","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-shells-make-safety-undefined","content":"An agent can use cat to overwrite files, using grep can exfiltrate secrets, and tail -f, if used on the wrong file, can leak sensitive data indefinitely. On the other hand, having an allowlist to control which binaries are executed does not automatically constrain the kind of operations that are possible on the system."},"2350":{"id":"/developer-updates-846","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-shells-make-safety-undefined","content":"Having a shell exposed grants access to the file system, process creation, and the environment state. And once a shell exists, the boundary of what is allowed is no longer clear."},"2351":{"id":"/developer-updates-847","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-shells-make-safety-undefined","content":"The safest designs accept this and shift the focus from preventing mistakes to containing them."},"2352":{"id":"/developer-updates-848","page_id":"/developer-updates","type":"text","url":"/developer-updates#disposable-environments","content":"The simplest and most reliable pattern is to treat any machine an agent can access as disposable. This way when something goes wrong, you just replace the whole thing and not spend time to fix it. This is already how CI systems operate, and increasingly how dev environments are provisioned."},"2353":{"id":"/developer-updates-849","page_id":"/developer-updates","type":"text","url":"/developer-updates#disposable-environments","content":"Instead of connecting agents to long-lived servers, teams route them to short-lived containers, ephemeral VMs or dev sandboxes per task or per session. This way agents are free to modify files, install packages and experiment with configurations.  But this introduces infrastructure cost while reducing production impact."},"2354":{"id":"/developer-updates-850","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"Some teams still require agents for log inspection, operational debugging, or controlled maintenance. But even in these cases, full interactive shells are rarely necessary. Common restrictions can include:"},"2355":{"id":"/developer-updates-851","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"SSH users with no home directory and limited permissions"},"2356":{"id":"/developer-updates-852","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"forced commands in authorized_keys so only specific scripts can run"},"2357":{"id":"/developer-updates-853","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"wrapper binaries that expose narrow actions instead of general shells"},"2358":{"id":"/developer-updates-854","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"For example, instead of allowing:"},"2359":{"id":"/developer-updates-855","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"the key may enforce:"},"2360":{"id":"/developer-updates-856","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"This reduces damage area but comes with its own pitfalls. Debugging can become harder and workflows might require constant tooling updates."},"2361":{"id":"/developer-updates-857","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"Structured tools and APIs provide stronger safety guarantees than shells.. A shell exposes the file system, environment variables and network access - making it impossible to create boundaries without building a second operating system around it."},"2362":{"id":"/developer-updates-858","page_id":"/developer-updates","type":"text","url":"/developer-updates#restricted-hosts-and-forced-commands","content":"This approach already mirrors how human access to infrastructure has evolved as well. We now have fewer SSH sessions, more pipelines, dashboards, and automation APIs. Agents benefit from the same shift, for the same reasons."},"2363":{"id":"/developer-updates-859","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-1","content":"Throughout this post, we saw the same pattern repeat across different systems. When the agent was instructed to follow safety, through instructions, prompts, or behavioral constraints, it failed. Whereas, when safety was enforced through infrastructure (roles, isolation, and execution boundaries), it held."},"2364":{"id":"/developer-updates-860","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-1","content":"Many teams make this fundamental mistake of treating access control as a prompting problem instead of a system problem."},"2365":{"id":"/developer-updates-861","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-1","content":"The only reliable way to make agents safe is to design environments where destructive actions are physically unreachable, and all state changes flow through auditable, deterministic systems. Once safety is achieved by design, mistakes become recoverable, contained, and reviewable - and only then can agents be given meaningful autonomy across real production use cases."},"2366":{"id":"/developer-updates-862","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-19","content":"As projects get more complex, small workflow improvements start to matter a lot."},"2367":{"id":"/developer-updates-863","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-19","content":"This release brings a few updates aimed at making Pochi easier to work with day-to-day, including reusable skills, better task organization through archiving, and support for running long-running subtasks in the background."},"2368":{"id":"/developer-updates-864","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Agent Skills: You can now define and use Skills in Pochi to reuse agent instructions across tasks and projects. Skills are reusable instruction sets that influence how the agent approaches a task, making it easier to standardize workflows, encode domain-specific knowledge, or integrate external tools."},"2369":{"id":"/developer-updates-865","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Skills are defined as folders containing a SKILL.md file with metadata and instructions."},"2370":{"id":"/developer-updates-866","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Pochi automatically discovers skills from project (.pochi/skills/) and user (~/.pochi/skills/) locations."},"2371":{"id":"/developer-updates-867","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Skills can be installed from the community registry using the CLI:  (npx skills add <skill-source> --agent pochi)."},"2372":{"id":"/developer-updates-868","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Skills can be activated automatically based on task context or explicitly via slash commands. You can also combine multiple skills within a single task."},"2373":{"id":"/developer-updates-869","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Skills do not modify your project files unless explicitly used during execution. #1050"},"2374":{"id":"/developer-updates-870","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-15","content":"Your browser does not support the video tag."},"2375":{"id":"/developer-updates-871","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-15","content":"Task Archiving: You can now archive and unarchive Pochi tasks from the sidebar on a per-worktree basis. Archived tasks can be hidden or shown using a toggle, and you can optionally archive tasks older than 7 days to keep the task list clean. #1106"},"2376":{"id":"/developer-updates-872","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-15","content":"Your browser does not support the video tag."},"2377":{"id":"/developer-updates-873","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-15","content":"Background Subtasks: newTask can now be run asynchronously as a background child task. These subtasks preserve the parent–child relationship but do not block the parent task, allowing agents to delegate long-running work while continuing execution.#1022"},"2378":{"id":"/developer-updates-874","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-4","content":"The browser subagent is currently under active development. When it lands, you’ll be able to watch the agent’s browsing actions stream directly in the editor and incorporate those observations into plans, reviews, and execution."},"2379":{"id":"/developer-updates-875","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-4","content":"We’re also working on automatic walkthroughs that recap the changes an agent made once a task is complete. More details coming soon."},"2380":{"id":"/developer-updates-876","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"Your browser does not support the video tag."},"2381":{"id":"/developer-updates-877","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"We added Skills to Pochi."},"2382":{"id":"/developer-updates-878","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"As tasks grow more complex, users often end up repeatedly explaining the same details to the agent, including output formatting, API usage, and internal conventions."},"2383":{"id":"/developer-updates-879","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"Skills turn those repeated instructions into reusable capabilities."},"2384":{"id":"/developer-updates-880","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"In Pochi, skills live alongside your code, are easy to inspect and edit, and plug directly into tasks. They can be automatically discovered, explicitly invoked, and combined with other features like Plan Mode, reviews, and scoped tool access."},"2385":{"id":"/developer-updates-881","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"That means skills are here to shape how work actually gets done. You can standardize workflows, or integrate tools once, and then reuse that behavior consistently across tasks and projects."},"2386":{"id":"/developer-updates-882","page_id":"/developer-updates","type":"text","url":"/developer-updates#reusable-skills-stop-repeating-prompts-1","content":"Read the full docs"},"2387":{"id":"/developer-updates-883","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-20","content":"As Pochi takes on larger and more complex tasks, it’s increasingly important to be explicit about intent and permissions."},"2388":{"id":"/developer-updates-884","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-20","content":"This release introduces new workflows for planning before execution and for restricting tool access per task, making agent behavior easier to reason about and safer by default."},"2389":{"id":"/developer-updates-885","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"Create Plan Mode: You can now create a task in Plan Mode to generate and refine an implementation plan before any code is changed. To use, click on the Plan option when creating a new task from the sidebar."},"2390":{"id":"/developer-updates-886","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"Plan tasks   generates a structured implementation plan instead of immediately executing edits."},"2391":{"id":"/developer-updates-887","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"The plan is stored as a workspace artifact (i.e. plan.md) in Pochi’s virtual filesystem and does not modify your project directory."},"2392":{"id":"/developer-updates-888","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"You can create a separate plan for each task without polluting your repo."},"2393":{"id":"/developer-updates-889","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"You can use existing workflows: inline comments, review edits, and follow-up prompts to refine the plan."},"2394":{"id":"/developer-updates-890","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"After review, you can explicitly start execution from the approved plan."},"2395":{"id":"/developer-updates-891","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"This makes planning a first-class step in the agent workflow and lets you align on scope, approach, and risks before applying multi-file changes.#819"},"2396":{"id":"/developer-updates-892","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-16","content":"Your browser does not support the video tag."},"2397":{"id":"/developer-updates-893","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-16","content":"Granular MCP Tool Control in Sidebar: You can now control MCP access per task instead of auto-approving all tools globally. Follow-up messages are restricted to the MCP servers selected at task creation."},"2398":{"id":"/developer-updates-894","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-16","content":"To try it out, look for the MCP server selector in the sidebar input. Servers disabled in global settings are not shown in the selector. This provides better security and more explicit control over which tools the agent can use. #939"},"2399":{"id":"/developer-updates-895","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-16","content":"Your browser does not support the video tag."},"2400":{"id":"/developer-updates-896","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-16","content":"Fixed Token Coloring in NES Code Renderer: Fixed an issue where certain token types (such as string literals) were not being theme-colored correctly in the NES code renderer. #731"},"2401":{"id":"/developer-updates-897","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-5","content":"Soon you’ll be able to archive tasks in the sidebar to keep active work focused, with filters and quick restore when you need to revisit something."},"2402":{"id":"/developer-updates-898","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-5","content":"We’re also building a built-in browser subagent that can browse and interact with live web pages and stream its actions directly in the editor."},"2403":{"id":"/developer-updates-899","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"Your browser does not support the video tag."},"2404":{"id":"/developer-updates-900","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"We shipped Plan Mode in Pochi."},"2405":{"id":"/developer-updates-901","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"Planning by itself isn’t new. What’s interesting is what happens when planning plugs into a workflow that already supports inline comments, review edits, and task-based execution."},"2406":{"id":"/developer-updates-902","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"Create Plan is a feature we built, but its real value comes from how it composes with the rest of the system."},"2407":{"id":"/developer-updates-903","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"Instead of treating the plan as something you just read and approve, you can iterate on it the same way you’d review a diff - leave inline comments, refine specific steps, and then execute directly from that agreed version."},"2408":{"id":"/developer-updates-904","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"The plan lives as a real workspace artifact (i.e. plan.md) and opens in the editor, so planning becomes part of the same collaboration loop as code."},"2409":{"id":"/developer-updates-905","page_id":"/developer-updates","type":"text","url":"/developer-updates#plan-like-you-code-1","content":"Read the full docs"},"2410":{"id":"/developer-updates-906","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-21","content":"Another batch of updates is out. Here’s what we’ve shipped since the last release."},"2411":{"id":"/developer-updates-907","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-17","content":"New Pochi landing page: The Pochi website now has a new landing page with clearer explanations of core features, workflows, and setup, making it easier for new users to evaluate and install Pochi. #Visit Page"},"2412":{"id":"/developer-updates-908","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-17","content":"Your browser does not support the video tag."},"2413":{"id":"/developer-updates-909","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-17","content":"Embedded bash outputs are now visible in the UI: When workflows embed command outputs into the model context (for example git diff in the create-pr workflow), those outputs are now displayed in chat instead of being hidden as system messages, making it easier to inspect and debug what the agent is responding to. #1010"},"2414":{"id":"/developer-updates-910","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-17","content":"Your browser does not support the video tag."},"2415":{"id":"/developer-updates-911","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-3","content":"We published a step-by-step guide showing how to use Git worktrees and parallel agents to run multiple tasks concurrently, with a practical weather app example that walks through setup, coordination, and best practices. #Read more"},"2416":{"id":"/developer-updates-912","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-6","content":"Along with Create Plan flow for new tasks, we’re also working on letting you choose which MCP servers and tools a task can access directly from the sidebar, instead of using a single global auto-approve toggle."},"2417":{"id":"/developer-updates-913","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-6","content":"Stay tuned!"},"2418":{"id":"/developer-updates-914","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-22","content":"Hope your year’s been off to a good start."},"2419":{"id":"/developer-updates-915","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-22","content":"We’re back to shipping, and this release includes updates to how follow-up prompts use your local edits, a clearer Auto Layout setup flow, better recovery when things fail (like model loading and Mermaid diagrams), and a few UI fixes that remove common friction points."},"2420":{"id":"/developer-updates-916","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-22","content":"Let’s dive in!"},"2421":{"id":"/developer-updates-917","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-17","content":"User Edits are now included in agent context: Recent code changes you make are now captured and sent along with your next prompt. These edits are also shown in the chat context and multi-diff view, so you can see exactly what the agent is reacting to."},"2422":{"id":"/developer-updates-918","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-17","content":"This helps the agent continue from your version of the code without you needing to re-explain what you already changed. #983"},"2423":{"id":"/developer-updates-919","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-17","content":"Your browser does not support the video tag."},"2424":{"id":"/developer-updates-920","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Improved Auto Layout onboarding: Auto Layout can modify several VS Code settings such as layout, keybindings, auto-save, and conflicting completions. The new onboarding screen explains these changes upfront and allows you to selectively apply them, making it easier to enable Auto Layout with confidence. #985"},"2425":{"id":"/developer-updates-921","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Create worktrees from remote branches: When creating a new worktree, you can now choose a remote branch (for example, origin/feature-branch) as the base instead of being limited to local branches. This makes it easier to start from branches that exist on the remote but aren’t checked out locally. #958"},"2426":{"id":"/developer-updates-922","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Your browser does not support the video tag."},"2427":{"id":"/developer-updates-923","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Recover from Mermaid rendering errors in chat: When a Mermaid diagram fails to render, a Fix error with Pochi button is now shown so you can ask the agent to correct the diagram instead of being stuck with a broken block. #968"},"2428":{"id":"/developer-updates-924","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Your browser does not support the video tag."},"2429":{"id":"/developer-updates-925","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"Retry when models fail to load: If the model list fails to load due to a network or backend issue, you can now retry directly from the UI instead of reloading the entire VS Code window.#984"},"2430":{"id":"/developer-updates-926","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-18","content":"More space for worktree details: We optimized the worktree list layout so action buttons no longer take up space when not visible, giving more room for worktree names and PR information, particularly on smaller screens.#925"},"2431":{"id":"/developer-updates-927","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-7","content":"We’re working on a Create Plan flow for new tasks in the sidebar, letting you generate a structured plan first before executing the task."},"2432":{"id":"/developer-updates-928","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"So far in this series, you’ve seen how we trained our NES model, what that model takes as context to make a prediction, and how these model requests are managed with correct timing under continuous typing."},"2433":{"id":"/developer-updates-929","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"With this, we’ve reached a point where NES can predict what edit should happen and when it should appear in the editor."},"2434":{"id":"/developer-updates-930","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"In Part 4, we'll talk about how there is still one critical decision to make. Once a suggestion arrives, how should that change be presented inside a live editor?"},"2435":{"id":"/developer-updates-931","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"Pochi’s NES is built as a VS Code-native feature, not a standalone IDE or a custom fork. This means previews must integrate with VS Code’s public APIs, performance model, and established interaction patterns."},"2436":{"id":"/developer-updates-932","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"This introduces a core design challenge - to surface enough context for a suggestion to be actionable, without disrupting the developer's flow."},"2437":{"id":"/developer-updates-933","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-4-dynamic-rendering-strategies-for-ai-code-edits-1","content":"Designing a system that honors this is more than a matter of visual polish; it is a complex systems + UX problem. We’ll explore why this balance is so difficult for a native AI agent and the specific rendering strategies NES uses to achieve it."},"2438":{"id":"/developer-updates-934","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"Unlike conventional editor features, NES does not control where the user’s cursor is when a suggestion arrives. The editor is a continuously changing environment and does not function like a static canvas. Sometimes the user's cursor might be exactly where the edit belongs, or it can be twenty lines away, or the suggestion itself can be a huge change spanning multiple lines."},"2439":{"id":"/developer-updates-935","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"Showing such suggestions naïvely introduces new failure modes that are easy to trigger and hard to ignore. One experiences jumps in cursor position, abrupt viewport scrolls, or rendering large changes directly in the editing flow. In practice, these behaviors are often more disruptive than not showing a suggestion at all."},"2440":{"id":"/developer-updates-936","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"This brings us to the most fundamental design question: How do we show an edit without stealing the developer’s attention?"},"2441":{"id":"/developer-updates-937","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"Answering that question requires understanding the VS Code interaction model."},"2442":{"id":"/developer-updates-938","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"VS Code does not provide a built-in API for previewing LLM-generated edits. Instead, the editor offers different primitives for different kinds of locations and edits. These primitives are optimized for various interaction patterns, each with their own affordances and limitations. Some work well for cursor-local edits, while others are better suited for changes elsewhere in the file."},"2443":{"id":"/developer-updates-939","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-display-problem","content":"Understanding this difference is key. Pochi's NES does not render suggestions in a single, fixed way. Instead, NES relies on these primitives to create a balance between visibility and disruption."},"2444":{"id":"/developer-updates-940","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"Rather than forcing all suggestions into a single representation, we designed a Dynamic Rendering Strategy offering the optimal visual experiences in different editing scenarios:"},"2445":{"id":"/developer-updates-941","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"Suggestions that target the current cursor position are rendered inline, flowing naturally into the user's typing behavior."},"2446":{"id":"/developer-updates-942","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"Suggestions that apply off-cursor are previewed via an inline diff decoration, avoiding jumps in the viewport."},"2447":{"id":"/developer-updates-943","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"For large, multi-line block inserts, a floating preview is used to provide sufficient context without disrupting the user's current focus."},"2448":{"id":"/developer-updates-944","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"This way, each path is deliberately scoped to the situations where it performs best, aligning it with the least disruptive representation for a given edit."},"2449":{"id":"/developer-updates-945","page_id":"/developer-updates","type":"text","url":"/developer-updates#dynamic-rendering-strategy","content":"Let’s take a walk-through of these rendering strategies in detail and examine when each one is used, starting with the least disruptive case."},"2450":{"id":"/developer-updates-946","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-completion","content":"When an edit is positioned right at the cursor, the least disruptive option is to stay out of the way. In such cases, we render the edit inline, making it blend directly into the user's typing flow."},"2451":{"id":"/developer-updates-947","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-completion","content":"To achieve this, we use VS Code's inline completion API. This approach works especially well for small, localized changes like autoclosing brackets, replacing a few characters, or edits that are directly made under the cursor."},"2452":{"id":"/developer-updates-948","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-diff-preview","content":"Because NES predicts the next meaningful edit across the file (not just at the cursor), many suggestions naturally apply outside the user’s current editing position. For example, while you are typing inside a function, NES may suggest updating a related import, adjusting a type definition, or fixing a reference several lines away."},"2453":{"id":"/developer-updates-949","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-diff-preview","content":"In these cases, the cost of getting the presentation wrong is high. The user is forced to jump across the file, break context and interrupt their flow."},"2454":{"id":"/developer-updates-950","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-diff-preview","content":"To avoid that, we render the suggestion as an inline diff decoration. The text to be replaced is highlighted in red, while the new content is shown in green at the insertion point. This way, the user gets a clear preview of the change without moving the cursor."},"2455":{"id":"/developer-updates-951","page_id":"/developer-updates","type":"text","url":"/developer-updates#inline-diff-preview","content":"This works particularly well for changes involving single-line updates or even multiple lines where each line is being changed independently."},"2456":{"id":"/developer-updates-952","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"Because NES has the ability to propose structural edits, such as inserting a new helper function, refactoring a block of logic, or adding a multi-line configuration, it frequently produces multi-line suggestions that cannot be represented as simple, inline changes."},"2457":{"id":"/developer-updates-953","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"In these cases, the suggestion is no longer tied to the cursor’s immediate context, and the standard inline rendering stratergies do not suffice."},"2458":{"id":"/developer-updates-954","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"At this point, the decision falls under either pulling the user away from where they’re working or bringing the preview to them. Since preserving developer flow is a core design principle for NES, we consistently choose the latter."},"2459":{"id":"/developer-updates-955","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"In order to make the suggestion appear near the edit target without moving the cursor, we generate a floating diff preview and render it as an image. The color schema of the suggestion will also stay consistent with the other solutions we discussed previously - red for deleted text, and green for inserted ones."},"2460":{"id":"/developer-updates-956","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"VS Code allows extensions to attach image-based decorations. With careful layout and positioning, these decorations can be floated near the edit target and used as a diff preview. However, the editor does not render code into images, which means the preview has to be generated by the extension itself."},"2461":{"id":"/developer-updates-957","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"This required a small rendering pipeline:"},"2462":{"id":"/developer-updates-958","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"Theme matching: Every VS Code theme is an extension with a standard JSON format. We parse the active theme, extract its token colour map, and match it to the user’s active settings so the preview matches the theme in the editor."},"2463":{"id":"/developer-updates-959","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"Syntax highlighting: VSCode includes a bundled TextMate runtime. We load the grammar for the current filetype, generate syntax scopes, and apply the same colouring rules that VS Code uses. This ensures that the rendered code maintains the same appearance as the code in the editor."},"2464":{"id":"/developer-updates-960","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"Image rendering: Here we use canvaskit-wasm to render the tokenized code into an image. To draw the code properly, we took the editor’s current fontSize and lineHeight, drew each tokenized segment at the correct coordinates, then applied diff highlights (additions in green and removals in red). The final image is then surfaced using the decoration API."},"2465":{"id":"/developer-updates-961","page_id":"/developer-updates","type":"text","url":"/developer-updates#floating-diff-image","content":"This approach allows multi-line edit suggestions to appear near their target location while preserving cursor position and avoiding viewport jumps."},"2466":{"id":"/developer-updates-962","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-2","content":"Different kinds of edit suggestions need different presentation strategies, with the editor API playing a decisive role in shaping the final experience."},"2467":{"id":"/developer-updates-963","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-2","content":"Rendering an NES suggestion ended up being less about displaying text and more about maintaining the reader’s attention. Because no matter what, once attention is broken, even the best suggestion gets ignored."},"2468":{"id":"/developer-updates-964","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-2","content":"Each rendering path is designed to stay as close as possible to the developer’s flow while working within the editor’s interaction model."},"2469":{"id":"/developer-updates-965","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-2","content":"At this point in our journey, NES can decide what to suggest (the model), when to surface it (request management), and how to show it without disruption (rendering paths). Combined, these layers define how AI-generated edit results become truly helpful in a real IDE."},"2470":{"id":"/developer-updates-966","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-23","content":"This release we focused on improving how you review, refine, and iterate on agent-generated code inside VS Code."},"2471":{"id":"/developer-updates-967","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-23","content":"We also targeted some bug fixes that increased correctness and stability during multi-step agent runs."},"2472":{"id":"/developer-updates-968","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-23","content":"Let’s dive in!"},"2473":{"id":"/developer-updates-969","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Reviews (Inline Comments) in VS Code: You can now review and refine agent-generated code directly inside the editor using Reviews."},"2474":{"id":"/developer-updates-970","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Reviews let you leave inline comments on the diff, tied to exact files and line numbers. Instead of re-explaining issues in chat, you can mark multiple problems across the code and submit them together as a single review. Pochi uses this line-level context to apply fixes in one focused revision pass."},"2475":{"id":"/developer-updates-971","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"This is not a PR review system. Reviews are private, pre-PR discussions with the LLM, attached directly to code while you’re still iterating. #922"},"2476":{"id":"/developer-updates-972","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Your browser does not support the video tag."},"2477":{"id":"/developer-updates-973","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Select Base Branch When Creating a Git Worktree: You can now choose a base branch when creating a new Git worktree in VS Code."},"2478":{"id":"/developer-updates-974","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Previously, worktrees were always based on the current branch (HEAD), which could lead to accidental branch-on-branch workflows. Now you can start clean from main (default) or any other branch. #864"},"2479":{"id":"/developer-updates-975","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-18","content":"Your browser does not support the video tag."},"2480":{"id":"/developer-updates-976","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-17","content":"Improved Problem Detection in File Writing Tool Calls: Fixed an issue where problems introduced and resolved across multiple file edits were not reported correctly to the agent. Diagnostics are now compared before the first edit and after the final edit, ensuring resolved issues don’t confuse subsequent agent reasoning. #915"},"2481":{"id":"/developer-updates-977","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-17","content":"Fix Missing Tool Call Checkpoints: We also fixed an issue where tool call checkpoints could be missed due to checkpoint generation happening before streaming completed. Checkpoints are now generated after the stream finishes, ensuring all tool calls, including the final one, gets properly recorded. #911"},"2482":{"id":"/developer-updates-978","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-8","content":"We’re working on previewing tracked user edits directly in the input chat before prompting, and a guided auto-layout intro that explains which editor settings Pochi modifies (layout keybindings, panel behavior, auto-save, conflicting extensions), with the ability to opt into only what you want."},"2483":{"id":"/developer-updates-979","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-24","content":"This release is still in progress, but here are some early previews of what’s coming."},"2484":{"id":"/developer-updates-980","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-24","content":"Also, starting this week, along with weekly updates, we’ll now include key debates and decisions happening inside the team. If you want a voice in what ships, do reply to us in the links given below."},"2485":{"id":"/developer-updates-981","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-9","content":"Inline LLM comments are in the works. Leave notes on specific lines and the agent responds in context. These aren’t PR review comments, they’re AI discussion threads attached to code."},"2486":{"id":"/developer-updates-982","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-9","content":"You'll soon be able to choose the base branch when creating a new worktree, instead of being forced to use the current branch (HEAD). This makes it easier to start clean feature branches from main or any branch you prefer."},"2487":{"id":"/developer-updates-983","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-4","content":"We published Part 3 of our NES series, covering how we handle model requests while a user is actively typing. Read the full blog here."},"2488":{"id":"/developer-updates-984","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"Do AI coding agents review the wrong coding step? We’re debating a shift in how coding agents should be reviewed. Most tools pause the workflow to approve a plan before execution."},"2489":{"id":"/developer-updates-985","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"But in practice, plans happen before the agent has paid the cost of reality: before navigation, failed tests, dependency issues, and edge cases. The result is confident speculation, and not based on insights."},"2490":{"id":"/developer-updates-986","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"We believe that the real checkpoint should happen after the work: reviewing the walkthrough, the diffs, what broke, what got fixed, and why. That’s much closer to how engineers review code today. We’re debating this direction and would love your input."},"2491":{"id":"/developer-updates-987","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"AI coding conversations should be append-only: Instead of editing past prompts, the idea is to keep the history intact and fork from earlier points, similar to branching in Git."},"2492":{"id":"/developer-updates-988","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"Your browser does not support the video tag."},"2493":{"id":"/developer-updates-989","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"Editing history might feel convenient, but it erases the reasoning, the failed attempts, and the learning that happened."},"2494":{"id":"/developer-updates-990","page_id":"/developer-updates","type":"text","url":"/developer-updates#-internal-tech-discussions","content":"Read the full post and tell us what you think!"},"2495":{"id":"/developer-updates-991","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"In Part 1, we talked about how we trained our NES model to predict the next meaningful edit you’re likely to make in your code."},"2496":{"id":"/developer-updates-992","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"In Part 2, we then covered what the model takes as context to make this edit. This included deep dives into editable regions, user’s edit history, and using the overall project context."},"2497":{"id":"/developer-updates-993","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"Together, these two pieces (model + context) form the core intelligence foundation of the NES system. But incorporating them into an end-to-end real-time engineering system requires more thinking about real developer coding behaviour."},"2498":{"id":"/developer-updates-994","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"A code editor is a continuously changing space. Developers type, pause, delete, move the cursor, undo, redo, and essentially keep editing, often faster than any model can respond. Even a fast model call involves network latency, debouncing delays, server-side scheduling, and decoding / streaming time."},"2499":{"id":"/developer-updates-995","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"If not careful, a request that was correct when it was sent can return a response that arrives a few hundred milliseconds too late. Which means now you end up with edit suggestions for code that no longer exists. This is something that’s termed “haunted” for being technically right but not at the right place."},"2500":{"id":"/developer-updates-996","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"This means, in practice, a correct edit shown at the wrong moment is perceived as wrong by the user. So even with proper context and a good model, it is equally important to have the correct timing. Then only can the product actually feel useful without being distracting."},"2501":{"id":"/developer-updates-997","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"But getting timing right is challenging, due to the ever evolving nature of the user’s editing state. To make NES feel real-time and helpful, we had to reason about what happens before a request is sent, while it’s in-flight, and after the model responds. This is what we call request management."},"2502":{"id":"/developer-updates-998","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing-1","content":"Let’s look at it in more detail."},"2503":{"id":"/developer-updates-999","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"Request Management of a NES prediction happens in three stages:"},"2504":{"id":"/developer-updates-1000","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"Before the request: waiting until the user actually pauses"},"2505":{"id":"/developer-updates-1001","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"While the request is in-flight: discard anything that becomes outdated"},"2506":{"id":"/developer-updates-1002","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"After the model responds: keep the suggestion alive if the user continues along the same trajectory"},"2507":{"id":"/developer-updates-1003","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"These map to what we technically implement as debouncing, cancellation, and speculative-prediction caching."},"2508":{"id":"/developer-updates-1004","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-nes-request-management-lifecycle","content":"This structure helps bring the intelligent results (what we get with context + model) to users reliably, even as they type continuously. NES continues to run this loop as you type.\nLet’s take a closer look at how we handle timing at each stage."},"2509":{"id":"/developer-updates-1005","page_id":"/developer-updates","type":"text","url":"/developer-updates#debouncing-requesting-the-model-at-the-right-moment","content":"The first question we had to tackle was, “When is the right time to send a request?” When a developer is typing continuously, a request on every keystroke has little value and is wasteful. At the same time, waiting too long would make the system feel unresponsive and slow. We had to find that sweet spot that lies in detecting the exact moment the user actually paused typing."},"2510":{"id":"/developer-updates-1006","page_id":"/developer-updates","type":"text","url":"/developer-updates#debouncing-requesting-the-model-at-the-right-moment","content":"Most systems solve this with a fixed interval, (say, 100ms), but real-world typing isn’t this predictable. Instead, we decided to adapt the debounce interval based on how the user is behaving right at that moment."},"2511":{"id":"/developer-updates-1007","page_id":"/developer-updates","type":"text","url":"/developer-updates#debouncing-requesting-the-model-at-the-right-moment","content":"To achieve this, we made NES pay attention to a handful of lightweight signals."},"2512":{"id":"/developer-updates-1008","page_id":"/developer-updates","type":"text","url":"/developer-updates#debouncing-requesting-the-model-at-the-right-moment","content":"For example, typing a . often means the developer is about to pause to access a method of an object,  so we get the signal to shorten the debounce delay. Whereas, if the user is continuously typing through a variable name, we stretch the delay a bit to avoid jumping in too early. And if the model’s recent response times have been slower due to network conditions, we account for that too, so suggestions land at the exact moment the user expects them."},"2513":{"id":"/developer-updates-1009","page_id":"/developer-updates","type":"text","url":"/developer-updates#debouncing-requesting-the-model-at-the-right-moment","content":"This way, the result is a debounce time window that changes with the user’s rhythm. It is short when the user has paused, and long when they’re in flow, all while making sure it never exceeds 1 second."},"2514":{"id":"/developer-updates-1010","page_id":"/developer-updates","type":"text","url":"/developer-updates#cancellation-correctness-over-completion","content":"Once a request is finally sent, the editor doesn’t stop moving. A user can continue typing, move the cursor, or undo and redo steps before the model has even started responding. When that happens, the original request becomes stale instantly."},"2515":{"id":"/developer-updates-1011","page_id":"/developer-updates","type":"text","url":"/developer-updates#cancellation-correctness-over-completion","content":"In such a case, we cancel the original request from the client-side, and in turn, the server propagates the cancellation, with any late responses being discarded without ever getting them rendered to the UI.\n\nThis is a deliberate design decision that optimises and enforces correctness in a live, ever-evolving editing system. We would prefer that NES show nothing rather than something misleading."},"2516":{"id":"/developer-updates-1012","page_id":"/developer-updates","type":"text","url":"/developer-updates#cancellation-correctness-over-completion","content":"If you’re interested in how this works end-to-end, including streaming behaviour, we’ve written more about it here."},"2517":{"id":"/developer-updates-1013","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Traditional caching is straightforward. If nothing has changed, just reuse the previous response. In the case of NES, this helps to avoid duplicate requests. And to think about it, throwing work away all the time would be expensive if we didn’t balance it out elsewhere."},"2518":{"id":"/developer-updates-1014","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"But we go a step further. When the model returns an edit suggestion, we don’t just cache it for the exact context that produced it, but also speculate on the next few contexts the user is likely to enter."},"2519":{"id":"/developer-updates-1015","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Now, if the user continues typing along the same trajectory, NES doesn't need to call the model again and can continue serving the speculated suggestion. We call this speculative prediction."},"2520":{"id":"/developer-updates-1016","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"A speculated prediction remains valid as long as the user is essentially still typing into the suggestion and the surrounding context hasn't changed."},"2521":{"id":"/developer-updates-1017","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"It’ll be better to illustrate this with the help of an example. Suppose a user types:"},"2522":{"id":"/developer-updates-1018","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"NES sends a request and gets the following suggestion:"},"2523":{"id":"/developer-updates-1019","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"If the user then continues to type, resulting in:"},"2524":{"id":"/developer-updates-1020","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"This user edit is part of the received suggestion. Therefore, the suggestion should still be displayed (unless the user has explicitly rejected it by pressing esc)."},"2525":{"id":"/developer-updates-1021","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"By retrieving this result from the forward prediction cache, we can display the suggestion faster and reduce LLM request usage."},"2526":{"id":"/developer-updates-1022","page_id":"/developer-updates","type":"text","url":"/developer-updates#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Of course, if the user is not satisfied with the cached suggestion, they still have the option to send a new request to get multiple choices. In essence, forward caching helps accelerate the common path, improving the overall experience."},"2527":{"id":"/developer-updates-1023","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-3","content":"By the time a suggestion appears in NES, a lot has already happened. Debouncing decides when is the right time to make a request, cancellation makes sure outdated intent never surfaces in the UI, and speculative prediction lets us reuse good existing predictions when the user naturally moves through them."},"2528":{"id":"/developer-updates-1024","page_id":"/developer-updates","type":"text","url":"/developer-updates#conclusion-3","content":"While you’d find these techniques are familiar in distributed systems, applying them inside a code editor was a challenge of its own. The primary driving factor wasn’t about throughput or load but about every evolving human intent under motion."},"2529":{"id":"/developer-updates-1025","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next","content":"So far, we’ve focused on how NES decides what to suggest and when those suggestions should appear. With request management in place, we now have a system that ensures LLM-powered edits reach the user only when they’re truly helpful."},"2530":{"id":"/developer-updates-1026","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next","content":"But now that brings us to the next stage of the process: How should these edits be presented?"},"2531":{"id":"/developer-updates-1027","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next","content":"NES suggestions aren’t always a single line near the cursor. Sometimes the relevant edit is several lines or even several files away. Presenting enough information for a quick action without breaking the developer’s flow is a surprisingly deep design and engineering challenge."},"2532":{"id":"/developer-updates-1028","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next","content":"This is especially tricky inside a code editor like VS Code, where rendering options are limited. In such cases, how do we preview multi-line edits precisely? How do we make them feel lightweight, immediate, and skimmable, without being modal or disruptive?"},"2533":{"id":"/developer-updates-1029","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next","content":"In Part 4, we’ll dive into how we approached these constraints and built a rendering system that enables richer previews and lower-latency interactions for code edits."},"2534":{"id":"/developer-updates-1030","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-25","content":"This week includes several improvements and bug fixes across the VSCode extension and Web UI."},"2535":{"id":"/developer-updates-1031","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-25","content":"A mix of workflow enhancements, UI polish, and reliability fixes landed. Here are the highlights:"},"2536":{"id":"/developer-updates-1032","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"Improved Worktree Selector in VSCode Web UI: We’ve added support for creating a new worktree with an auto generated name directly from the dropdown; an additional way other than Cmd + Enter a prompt. We also included tooltips and  renamed main worktree to workspace in the worktree list UI to better reflect its purpose. #896, #875"},"2537":{"id":"/developer-updates-1033","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"Your browser does not support the video tag."},"2538":{"id":"/developer-updates-1034","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"Open diff directly from a task: Clicking a task with diffs now opens both the task and its diff panel, making it easier to review changes directly from the task list. #849"},"2539":{"id":"/developer-updates-1035","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"Your browser does not support the video tag."},"2540":{"id":"/developer-updates-1036","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"Quick task creation from the Worktree sidebar: Added a + button next to each worktree to create a new task. #877"},"2541":{"id":"/developer-updates-1037","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-19","content":"New keyboard shortcut: Added a Ctrl+ ` keybinding in VSCode to instantly toggle the Pochi layout or open the terminal, improving keyboard-first navigation. This shortcut only exists as an advance configuration at the moment. To enable it, set enablePochiLayoutKeybinding in VSCode settings pochi.advanced section to true. #881"},"2542":{"id":"/developer-updates-1038","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-18","content":"Improved PR fetching reliability: Fixed the GitHub PR fetching logic to exclude pull requests from forked repositories, ensuring only relevant PRs from the main repo appear in the Worktree/PR selector. #893"},"2543":{"id":"/developer-updates-1039","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"Using SFT teaches models how to write code, but it is RL that is necessary to teach them what works. On the other hand, introducing RL in software engineering brings its own specific challenges:  data availability, signal sparsity, and state tracking. In this post, we’ll break down how recent works address these challenges."},"2544":{"id":"/developer-updates-1040","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"So far, the focus of RL driven improvements had been based on competitive coding. For example, in LeetCode-style tasks, the model works in a closed loop. It generally receives a clear problem statement and in turn, it generates a single, self-contained solution."},"2545":{"id":"/developer-updates-1041","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"This means there are no dependencies involved, no files systems to navigate, and no legacy code that can break. It is exactly like solving a logic puzzle in isolation rather than understanding the engineering implications on the overall codebase."},"2546":{"id":"/developer-updates-1042","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"However, the field of Software Engineering (SWE) in real-world is fundamentally different. It is a stateful, multi-turn interactive problem. A day-to-day involves much more than just writing the correct functions. You often need to navigate a file system, check up on dependency graphs, run the proper tests, and interpret logs in case of errors. This implies, an agent effectively needs to maintain coherence across a long horizon of interactions."},"2547":{"id":"/developer-updates-1043","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"Which is why RL is an ideal candidate for SWE since agent actions produce verifiable results. At the same time, it also introduces challenges that are not present in single-turn tasks. For example,"},"2548":{"id":"/developer-updates-1044","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"Data Availability: We cannot easily simulate millions of environmental interactions like we can with math problems."},"2549":{"id":"/developer-updates-1045","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"Signal Sparsity: Often, success signals appear at the very end of a long sequence of edits."},"2550":{"id":"/developer-updates-1046","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"State Tracking: Along with the static text of the code, the model must understand the dynamic state of the runtime environment"},"2551":{"id":"/developer-updates-1047","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-26","content":"Recent works from Meta and Moonshot AI surfaced how the industry is pivoting from general reasoning RL to domain-specific SWE-RL to address these challenges."},"2552":{"id":"/developer-updates-1048","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-data-problem","content":"In order to learn trial and error, the standard RL requires an agent to interact with an environment. For coding, this means running a test suite or compiling code. As compared to verifying math proof, this simulation will be prohibitively slow and expensive in a real-world setting. Here, the engineering challenges arises to figure out how to bootstrap the entire learning process without being dependent on costly online simulation."},"2553":{"id":"/developer-updates-1049","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-data-problem","content":"Meta proved that you can bypass the online bottleneck by using the massive offline history of Github. In its recent work on SWE-RL they talked through this approach instead of setting up a live sandbox for every training step."},"2554":{"id":"/developer-updates-1050","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-data-problem","content":"But offline data lacks a reward signal. For every historical Pull Request, you cannot easily go back in time and execute tests. SWE-RL solves this by creating a process proxy reward. They calculate the fine grained text similarity  between the generated patch and the actual developer ground truth solution instead of just checking if the code runs."},"2555":{"id":"/developer-updates-1051","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-data-problem","content":"Depending on how closely the generated format matches the human solution, the model receives a continuous reward. On the other hand, if the model generates an invalid patch format, it receives a penalty. This demonstrates that even before touching a compiler, you can teach a model complex engineering behaviours like navigating file structures and adhering to project conventions using static history."},"2556":{"id":"/developer-updates-1052","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-signal-sparsity-problem","content":"Next, we have the credit assignment problem while facing online training within executable environments. That means it is difficult to indentify which step really contributed to the final success of the model and which step should get the reward. This reflects on software engineering as any agent can fail after 50 steps of editing and testing. Standard RL struggles to identify which specific step caused the failure."},"2557":{"id":"/developer-updates-1053","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-signal-sparsity-problem","content":"The Kimi-Dev paper addresses this through task decomposition. It treats software engineering as a composition of atomic skills: the BugFixer (editing logic) and the TestWriter (verifying logic) instead of training an end-to-end agent to solve the issue immediately."},"2558":{"id":"/developer-updates-1054","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-signal-sparsity-problem","content":"Their solution starts with Agentless RL. They train the model specifically on these short horizon atomic tasks using outcome based rewards. They look for signals on whether the patch passed the test or did the test reproduce the bug. And since the tasks are scoped down, the feedback signal becomes dense and clear."},"2559":{"id":"/developer-updates-1055","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-signal-sparsity-problem","content":"Kimi-Dev shows that with minimal additional data, a model having these pre-trained capabilities can be adapted to a complex multi-turn agent framework. This suggests that the most efficient path to autonomous agents is rigorous skill acquisition’s followed by workflow adaptation rather than brute force end to end training."},"2560":{"id":"/developer-updates-1056","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"Coming to the final challenge, which is also arguably the most profound. Engineers generally do not just read code as text but also think about the execution loops in their mind. This involves tracking how variables change in memory and how functions interact between files. Meanwhile, since current code LLMs lack this internal compiler engine, they just merely predict the next token based on statistical likelihood."},"2561":{"id":"/developer-updates-1057","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"Meta Code World Model addresses this by fundamentally changing the training curriculum. They realized that waiting until the RL phase to teach execution dynamics is too late. The rewards are too sparse and the gradient vanishes on hard problems."},"2562":{"id":"/developer-updates-1058","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"Instead, in the mid-training stage, they inject process supervision directly. To teach the physics of code, they constructed two massive datasets:"},"2563":{"id":"/developer-updates-1059","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"Python Execution Traces: With over 120 million examples, the model is trained to predict not just the next line of code, but also the exact state of runtime variables (the values in memory) after every single line."},"2564":{"id":"/developer-updates-1060","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"ForagerAgent Trajectories: Agents with 3 million trajectories that interact with a Docker environment to solve tasks."},"2565":{"id":"/developer-updates-1061","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"This forces the model to internalise a Code World Model. By the time the model enters the final RL stage it is no longer starting from scratch. It already understands if I write X then variable Y changes to Z."},"2566":{"id":"/developer-updates-1062","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-state-problem-building-a-code-world-model","content":"Consequently, the RL stage becomes a process of Goal Alignment. It uses sparse result rewards like passing tests simply to guide a model.  It already understands execution physics to select the specific path that satisfies the verification requirement."},"2567":{"id":"/developer-updates-1063","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"This progression from SWE-RL (offline proxy rewards) to Kimi-Dev (decomposed skill learning) and CWM (execution-trace world models) outlines a clear engineering roadmap for the next generation of code models and agentic RL frameworks."},"2568":{"id":"/developer-updates-1064","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"We are seeing a shift from generic reasoning to specialized engineering. Future models will be more than just smart. They will be grounded in repository history, capable of self-verification through test writing, and possess an explicit internal model of runtime state."},"2569":{"id":"/developer-updates-1065","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"At TabbyML we view these developments as the foundation for Verifiable Engineering. The future value of AI in software development lies in building agents that understand and respect the state of your system."},"2570":{"id":"/developer-updates-1066","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"Related Papers:"},"2571":{"id":"/developer-updates-1067","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"SWE-RL: Advancing LLM Reasoning via Reinforcement Learning on Open Software Evolution"},"2572":{"id":"/developer-updates-1068","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"Kimi-Dev: Agentless Training as Skill Prior for SWE-Agents"},"2573":{"id":"/developer-updates-1069","page_id":"/developer-updates","type":"text","url":"/developer-updates#takeaway-moving-toward-verifiable-agents","content":"CWM: An Open-Weights LLM for Research on Code Generation with World Models"},"2574":{"id":"/developer-updates-1070","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-27","content":"This release introduces pair of upgrades aimed at making Pochi feel even more native to your development flow: GitHub Issue integration embedded right into task input, and a new Cmd/Ctrl + Enter shortcut to spin up worktrees easily."},"2575":{"id":"/developer-updates-1071","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"GitHub Issue Integration in Task Input: You can now connect tasks directly to GitHub Issues. Typing @# opens an inline issue selector where you can search by issue ID, keyword, or scroll the dropdown list."},"2576":{"id":"/developer-updates-1072","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"All newly created issues are accessible within a minute. Once selected, issues appear as markdown badges and are sent as enriched context to the model."},"2577":{"id":"/developer-updates-1073","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"Note: This feature requires GitHub CLI to be installed and authenticated. #833"},"2578":{"id":"/developer-updates-1074","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"Your browser does not support the video tag."},"2579":{"id":"/developer-updates-1075","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"Create a New Worktree + Task with Cmd/Ctrl + Enter: You can now start a brand-new worktree and task instantly using Cmd+Enter (macOS) or Ctrl+Enter (Windows/Linux). When you submit a prompt with this shortcut, Pochi automatically creates a new worktree with an auto-generated branch name (based on the task description, falling back to a timestamp when needed) and launches a new task inside it."},"2580":{"id":"/developer-updates-1076","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"The shortcut also works when submitting messages with file or image attachments. In existing tasks, Cmd/Ctrl+Enter continues to queue messages as before. #822"},"2581":{"id":"/developer-updates-1077","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-19","content":"Your browser does not support the video tag."},"2582":{"id":"/developer-updates-1078","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-2-real-time-context-management-in-your-code-editor-1","content":"In Part 1, we covered how we trained our NES model, including topics such as the special tokens we use, the LoRA-based fine-tuning on Gemini Flash Lite, and how we utilized a judge LLM to evaluate the model."},"2583":{"id":"/developer-updates-1079","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-2-real-time-context-management-in-your-code-editor-1","content":"However, the end experience is far more than just building a good model. To make NES feel “intent-aware” inside your editor, we needed to give the model the right context at the right moment."},"2584":{"id":"/developer-updates-1080","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-2-real-time-context-management-in-your-code-editor-1","content":"In part 2, we’ll talk about that runtime system, or to be precise, how Pochi manages, ranks, and streams real-time edit context.  This is the core that helps NES to understand your intent and predict the next meaningful change."},"2585":{"id":"/developer-updates-1081","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"To start, let’s understand what context management is. In our case, it’s the layer between when a user starts typing and when the model is called with a well-formed prompt. During that in-between phase, the system gathers and prepares all the relevant context the LLM needs before we make a model request."},"2586":{"id":"/developer-updates-1082","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"As to why it matters, imagine simply sending the entire file to the model on every keystroke. Not only will the model become slower and noisier, but you’d get unstable predictions and over 20 model calls per second, rendering the whole experience unusable."},"2587":{"id":"/developer-updates-1083","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"Instead, as previewed in the first article, we provide NES with three kinds of context:"},"2588":{"id":"/developer-updates-1084","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"File Context: text, filepath, cursor position, and the region to be edited"},"2589":{"id":"/developer-updates-1085","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"Edit History: record of recent edit steps"},"2590":{"id":"/developer-updates-1086","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"Additional context from other files (optional): e.g., functions/type declarations that help understand the current file"},"2591":{"id":"/developer-updates-1087","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-context-management-matters","content":"Each of these depends on clever filtering, segmentation, and timing - all of which happen in milliseconds during normal typing, as we’ll learn below."},"2592":{"id":"/developer-updates-1088","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-file-context-finding-the-live-region-of-code","content":"The first question to solve: “Where is the user editing right now?”. This is the foundation of every NES prompt. We answer this by gathering three quick pieces of information from the VS Code API:"},"2593":{"id":"/developer-updates-1089","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-file-context-finding-the-live-region-of-code","content":"The current file text"},"2594":{"id":"/developer-updates-1090","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-file-context-finding-the-live-region-of-code","content":"The file path"},"2595":{"id":"/developer-updates-1091","page_id":"/developer-updates","type":"text","url":"/developer-updates#1-file-context-finding-the-live-region-of-code","content":"The user’s cursor position\nUsing this information, we compute what is called “the editable region”. This region is generally a small code window around the user’s cursor of ~10 lines."},"2596":{"id":"/developer-updates-1092","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-10-lines","content":"Because realistically, the next edit will almost always happen very close to where the user is already editing. This small window keeps the latency extremely low and is large enough to capture the structure around the edit."},"2597":{"id":"/developer-updates-1093","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-10-lines","content":"And while we observe many models are over-eager and hallucinate changes elsewhere, our model is prevented from rewriting parts of the file the user wasn’t touching."},"2598":{"id":"/developer-updates-1094","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-10-lines","content":"An example of the editable region would be:"},"2599":{"id":"/developer-updates-1095","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-edit-history-following-the-users-intent-over-time","content":"So far, we have learnt where the user is currently editing, but we also need to understand how the code is changing over time. This is the part where edit history becomes important for the edit model to predict the user’s intent."},"2600":{"id":"/developer-updates-1096","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-edit-history-following-the-users-intent-over-time","content":"Now, while we could use the VS Code API to register a listener for text change events, this ends up triggering an event for almost every keystroke. For example, if a user updates a type from string to email, it ends up producing ~6 events."},"2601":{"id":"/developer-updates-1097","page_id":"/developer-updates","type":"text","url":"/developer-updates#2-edit-history-following-the-users-intent-over-time","content":"These are not your meaningful edit steps. If we send this to the model, it will think each keystroke is a new “user intent” and will fire too many requests with wildly different predictions.  Instead, we reconstruct real edit steps using an internal change segmentation grouping."},"2602":{"id":"/developer-updates-1098","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"Since we cannot directly use the listener events, we decided to reduce them to events that represent edit steps. To achieve this, we group raw text-change events into undo-redo scale units."},"2603":{"id":"/developer-updates-1099","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"Most editors record undo-redo steps on a word scale - for example, when a user inputs a sentence, an undo action will revert the last input word.\nIn our case, for building edit prediction prompts, we do this on a larger scale."},"2604":{"id":"/developer-updates-1100","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"Once we receive information on a user’s cursor position and tracking gets initiated, we create an edit steps list, where each step is an accumulation of several text change events. We found that 5 steps is the sweet spot to build a prompt. Anything more than that adds noise, and if less, loses the intent."},"2605":{"id":"/developer-updates-1101","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"For each received text change event, we check if it is adjacent to the previous one. If yes, it belongs to the same edit step; otherwise, if it happens in a different part of the file, we consider it as a new edit step.\nSo continuing our example from earlier, if the user happens to add a validateEmail function next, we now have two edit steps in tracking."},"2606":{"id":"/developer-updates-1102","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"The first edit step:"},"2607":{"id":"/developer-updates-1103","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"The second edit step:"},"2608":{"id":"/developer-updates-1104","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-group-events-into-meaningful-steps","content":"NES receives these steps wrapped inside <|edit_history|> token to learn how the code is evolving."},"2609":{"id":"/developer-updates-1105","page_id":"/developer-updates","type":"text","url":"/developer-updates#special-case-git-checkout-noise","content":"One edge case we uncovered is when users run git checkout to switch branches. This triggers massive file changes, none of which represent real user intent. If we were to treat these as edit steps, the model would end up thinking the user rewrote half the codebase. In order to avoid polluting the model direction, we:"},"2610":{"id":"/developer-updates-1106","page_id":"/developer-updates","type":"text","url":"/developer-updates#special-case-git-checkout-noise","content":"Monitor the git status"},"2611":{"id":"/developer-updates-1107","page_id":"/developer-updates","type":"text","url":"/developer-updates#special-case-git-checkout-noise","content":"Reset edit history when it changes (checkout, pull, stash)"},"2612":{"id":"/developer-updates-1108","page_id":"/developer-updates","type":"text","url":"/developer-updates#special-case-git-checkout-noise","content":"Resume tracking after a few seconds"},"2613":{"id":"/developer-updates-1109","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"Code rarely exists in isolation. If you’re editing a function call, the model may need the definition. Likewise, if you’re modifying a type, the model may need the type declaration."},"2614":{"id":"/developer-updates-1110","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"To give NES this kind of project-aware understanding, we pull additional snippets using the user’s installed language server. For this, we have two VS Code / LSP APIs:"},"2615":{"id":"/developer-updates-1111","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"We use vscode.provideDocumentRangeSemanticTokens to scan the editable region for each token type. Then we can find the tokens of interest, like a function, interface, or type defined in another file."},"2616":{"id":"/developer-updates-1112","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"Next, we use the VS Code command vscode.executeDefinitionProvider to get the target location for the definition code snippets. This is like Ctrl / Cmd + clicking on a function to see the definition in another file."},"2617":{"id":"/developer-updates-1113","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"These two commands are provided by the language server (LSP), which should be available when the language plugin is installed in VS Code. We then extract the definition snippet and include it in <|additional_context|> token as shown below:"},"2618":{"id":"/developer-updates-1114","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"This gives the model the same context a developer would mentally reference before typing the next edit."},"2619":{"id":"/developer-updates-1115","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"Note: We do realise that some of the functions could be huge or a type might be hundreds of lines, with LSP sometimes returning entire class bodies. Therefore, to throttle/limit semantic snippet extraction, we’ve currently hard-coded a maximum of 2000 characters per snippet for now."},"2620":{"id":"/developer-updates-1116","page_id":"/developer-updates","type":"text","url":"/developer-updates#3-additional-context-bringing-in-the-rest-of-your-project","content":"Meanwhile, in cases where good LSP support is lacking, like plain text, we don’t add any related snippets context to the prompt. Instead, the prompt will still contain the prefix, suffix, and edit records."},"2621":{"id":"/developer-updates-1117","page_id":"/developer-updates","type":"text","url":"/developer-updates#putting-it-all-together","content":"As learned above, every NES request contains the <|editable_region|>, <|edit_history|> and <|additional_context|> tokens."},"2622":{"id":"/developer-updates-1118","page_id":"/developer-updates","type":"text","url":"/developer-updates#putting-it-all-together","content":"At the end, each piece is carefully constructed into the model exactly the way it was trained. This symmetry between training and runtime makes NES far more reliable than native autocomplete-style approaches."},"2623":{"id":"/developer-updates-1119","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next-1","content":"In our next post, we’ll talk about Request Management, the system that ensures the model never gets a chance to be wrong about the user’s current context."},"2624":{"id":"/developer-updates-1120","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next-1","content":"We all understand real coding experience involves a lot of short, focused typing, moving the cursor to different places, and continuing to edit while a request is still in flight. This means the model requests can become outdated before their response arrives, or worse,  it might produce suggestions for code that no longer exists."},"2625":{"id":"/developer-updates-1121","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next-1","content":"One of the reasons NES feels fast is because everything that isn’t the latest user intent is thrown away immediately. This cancellation of stale predictions is one of the biggest reasons Pochi’s NES feels so smooth and accurate."},"2626":{"id":"/developer-updates-1122","page_id":"/developer-updates","type":"text","url":"/developer-updates#whats-next-1","content":"More on this in our Part 3 post. Read more."},"2627":{"id":"/developer-updates-1123","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-28","content":"This release brings some of our most practical updates yet: GitHub PR creation directly from worktrees, the ability to fork tasks when an agent drifts, clean task resets when context gets too large, and UI improvements that make multi-worktree setups far easier to manage."},"2628":{"id":"/developer-updates-1124","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-28","content":"A small step closer to a more transparent, predictable coding agent."},"2629":{"id":"/developer-updates-1125","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"GitHub PR Workflow: Pochi now understands Pull Requests per worktree. You can create PRs directly from the sidebar, and each worktree shows its associated PR, status (checks running, ready to merge, failed), and a breakdown of CI/Lint/Test results with quick links. PR state persists across sessions and stays linked to your worktree. #747"},"2630":{"id":"/developer-updates-1126","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Your browser does not support the video tag."},"2631":{"id":"/developer-updates-1127","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Fork a task: You can now fork any task when things go off-track. If an agent drifts, a tool call fails, or you want to try a different direction, hit Fork to spin up a new task starting from the same point in the conversation. The original stays untouched."},"2632":{"id":"/developer-updates-1128","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Your browser does not support the video tag."},"2633":{"id":"/developer-updates-1129","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"This makes it much easier to debug issues, try alternative fixes, or compare multiple approaches side-by-side. One great use case would be to provide corrective feedback and guide the agent back on track without resetting the whole task. #455"},"2634":{"id":"/developer-updates-1130","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Create a New Task with Previous Context: When a task grows beyond ~50k tokens, Pochi now suggests New Task with Summary option. This creates a clean task with a summary of the previous conversation, helping you avoid hitting context limits while keeping all relevant information. #779"},"2635":{"id":"/developer-updates-1131","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Your browser does not support the video tag."},"2636":{"id":"/developer-updates-1132","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Auto Layout: We added a new “Pochi Layout” toggle that instantly arranges your VS Code workspace into an optimized 3-pane layout: the Pochi task view on the left, code/diffs on the upper right, and terminals in a separate bottom-right tab group. This keeps terminal output isolated, prevents accidental layout shifts, and makes long-running tasks much easier to follow. #733"},"2637":{"id":"/developer-updates-1133","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-20","content":"Your browser does not support the video tag."},"2638":{"id":"/developer-updates-1134","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-20","content":"Incremental Task IDs: Tasks now receive a simple incremental ID (#001, #002, …) that is shared across all worktrees within the same Git repository. This makes tasks easier to reference while still preserving grouping by worktree in the UI. #746"},"2639":{"id":"/developer-updates-1135","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-20","content":"Optimistic Worktree Deletion: Deleting a worktree now updates instantly in the UI, making the worktree disappears immediately without waiting for the backend to confirm. This makes task management feel faster and keeps the sidebar in sync with your intent."},"2640":{"id":"/developer-updates-1136","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-20","content":"Your browser does not support the video tag."},"2641":{"id":"/developer-updates-1137","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-10","content":"We’re working on multi-worktree task execution (run tasks in parallel across branches or models) and GitHub/Linear issue linking that lets Pochi automatically attach, track, and close issues as part of your workflow."},"2642":{"id":"/developer-updates-1138","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-29","content":"This weeks update is packed with improvements to task visibility, worktree workflows, and NES accuracy. We also made foundational changes to how tasks are stored, which sets us up for upcoming GitHub and multi-worktree features."},"2643":{"id":"/developer-updates-1139","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-29","content":"type: info"},"2644":{"id":"/developer-updates-1140","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-29","content":"title: Breaking Change: Task list reset in v0.16.0"},"2645":{"id":"/developer-updates-1141","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-29","content":"We introduced a breaking change in v0.16.0 that may result in the loss of the task list after upgrading. No action is needed as new tasks will behave normally going forward."},"2646":{"id":"/developer-updates-1142","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-21","content":"Diff Summary Panel for Task Changes: We added a diff summary panel inside each task, showing all file edits made during execution. You can now review per-file additions/deletions, inspect the total change summary, and undo changes directly from the panel itself. #728"},"2647":{"id":"/developer-updates-1143","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-21","content":"Your browser does not support the video tag."},"2648":{"id":"/developer-updates-1144","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Improved Visibility into Task Execution: Tasks now display real-time execution details, including active tool calls, subtasks, and streaming progress to make task behavior easier to understand at a glance. This brings much clearer visibility into what Pochi is doing while a task runs. #675"},"2649":{"id":"/developer-updates-1145","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Your browser does not support the video tag."},"2650":{"id":"/developer-updates-1146","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Tasks grouped by worktree: Pochi automatically groups tasks by their associated Git worktree with active worktrees at the top and deleted worktrees collapsed into a dedicated section. Each worktree shows its own tasks, status, and metadata which makes it much easier to manage parallel workstreams and multiple agents. #676"},"2651":{"id":"/developer-updates-1147","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Diff Summary on Task List Item: Task rows now display git diff summaries (e.g. +23 -5) so you can instantly see the size and impact of each task’s changes across multiple worktrees. #674"},"2652":{"id":"/developer-updates-1148","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Worktree-aware task tabs: Pochi now opens tasks from the same Git worktree in the same VS Code tab group, and tasks from different worktrees in separate tab groups. This keeps parallel branches visually separated while you work. #677"},"2653":{"id":"/developer-updates-1149","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Your browser does not support the video tag."},"2654":{"id":"/developer-updates-1150","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Unread Task Indicators: We added unread indicators to the task list so you never miss when a background task finishes or fails. Tasks that complete while you’re looking elsewhere now show a small dot until you open them, making it much easier to track updates. #673"},"2655":{"id":"/developer-updates-1151","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Your browser does not support the video tag."},"2656":{"id":"/developer-updates-1152","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-21","content":"Enhanced NES prompting with additional local code context: NES now includes richer local code context in its prompt, improving accuracy for predictions that depend on nearby functions, variables, or imports. #727"},"2657":{"id":"/developer-updates-1153","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-11","content":"We’re actively working on GitHub PR creation and status, multi-worktree task execution, and GitHub/Linear issue linking - all designed to make Pochi even more powerful for real engineering workflows."},"2658":{"id":"/developer-updates-1154","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-30","content":"This week was a big one."},"2659":{"id":"/developer-updates-1155","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-30","content":"We shipped Next Edit Suggestions (one of our biggest upgrades so far), along with real-time task notifications and cleaner diff views. Pochi now feels smarter, tighter, and much more intuitive across the codebase."},"2660":{"id":"/developer-updates-1156","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-22","content":"Next Edit Suggestions (NES): We’ve introduced our internal edit model powering Next Edit Suggestion (NES). It is an upgrade to Tab Completion that predicts the next change your code needs, wherever it lives. It learns from your recent edits, understands how your file is evolving, and auto-surfaces likely follow-up edits.  We’ve published a deep-dive on how we trained and evaluated the edit model, and how it powers Pochi's experience. You can read more here."},"2661":{"id":"/developer-updates-1157","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-22","content":"Pop-up Notifications for Task Status Changes: Pochi now shows real-time notifications when a task completes, fails, or needs your input. Each notification includes a “View Details” button that jumps directly into the task. In the case the task panel is already open, we suppress duplicable notifications to reduce noise."},"2662":{"id":"/developer-updates-1158","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-22","content":"Your browser does not support the video tag."},"2663":{"id":"/developer-updates-1159","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-22","content":"Gemini 3 Support: We’ve added support for Gemini 3 Pro alongside 2.5 Pro. The UI for model selection is updated and ready for you to take over!"},"2664":{"id":"/developer-updates-1160","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-22","content":"Line Wrap Toggle in Code Blocks: We added a line wrap toggle to the code block component in the VS Code extension. This way, long lines inside diffs and model edits are now way easier to read, especially when reviewing wide changes across generated code."},"2665":{"id":"/developer-updates-1161","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-22","content":"Your browser does not support the video tag."},"2666":{"id":"/developer-updates-1162","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-12","content":"We’re actively working on a set of UX upgrades for the VS Code sidebar - things like grouping tasks by worktree, cleaner task headers, and a diff-summary panel that shows all file edits at a glance. More on this in an upcoming update."},"2667":{"id":"/developer-updates-1163","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"title: Note"},"2668":{"id":"/developer-updates-1164","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"This is a four-part series on how we trained and built our NES model at Pochi, covering everything from the edit model behind tab completion to real-time context management, request lifecycles, and dynamic rendering for AI code edits."},"2669":{"id":"/developer-updates-1165","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"Read the full series:"},"2670":{"id":"/developer-updates-1166","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"– Part 1: The Edit Model Behind Tab Completion"},"2671":{"id":"/developer-updates-1167","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"– Part 2: Real-Time Context Management in Your Code Editor"},"2672":{"id":"/developer-updates-1168","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"– Part 3: The Request Management Lifecycle Under Continuous Typing"},"2673":{"id":"/developer-updates-1169","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"– Part 4: Dynamic Rendering Strategies for AI Code Edits"},"2674":{"id":"/developer-updates-1170","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"In this post, we’re introducing our internal edit model, the foundation behind Next Edit Suggestion (NES). It’s an upgrade to Tab completion, designed to predict the next change your code needs, wherever it lives."},"2675":{"id":"/developer-updates-1171","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"Technically this is much harder to achieve, since NES considers the entire file plus your recent edit history and predicts how your code is likely to evolve: where the next change should happen, and what that change should be."},"2676":{"id":"/developer-updates-1172","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"Other editors have explored versions of next-edit prediction, but models have evolved a lot, and so has our understanding of how people actually write code."},"2677":{"id":"/developer-updates-1173","page_id":"/developer-updates","type":"text","url":"/developer-updates#nes-series-part-1-the-edit-model-behind-tab-completion-1","content":"As an open-source team, we want to share this work transparently. This is the first post in our \"Next Edit Suggestion\" series, where we walk you through how we trained the underlying model to how it powers real-time editing inside the extension."},"2678":{"id":"/developer-updates-1174","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-train-the-edit-model","content":"When we decided to build NES, one of the first pressing questions on our mind was: What kind of data actually teaches a model to make good edits?"},"2679":{"id":"/developer-updates-1175","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-train-the-edit-model","content":"It turned out that real developer intent is surprisingly hard to capture. As anyone who’s peeked at real commits knows, developer edits are messy. Pull requests bundle unrelated changes, commit histories jump around, and the sequences of edits often skip the small, incremental steps engineers actually take when exploring or fixing code."},"2680":{"id":"/developer-updates-1176","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"To train an edit model, we format each example using special edit tokens. These tokens tell the model:"},"2681":{"id":"/developer-updates-1177","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"What part of the file is editable"},"2682":{"id":"/developer-updates-1178","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"The user’s cursor position"},"2683":{"id":"/developer-updates-1179","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"What the user has edited so far"},"2684":{"id":"/developer-updates-1180","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"What the next edit should be inside that region only"},"2685":{"id":"/developer-updates-1181","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"Unlike chat-style models that generate free-form text, NES is trained to predict the next code edit inside the editable region."},"2686":{"id":"/developer-updates-1182","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"Below is an example of how NES predicts the next edit:"},"2687":{"id":"/developer-updates-1183","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"In the image above, the developer makes the first edit allowing the model to capture the intent of the user. The editable_region markers define everything between them as the editable zone. The user_cursor_is_here token shows the model where the user is currently editing."},"2688":{"id":"/developer-updates-1184","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"NES infers the transformation pattern (capitalization in this case) and applies it consistently as the next edit sequence."},"2689":{"id":"/developer-updates-1185","page_id":"/developer-updates","type":"text","url":"/developer-updates#the-training-process","content":"To support this training format, we used CommitPackFT and Zeta as data sources. We normalized this unified dataset into the same Zeta-derived edit-markup format as described above and applied filtering to remove non-sequential edits using a small in-context model (GPT-4.1 mini)."},"2690":{"id":"/developer-updates-1186","page_id":"/developer-updates","type":"text","url":"/developer-updates#choosing-the-base-model-for-nes","content":"With the training format and dataset finalized, the next major decision was choosing what base model to fine-tune. Initially, we considered both open-source and managed models, but ultimately chose Gemini 2.5 Flash Lite for two main reasons:"},"2691":{"id":"/developer-updates-1187","page_id":"/developer-updates","type":"text","url":"/developer-updates#choosing-the-base-model-for-nes","content":"Easy serving: Running an OSS model would require us to manage its inference and scalability in production. For a feature as latency-sensitive as Next Edit, these operational pieces matter as much as the model weights themselves. Using a managed model helped us avoid all these operational overheads."},"2692":{"id":"/developer-updates-1188","page_id":"/developer-updates","type":"text","url":"/developer-updates#choosing-the-base-model-for-nes","content":"Simple supervised-fine-tuning: We fine-tuned NES using Google’s Gemini Supervised Fine-Tuning (SFT) API, with no training loop to maintain, no GPU provisioning, and at the same price as the regular Gemini inference API. Under the hood, Flash Lite uses LoRA (Low-Rank Adaptation), which means we update only a small set of parameters rather than the full model. This keeps NES lightweight and preserves the base model’s broader coding ability."},"2693":{"id":"/developer-updates-1189","page_id":"/developer-updates","type":"text","url":"/developer-updates#choosing-the-base-model-for-nes","content":"Overall, in practice, using Flash Lite gave us model quality comparable to strong open-source baselines, with the obvious advantage of far lower operational costs. We can  , keeping the model stable across versions."},"2694":{"id":"/developer-updates-1190","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-this-matters-for-you","content":"Using Flash Lite directly improves the user experience in the editor. As a user, you can expect faster responses and likely lower compute cost (which can translate into cheaper product)."},"2695":{"id":"/developer-updates-1191","page_id":"/developer-updates","type":"text","url":"/developer-updates#why-this-matters-for-you","content":"And since fine-tuning is lightweight, we can roll out frequent improvements, providing a more robust service with less risk of downtime, scaling issues, or version drift; meaning greater reliability for everyone."},"2696":{"id":"/developer-updates-1192","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-evaluated-the-model","content":"We evaluated our edit model using a single metric: LLM-as-a-Judge, powered by Gemini 2.5 Pro. This judge model evaluates whether a predicted edit is semantically correct, logically consistent with recent edits, and appropriate for the given context. This is unlike token-level comparisons and makes it far closer to how a human engineer would judge an edit."},"2697":{"id":"/developer-updates-1193","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-we-evaluated-the-model","content":"In practice, this gave us an evaluation process that is scalable, automated, and far more sensitive to intent than simple string matching. It allowed us to run large evaluation suites continuously as we retrain and improve the model."},"2698":{"id":"/developer-updates-1194","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"Training and evaluation only define what the model knows in theory. To make Next Edit Suggestions feel alive inside the editor, the model needs to understand what you are doing right now. So at inference time, we give the model more than just the current file snapshot. We also send:"},"2699":{"id":"/developer-updates-1195","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"Your recent edit history\nWrapped in <|edit_history|>, this gives the model a short story of your current flow: what changed, in what order, and what direction the code seems to be moving."},"2700":{"id":"/developer-updates-1196","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"Additional semantic context\nAdded via <|additional_context|>, this might include type signatures, documentation, or relevant parts of the broader codebase. It’s the kind of stuff you would mentally reference before making the next edit."},"2701":{"id":"/developer-updates-1197","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"Here’s a small example image showing the full inference-time context with the edit history, additional context, and the live editable region which the NES model receives:"},"2702":{"id":"/developer-updates-1198","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"NES combines these inputs to infer the user’s intent from earlier edits and predict the next edit inside the editable region only."},"2703":{"id":"/developer-updates-1199","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancing-context-at-inference","content":"In this post, we’ve focused on how the model is trained and evaluated. In the next post, we’ll go deeper into how these dynamic contexts are constructed, ranked, and streamed into the model to drive real-time, context-aware edit predictions."},"2704":{"id":"/developer-updates-1200","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-31","content":"We added modular @import rules and fixed PDF handling in readFile. Behind the scenes, we’re preparing two big improvements: smart task notifications and a refreshed, faster tab-completion experience."},"2705":{"id":"/developer-updates-1201","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-23","content":"Modular Rules with @import Syntax: You can now split and organize large rule files by importing other markdown files using the @ prefix (e.g. @./rules/api-guidelines.md). Pochi will stitch them together, managing complex configurations for your multi-agent or multi-project setups. #540"},"2706":{"id":"/developer-updates-1202","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-23","content":"Your browser does not support the video tag."},"2707":{"id":"/developer-updates-1203","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-19","content":"PDF Handling in readFile: Resolved a bug that caused readFile to return PDF files as plain text. #591"},"2708":{"id":"/developer-updates-1204","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-13","content":"Smart Task Notifications: Pochi will now show real-time notifications when a task needs your input, completes, or fails. Notifications will include a “View Details” button to jump directly into the task, and will be automatically suppressed when the task panel is already open to avoid duplicates."},"2709":{"id":"/developer-updates-1205","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-13","content":"Your browser does not support the video tag."},"2710":{"id":"/developer-updates-1206","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-13","content":"We’re also preparing an upgrade to our tab completion system to make suggestions feel faster and more intuitive. More details coming soon!"},"2711":{"id":"/developer-updates-1207","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"Teams rarely work on a single task at a time. You might be part-way through a feature when a bug report arrives, someone needs a small refactor reviewed, or a documentation fix is pending. Most tools and workflows force these tasks to share one working state."},"2712":{"id":"/developer-updates-1208","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"So you end up switching branches, stashing and popping changes, resetting your workspace, and trying to hold the original task in your head. This is context switching, and it’s one of the biggest hidden costs in software development."},"2713":{"id":"/developer-updates-1209","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"We released Parallel Agents to remove that cost. Each agent runs in its own Git worktree, which isolates the task’s state from the rest of your work."},"2714":{"id":"/developer-updates-1210","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"A great example would be to run the same task with different models to pick the best response. Won’t that be a faster and much better experience - all within the same timeframe?"},"2715":{"id":"/developer-updates-1211","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"This is different from other existing solutions, which operate inside a single editor tab. In those tools, you’re effectively working in one tab at a time: switching tasks means switching the state of the same working directory and the same conversation."},"2716":{"id":"/developer-updates-1212","page_id":"/developer-updates","type":"text","url":"/developer-updates#launching-parallel-agents-1","content":"On the other hand, Parallel Agents in Pochi keep tasks fully isolated by running each one in its own Git worktree. You can keep multiple tasks active at once and switch between them without stashing or losing context."},"2717":{"id":"/developer-updates-1213","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-use","content":"You can create a worktree from the Pochi sidebar. Once a worktree exists, starting a task in that worktree opens it as its own tab in Pochi."},"2718":{"id":"/developer-updates-1214","page_id":"/developer-updates","type":"text","url":"/developer-updates#how-to-use","content":"When a task finishes, use the diff view to review its changes. If it looks good, create a PR from that worktree."},"2719":{"id":"/developer-updates-1215","page_id":"/developer-updates","type":"text","url":"/developer-updates#when-to-use-parallel-agents","content":"Parallel Agents are most useful when you want to avoid breaking focus on ongoing work: quick bugfixes during feature development, long-running refactors that you want to keep separate, documentation changes that happen alongside coding, or letting an AI assistant explore broader changes in a sandbox."},"2720":{"id":"/developer-updates-1216","page_id":"/developer-updates","type":"text","url":"/developer-updates#when-to-use-parallel-agents","content":"On the other hand, if a change is meant to be reviewed and merged as a single unit, keeping it on one branch remains simpler."},"2721":{"id":"/developer-updates-1217","page_id":"/developer-updates","type":"text","url":"/developer-updates#when-to-use-parallel-agents","content":"Here is the demo showing the feature in action:"},"2722":{"id":"/developer-updates-1218","page_id":"/developer-updates","type":"text","url":"/developer-updates#when-to-use-parallel-agents","content":"Your browser does not support the video tag."},"2723":{"id":"/developer-updates-1219","page_id":"/developer-updates","type":"text","url":"/developer-updates#when-to-use-parallel-agents","content":"Read the full documentation here."},"2724":{"id":"/developer-updates-1220","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-32","content":"Custom Agent gets even better ⚡ + i18n upgrades for global users 🌏! And major Chat Sidebar UX upgrades are coming soon! 🚀"},"2725":{"id":"/developer-updates-1221","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-23","content":"Custom Agent with Slash Section: You can now invoke custom agents directly through slash commands in the VS Code chat sidebar — just like how you trigger workflows. #567"},"2726":{"id":"/developer-updates-1222","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-23","content":"This change unifies how agents and workflows are invoked, creating a more intuitive and consistent experience for interacting with Pochi’s capabilities."},"2727":{"id":"/developer-updates-1223","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-23","content":"Your browser does not support the video tag."},"2728":{"id":"/developer-updates-1224","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-23","content":"Chat UI i18n: We are bringing full internationalization to the chat UI!✨ Hardcoded strings are being replaced with our i18n system (powered by i18next), paving the way for a localized experience in English, Chinese, Japanese, and Korean. #201"},"2729":{"id":"/developer-updates-1225","page_id":"/developer-updates","type":"text","url":"/developer-updates#-preview-14","content":"We’re actively working on a series of UX improvements to the VS Code chat sidebar, aimed at making Pochi more seamless and intuitive to use.\nStay tuned for the upcoming update!"},"2730":{"id":"/developer-updates-1226","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-33","content":"We’ve given Pochi new tricks."},"2731":{"id":"/developer-updates-1227","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-33","content":"Workflows can now execute Bash commands, readFile tool handles multimedia inputs, and markdown rendering is faster and cleaner with streamdown.ai."},"2732":{"id":"/developer-updates-1228","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-33","content":"Let’s get on with it!"},"2733":{"id":"/developer-updates-1229","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-24","content":"Bash Commands in Workflows You can now execute Bash commands directly inside Pochi workflows using the ! prefix. This allows workflows to pull live system or repository context, like git status or uname -a, and feed the results into the model before running your task. \nFor example:"},"2734":{"id":"/developer-updates-1230","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-24","content":"Pochi automatically runs these commands and includes their outputs in the model’s context, making workflows more dynamic and connected to your local environment. #541"},"2735":{"id":"/developer-updates-1231","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-24","content":"Faster Markdown Rendering with streamdown.ai:  We’ve replaced react-markdown with streamdown.ai in the VS Code web UI. This upgrade improves performance, adds streaming-based markdown rendering, and ensures better support for rich content (like math, code blocks, and workflows). #401"},"2736":{"id":"/developer-updates-1232","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-24","content":"Extended Multimedia Support in readFile Tool:  The readFile tool now supports reading multimedia files, including images, audio, and video, for multimodal models. Pochi automatically detects file types and encodes the content in base64 for models that can interpret visual and auditory data. #539, #569"},"2737":{"id":"/developer-updates-1233","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-24","content":"Your browser does not support the video tag."},"2738":{"id":"/developer-updates-1234","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-24","content":"Added Linux ARM64 Release: Pochi is now available for Linux ARM64 systems, improving compatibility for developers running on Raspberry Pi or ARM-based environments. #543"},"2739":{"id":"/developer-updates-1235","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-34","content":"This week, we focused on making Pochi more capable for builders who live in the terminal. We extended image-prompt support to the CLI, added global workflows for shared automations, and made the command-line experience smoother with shell autocompletion."},"2740":{"id":"/developer-updates-1236","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-34","content":"We’ve also shipped .pochiignore support and small but delightful touches like copying images directly from the extension chat."},"2741":{"id":"/developer-updates-1237","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-25","content":"CLI Autocompletion: The Pochi CLI now supports shell autocompletion for bash, zsh, and fish. Improve your flow as you discover commands, subcommands and options while typing, without the need to stop and check docs mid-flow. #307"},"2742":{"id":"/developer-updates-1238","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-25","content":"Your browser does not support the video tag."},"2743":{"id":"/developer-updates-1239","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-25","content":"Global Workflows: You can now store workflows globally in ~/.pochi/workflows, and Pochi will load them across all workspaces. Easily share automations, setups, or linting rules, while allowing your team to maintain consistent review or deployment routines.#123, #517"},"2744":{"id":"/developer-updates-1240","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-25","content":"Image Prompts in CLI: You can pass images directly to Pochi from the CLI, be it a diagram, a UI screenshot, or a flow chart. Models interpret and respond to your visuals, explaining issues, parsing charts and generating code based on UI mockups. #513"},"2745":{"id":"/developer-updates-1241","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-25","content":".pochiignore Support: You can now use .pochiignore (just like .gitignore) to exclude files and directories from Pochi’s context, keeping your large repositories lean and your prompts focused on the task at hand. #515 , #516"},"2746":{"id":"/developer-updates-1242","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-25","content":"Copy Images from MCP and Attachments: You can now right-click any image generated by MCP tools or shared in chat to copy it to your clipboard or open it in an editor tab. A small addition, but a big win for anyone working with visual data or model-generated diagrams. #500"},"2747":{"id":"/developer-updates-1243","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-25","content":"Your browser does not support the video tag."},"2748":{"id":"/developer-updates-1244","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-20","content":"Command Queue Stability: Fixed race conditions between queued and other requests (particularly during preview operations) to improve execution consistency and error handling. #528"},"2749":{"id":"/developer-updates-1245","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-35","content":"Q4 is here, and Pochi’s cooking. 🍳"},"2750":{"id":"/developer-updates-1246","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-35","content":"We’ve rolled out new built-in tools (webFetch and webSearch) that extend Pochi’s server-side capabilities, added support for new AI vendors (Codex and Qwen Coder), and released a new tutorial that shows how Pochi can act as your AI teammate in GitHub Actions."},"2751":{"id":"/developer-updates-1247","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-35","content":"Let’s start! 🧡"},"2752":{"id":"/developer-updates-1248","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-26","content":"Built-in Tools: Pochi now supports server-side tools, allowing it to register and expose capabilities that come bundled directly with the app. The first two built-in tools introduced are webFetch and webSearch. These let AI agents fetch, read, and process web content directly. #447"},"2753":{"id":"/developer-updates-1249","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-26","content":"Your browser does not support the video tag."},"2754":{"id":"/developer-updates-1250","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-26","content":"New AI Vendor Support: Pochi  now supports Qwen Coder and Codex, adding new model vendors alongside Claude, Gemini, and Copilot. We've also introduced native compatibility with Anthropic’s API format, enabling faster and more stable integration with Claude models. #52, #304, #302"},"2755":{"id":"/developer-updates-1251","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-26","content":"Model-Aware Workflows: You can now define which model a workflow should use directly in its configuration. This gives you more control over which LLM handles each automation, especially useful if your team switches between providers like Claude, Gemini, or Codex. #343"},"2756":{"id":"/developer-updates-1252","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-21","content":"Assistant Retry Logic: Fixed an issue where assistant messages without tool calls were treated as new steps instead of retries, causing the retry count logic to behave incorrectly. #342"},"2757":{"id":"/developer-updates-1253","page_id":"/developer-updates","type":"text","url":"/developer-updates#-bug-fixes-21","content":"Diff View in VS Code: Files open before a diff operation are now reopened after accepting or rejecting changes, preserving your workspace layout. #440"},"2758":{"id":"/developer-updates-1254","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-5","content":"We’ve published a new tutorial: Build Your Own AI Teammate with Pochi in GitHub Actions. Learn how Pochi can review and gatekeep PRs, enforce coding standards, open issues, and even run as a continuous background agent."},"2759":{"id":"/developer-updates-1255","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-36","content":"This release introduces a manual sub-task execution mode for more control over sensitive workflows. We’ve also added MCP support in the CLI, enabled GitHub Copilot and Claude Pro/Max authentication, and shipped new tutorials and key security and stability improvements. 🙌"},"2760":{"id":"/developer-updates-1256","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"Manual Execution Mode for Sub-Tasks: Sub-tasks created with newTask can now be run in a manual, step-by-step mode avoiding large unmoderated changes to your codebases in your sensitive workflows. #300"},"2761":{"id":"/developer-updates-1257","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"Your browser does not support the video tag."},"2762":{"id":"/developer-updates-1258","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"MCP support in CLI: The CLI now supports running your Model Context Protocol (MCP) servers, allowing you to connect your tools, and run MCP-powered workflows directly from the terminal. This update brings the CLI closer to parity with the VS Code extension. #100"},"2763":{"id":"/developer-updates-1259","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"Your browser does not support the video tag."},"2764":{"id":"/developer-updates-1260","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"AI Tooling Integrations (GitHub Copilot + Claude): You can now authenticate and use your GitHub Copilot and existing Claude Pro/Max subscriptions within Pochi across both the CLI and VS Code. Once authenticated, these services provide completions and suggestions directly in your workflows, enhancing the overall AI-assisted development experience. #184 , #61, #306"},"2765":{"id":"/developer-updates-1261","page_id":"/developer-updates","type":"text","url":"/developer-updates#-features-27","content":"Improved VS Code Configuration Navigation: VS Code commands like Pochi: Open MCP Server Settings now open the relevant config file and jump directly to the specific setting, #301"},"2766":{"id":"/developer-updates-1262","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-27","content":"Enhanced Gemini Model Support: We've improved existing image input capabilities with added PDF and video inputs, providing richer multimodal workflows with Gemini models. #219"},"2767":{"id":"/developer-updates-1263","page_id":"/developer-updates","type":"text","url":"/developer-updates#-enhancements-27","content":"Malformed Custom Agents in VSCode Settings: Previously ignored malformed agent files (e.g., with YAML parsing errors) are now displayed in the settings UI with a clear warning, making it easier to debug and fix broken custom agent configurations. #391, #415"},"2768":{"id":"/developer-updates-1264","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-6","content":"Connect Pochi to Your Self-Hosted Tabby Server"},"2769":{"id":"/developer-updates-1265","page_id":"/developer-updates","type":"text","url":"/developer-updates#-resources-6","content":"Build a Custom MCP Server to Query Supabase"},"2770":{"id":"/developer-updates-1266","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-37","content":"We are excited to introduce Queued Messages — type prompts in advance and stop waiting for Pochi to finish a task! We also launched a new Tutorials section with guides on voice-driven development and Mermaid graphs. Have tips or insights? Contribute your own via PRs! Plus, Pochi now supports more file types, and the CLI is friendlier and more interactive. ✨"},"2771":{"id":"/developer-updates-1267","page_id":"/developer-updates","type":"text","url":"/developer-updates#features-","content":"Queued Messages: Don't wait around — ⌘/Ctrl + ↵ to line up your next prompt when Pochi is busy. #286"},"2772":{"id":"/developer-updates-1268","page_id":"/developer-updates","type":"text","url":"/developer-updates#features-","content":"Tutorials: A new documentation hub to help you get more out of Pochi. This week: voice-driven dev with Hex, and Mermaid graph communication."},"2773":{"id":"/developer-updates-1269","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements-","content":"Multimedia file support: Share not just images, but also PDFs and videos with Pochi. #271"},"2774":{"id":"/developer-updates-1270","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements-","content":"Claude Code login: The CLI now supports authentication with Claude Code. #282"},"2775":{"id":"/developer-updates-1271","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements-","content":"Friendlier CLI experience: Interactively pick auth vendors and navigate through tasks, get clearer help/error messages, and see upgrade notices on startup. #287, #294, #308, #329, #357"},"2776":{"id":"/developer-updates-1272","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements-","content":"Docs updates: Added documentation for queued messages and tab completion model settings and improved VS Code docs. #317, #321, #365"},"2777":{"id":"/developer-updates-1273","page_id":"/developer-updates","type":"text","url":"/developer-updates#bug-fixes-","content":"VS Code UX tweaks: Unified drag-and-drop overlays with the prompt editor, fixed tooltip arrows, and ensured model selections are preserved with clear alerts when a model is unavailable. #350, #316, #373"},"2778":{"id":"/developer-updates-1274","page_id":"/developer-updates","type":"text","url":"/developer-updates#new-contributors-","content":"A belated shout-out to @DESU-CLUB for their first contribution last week — and another one this week! 🥳"},"2779":{"id":"/developer-updates-1275","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-38","content":"This week we brought custom agents to life!🐣 Pochi CLI is on npm, newTask makes it simple to create and manage tasks right from the terminal, and Mermaid diagrams render beautifully inside the app. MCP interactions are smarter too, and the docs and UI keep getting smoother with every update. ✨"},"2780":{"id":"/developer-updates-1276","page_id":"/developer-updates","type":"text","url":"/developer-updates#features--1","content":"Custom Agents: Define your own assistants in .pochi/agents using markdown. #176, #181"},"2781":{"id":"/developer-updates-1277","page_id":"/developer-updates","type":"text","url":"/developer-updates#features--1","content":"newTask in CLI: Spin up tasks directly from the terminal, each with its dedicated agent. #232"},"2782":{"id":"/developer-updates-1278","page_id":"/developer-updates","type":"text","url":"/developer-updates#features--1","content":"Mermaid diagrams: Drop Mermaid code blocks into Pochi and see them rendered as nice diagrams. #255"},"2783":{"id":"/developer-updates-1279","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"Pochi CLI on npm 📦: npm install -g pochi and get it running! #238"},"2784":{"id":"/developer-updates-1280","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"Custom models for completion: Use your own models for code completion in VS Code. #251"},"2785":{"id":"/developer-updates-1281","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"MCP instructions: MCP servers can now guide models on tool usage, enabling more complex interactions. #254"},"2786":{"id":"/developer-updates-1282","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"Token auth: Log in with a token when browser auth doesn't work. #235, #236"},"2787":{"id":"/developer-updates-1283","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"Diff view focus mode: Pochi automatically closes a file's regular editor tab when opening its diff view. #197"},"2788":{"id":"/developer-updates-1284","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"More CLI commands: pochi mcp list to inspect configured MCP servers, and pochi task list to check task lists. #231, #266"},"2789":{"id":"/developer-updates-1285","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"VS Code UI polish: Autocomplete mention list is responsive and tabbable, workflow list is collapsible and better spaced. #215, #204, #230, #228, #242"},"2790":{"id":"/developer-updates-1286","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--1","content":"Docs updates: Added checkpoint feature and updated GitHub integration docs with API key setup. #203, #262"},"2791":{"id":"/developer-updates-1287","page_id":"/developer-updates","type":"text","url":"/developer-updates#bug-fixes--1","content":"Scoped replies: Pochi only responds when you start a comment with /pochi. #202"},"2792":{"id":"/developer-updates-1288","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-39","content":"We had a massive week — 62 PRs shipped 🎉!"},"2793":{"id":"/developer-updates-1289","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-39","content":"Pochi can now reply to you right in GitHub comments & issues, the interface speaks more languages with new i18n support, and we rolled out a sleeker, more powerful background job system. On top of that, the CLI got smarter, autocomplete got friendlier, and the docs got a glow-up!"},"2794":{"id":"/developer-updates-1290","page_id":"/developer-updates","type":"text","url":"/developer-updates#features--2","content":"GitHub Action integration: Pochi now lives in your PR comments / issues! Ask for help in a PR with /pochi. #76"},"2795":{"id":"/developer-updates-1291","page_id":"/developer-updates","type":"text","url":"/developer-updates#features--2","content":"Internationalization (i18n): The VS Code extension now supports 🇺🇸 🇨🇳 🇯🇵 🇰🇷. Want your language included? Open a PR! #90"},"2796":{"id":"/developer-updates-1292","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"CLI upgrades: The Pochi CLI got a big boost this week!"},"2797":{"id":"/developer-updates-1293","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Install via Homebrew 🍺 #125"},"2798":{"id":"/developer-updates-1294","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Authenticate with pochi auth, including support for Gemini login #167"},"2799":{"id":"/developer-updates-1295","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Trigger workflows directly with pochi -p \"/create-pr\" #110"},"2800":{"id":"/developer-updates-1296","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Enhanced Background jobs: Added terminal integration and lifecycle controls. Enhanced the job UI with collapsible detail logs and readable IDs for a clearer experience. #81, #97"},"2801":{"id":"/developer-updates-1297","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Autocomplete: Pochi suggests relevant tools, functions, and variables to help you type prompts faster. #89"},"2802":{"id":"/developer-updates-1298","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--2","content":"Documentation updates: Refreshed CLI usage docs, expanded model provider configuration examples, and added Slack integration documentation. #133, #141, #82"},"2803":{"id":"/developer-updates-1299","page_id":"/developer-updates","type":"text","url":"/developer-updates#bug-fixes--2","content":"File writing reliability: The CLI ensures directories exist before writing, so writeToFile tool won't fail. #118"},"2804":{"id":"/developer-updates-1300","page_id":"/developer-updates","type":"text","url":"/developer-updates#bug-fixes--2","content":"Code completion fix: Corrected how VS Code calculates the replacement range for suggestions, so completions insert correctly. #131"},"2805":{"id":"/developer-updates-1301","page_id":"/developer-updates","type":"text","url":"/developer-updates#new-contributors--1","content":"@karim-coder made their first contribution this week! Welcome aboard! 🎉"},"2806":{"id":"/developer-updates-1302","page_id":"/developer-updates","type":"text","url":"/developer-updates#tldr-40","content":"This week we polished the VS Code extension with some UX upgrades, open-sourced the Pochi CLI, and did a few rounds of codebase cleanup to make contributing easier and friendlier for newcomers. We look forward to your first visit to the repo!"},"2807":{"id":"/developer-updates-1303","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--3","content":"Drag & drop images: Share visuals with Pochi in the VS Code chat just by dragging them in. #64"},"2808":{"id":"/developer-updates-1304","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--3","content":"Improved docs: Updated structure and added guidance on model settings for easier use. #60, #63 , 900d162"},"2809":{"id":"/developer-updates-1305","page_id":"/developer-updates","type":"text","url":"/developer-updates#enhancements--3","content":"Model pricing at your fingertips: Check model costs directly in settings before choosing one. #74"},"2810":{"id":"/developer-updates-1306","page_id":"/developer-updates","type":"text","url":"/developer-updates#bug-fixes--3","content":"File search now correctly surfaces matching files: Queries that used to return empty results will now behave as expected. #79"},"2811":{"id":"/developer-updates/plan-like-you-code","page_id":"/developer-updates/plan-like-you-code","type":"page","content":"Plan like you code","url":"/developer-updates/plan-like-you-code"},"2812":{"id":"/developer-updates/plan-like-you-code-0","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code","content":"Plan, review, and align before executing code changes"},"2813":{"id":"/developer-updates/plan-like-you-code-1","page_id":"/developer-updates/plan-like-you-code","type":"heading","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Plan like you code"},"2814":{"id":"/developer-updates/plan-like-you-code-2","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Your browser does not support the video tag."},"2815":{"id":"/developer-updates/plan-like-you-code-3","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"We shipped Plan Mode in Pochi."},"2816":{"id":"/developer-updates/plan-like-you-code-4","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Planning by itself isn’t new. What’s interesting is what happens when planning plugs into a workflow that already supports inline comments, review edits, and task-based execution."},"2817":{"id":"/developer-updates/plan-like-you-code-5","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Create Plan is a feature we built, but its real value comes from how it composes with the rest of the system."},"2818":{"id":"/developer-updates/plan-like-you-code-6","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Instead of treating the plan as something you just read and approve, you can iterate on it the same way you’d review a diff - leave inline comments, refine specific steps, and then execute directly from that agreed version."},"2819":{"id":"/developer-updates/plan-like-you-code-7","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"The plan lives as a real workspace artifact (i.e. plan.md) and opens in the editor, so planning becomes part of the same collaboration loop as code."},"2820":{"id":"/developer-updates/plan-like-you-code-8","page_id":"/developer-updates/plan-like-you-code","type":"text","url":"/developer-updates/plan-like-you-code#plan-like-you-code","content":"Read the full docs"},"2821":{"id":"/developer-updates/reduce-token-consumption-with-pochi","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"page","content":"Five Practical Tips to Save Token Consumption with Pochi","url":"/developer-updates/reduce-token-consumption-with-pochi"},"2822":{"id":"/developer-updates/reduce-token-consumption-with-pochi-0","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi","content":"Learn how Pochi helps in saving token consumption by addressing context bloat and improving agent efficiency/"},"2823":{"id":"/developer-updates/reduce-token-consumption-with-pochi-1","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#five-practical-tips-to-save-token-consumption-with-pochi","content":"Five Practical Tips to Save Token Consumption with Pochi"},"2824":{"id":"/developer-updates/reduce-token-consumption-with-pochi-2","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"1. Compact context aggressively as noise accumulates"},"2825":{"id":"/developer-updates/reduce-token-consumption-with-pochi-3","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"2. Attach intent to code instead of explaining it in chat"},"2826":{"id":"/developer-updates/reduce-token-consumption-with-pochi-4","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"3. Isolate intent early with subagents and forks"},"2827":{"id":"/developer-updates/reduce-token-consumption-with-pochi-5","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"4. Scope MCP servers per task to shrink the action space"},"2828":{"id":"/developer-updates/reduce-token-consumption-with-pochi-6","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"5. When execution dominates, move heavy data processing out of the model"},"2829":{"id":"/developer-updates/reduce-token-consumption-with-pochi-7","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Why not just run a COUNT(*) query?"},"2830":{"id":"/developer-updates/reduce-token-consumption-with-pochi-8","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"heading","url":"/developer-updates/reduce-token-consumption-with-pochi#conclusion","content":"Conclusion"},"2831":{"id":"/developer-updates/reduce-token-consumption-with-pochi-9","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#five-practical-tips-to-save-token-consumption-with-pochi","content":"The usual experience with coding agents is predictable - they start out sharp, then slowly become confused, verbose, and expensive. Instructions keep piling up, tools accumulate, and failed attempts linger in the conversation. By the time token costs start hitting the roof, the agent already feels harder to work with."},"2832":{"id":"/developer-updates/reduce-token-consumption-with-pochi-10","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#five-practical-tips-to-save-token-consumption-with-pochi","content":"At that point, most teams reach for the usual fixes: improve the prompts, avoid the biggest models for small tasks, and aggressively cache tool calls. While all of these help, they come with their own overhead of constant tuning and close monitoring - and even then, they rarely address the root cause of runaway token usage."},"2833":{"id":"/developer-updates/reduce-token-consumption-with-pochi-11","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#five-practical-tips-to-save-token-consumption-with-pochi","content":"This post breaks down practical workflow patterns you can apply to address common sources of context bloat, explains the principles behind them, and shows how Pochi supports these behaviors in day-to-day work. If you’ve ever felt like an agent got worse the longer you worked with it, these patterns are likely why, and how Pochi helps you fix it."},"2834":{"id":"/developer-updates/reduce-token-consumption-with-pochi-12","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Token usage grows over time as conversations accumulate failed attempts and abandoned approaches. This context debt increases token usage and degrades response quality, making agents more verbose and error-prone."},"2835":{"id":"/developer-updates/reduce-token-consumption-with-pochi-13","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"To solve this, Pochi periodically allows you two options to compact the context:"},"2836":{"id":"/developer-updates/reduce-token-consumption-with-pochi-14","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Compact Task: This summarizes the task context and replaces long conversational history with a concise, up-to-date representation of intent and state. Applicable when you want to stay in the same task and continue the conversation with the condensed context."},"2837":{"id":"/developer-updates/reduce-token-consumption-with-pochi-15","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Your browser does not support the video tag."},"2838":{"id":"/developer-updates/reduce-token-consumption-with-pochi-16","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Create a New Task with Summary: This creates a clean task with a summary of the previous conversation, helping you avoid hitting context limits while keeping all relevant information."},"2839":{"id":"/developer-updates/reduce-token-consumption-with-pochi-17","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Your browser does not support the video tag."},"2840":{"id":"/developer-updates/reduce-token-consumption-with-pochi-18","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"These mechanisms are especially useful during long debugging sessions, iterative refactors, or tasks with multiple rounds of clarification."},"2841":{"id":"/developer-updates/reduce-token-consumption-with-pochi-19","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"In these cases, the majority of the conversation history becomes irrelevant once a direction is chosen. Compacting ensures the agent doesn’t keep paying for that history over and over again."},"2842":{"id":"/developer-updates/reduce-token-consumption-with-pochi-20","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Steps:"},"2843":{"id":"/developer-updates/reduce-token-consumption-with-pochi-21","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"When a task gets long, compact the context regularly (e.g., after 3–5 iterations)."},"2844":{"id":"/developer-updates/reduce-token-consumption-with-pochi-22","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"Keep only the essential state and intent."},"2845":{"id":"/developer-updates/reduce-token-consumption-with-pochi-23","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#1-compact-context-aggressively-as-noise-accumulates","content":"If the direction changes, create a new task with a summary of the previous conversation."},"2846":{"id":"/developer-updates/reduce-token-consumption-with-pochi-24","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Explaining code changes in plain chat is one of the fastest ways to burn tokens. Each time you prompt the agent with queries like:"},"2847":{"id":"/developer-updates/reduce-token-consumption-with-pochi-25","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"The model has to re-read large parts of the context, reconstruct what changed, and infer your intent all over again. This kind of repetition adds up quickly."},"2848":{"id":"/developer-updates/reduce-token-consumption-with-pochi-26","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Pochi avoids this by attaching intent directly to code through Edits and Reviews."},"2849":{"id":"/developer-updates/reduce-token-consumption-with-pochi-27","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Edits track the exact diffs you introduce locally while iterating. If you tweak a variable, adjust logic, or partially rewrite a block, Pochi includes only those changes in the agent’s context the next time you send a prompt."},"2850":{"id":"/developer-updates/reduce-token-consumption-with-pochi-28","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Your browser does not support the video tag."},"2851":{"id":"/developer-updates/reduce-token-consumption-with-pochi-29","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Reviews, on the other hand, let you leave inline comments directly on generated code. Instead of re-explaining issues in chat, you comment on specific lines and batch that feedback into a single, focused update."},"2852":{"id":"/developer-updates/reduce-token-consumption-with-pochi-30","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Your browser does not support the video tag."},"2853":{"id":"/developer-updates/reduce-token-consumption-with-pochi-31","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Steps:"},"2854":{"id":"/developer-updates/reduce-token-consumption-with-pochi-32","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Use edits to track local diffs during iteration."},"2855":{"id":"/developer-updates/reduce-token-consumption-with-pochi-33","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Attach intent directly to code using inline comments."},"2856":{"id":"/developer-updates/reduce-token-consumption-with-pochi-34","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#2-attach-intent-to-code-instead-of-explaining-it-in-chat","content":"Batch feedback into a single update instead of multiple chat messages."},"2857":{"id":"/developer-updates/reduce-token-consumption-with-pochi-35","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Token usage often spikes when multiple ideas compete in the same context. You start with one goal, explore a few approaches, abandon some, and finally pivot to another direction. In this case, the agent is continuously juggling multiple lines of intent. Even with compaction, the model still has to reconcile what you meant before with what you want now."},"2858":{"id":"/developer-updates/reduce-token-consumption-with-pochi-36","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Language models are optimized for coherent, single-threaded intent. When a task mixes multiple implementation strategies, the model keeps all of that alive in context, even if only one direction is still relevant."},"2859":{"id":"/developer-updates/reduce-token-consumption-with-pochi-37","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"The answer is isolation. Separate tasks mean separate contexts, and separate contexts mean fewer tokens spent reconciling unrelated ideas."},"2860":{"id":"/developer-updates/reduce-token-consumption-with-pochi-38","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Pochi supports this through task forking and subagents:"},"2861":{"id":"/developer-updates/reduce-token-consumption-with-pochi-39","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Forking a task creates a new task from a snapshot of the current workspace and conversation at the moment of the fork. The new task starts from that point with its own independent execution, and the conversation history is clipped to the fork boundary so it doesn’t carry later discussion or exploration."},"2862":{"id":"/developer-updates/reduce-token-consumption-with-pochi-40","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"This makes it useful when you want to try a different approach or explore an alternative implementation without affecting the original task’s trajectory."},"2863":{"id":"/developer-updates/reduce-token-consumption-with-pochi-41","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Your browser does not support the video tag."},"2864":{"id":"/developer-updates/reduce-token-consumption-with-pochi-42","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Subagents allow focused exploration within the same repository while keeping contexts separate. Each subagent works with a clean, bounded scope instead of accumulating unrelated history. In practice, this kind of isolation can lead to dramatic token savings. Developers running large, multi-step workflows often split work across multiple subagents, each with its own narrow instruction set."},"2865":{"id":"/developer-updates/reduce-token-consumption-with-pochi-43","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Steps:"},"2866":{"id":"/developer-updates/reduce-token-consumption-with-pochi-44","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"When you explore multiple approaches, create a fork or a subagent."},"2867":{"id":"/developer-updates/reduce-token-consumption-with-pochi-45","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Keep each task focused on one implementation strategy."},"2868":{"id":"/developer-updates/reduce-token-consumption-with-pochi-46","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#3-isolate-intent-early-with-subagents-and-forks","content":"Use separate contexts for separate goals."},"2869":{"id":"/developer-updates/reduce-token-consumption-with-pochi-47","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Before an agent attempts to solve a problem, it evaluates what it can do with every enabled tool. Each additional MCP server expands the action space the model must reason over. Even if a tool is never used, the model still spends tokens evaluating whether it is relevant, how it compares to other options, and when it applies."},"2870":{"id":"/developer-updates/reduce-token-consumption-with-pochi-48","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"For example, if a task only requires database access, exposing ten additional MCP servers adds unnecessary reasoning overhead. More options mean more branches to evaluate, which translates directly into higher token usage."},"2871":{"id":"/developer-updates/reduce-token-consumption-with-pochi-49","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Scope MCP servers per task so the agent only reasons about tools relevant to the task. Only selected servers are loaded into context, contribute tool definitions, and influence model reasoning. All other tools are invisible to the agent."},"2872":{"id":"/developer-updates/reduce-token-consumption-with-pochi-50","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Your browser does not support the video tag."},"2873":{"id":"/developer-updates/reduce-token-consumption-with-pochi-51","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Steps to follow:"},"2874":{"id":"/developer-updates/reduce-token-consumption-with-pochi-52","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Before starting a task, decide which MCP servers are necessary."},"2875":{"id":"/developer-updates/reduce-token-consumption-with-pochi-53","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Disable all MCP servers not required for this task."},"2876":{"id":"/developer-updates/reduce-token-consumption-with-pochi-54","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"If the task changes, immediately rescope the tool set."},"2877":{"id":"/developer-updates/reduce-token-consumption-with-pochi-55","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#4-scope-mcp-servers-per-task-to-shrink-the-action-space","content":"Keep a task template for common workflows (DB, infra, testing, etc.)."},"2878":{"id":"/developer-updates/reduce-token-consumption-with-pochi-56","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Once you’ve scoped tools correctly, the next source of runaway token usage often shows up during execution, typically inside MCP-backed workflows."},"2879":{"id":"/developer-updates/reduce-token-consumption-with-pochi-57","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The prompt may be short and the tool choice correct, yet execution tokens spike because large volumes of raw data are streamed into the model."},"2880":{"id":"/developer-updates/reduce-token-consumption-with-pochi-58","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Tool calls may return hundreds or thousands of rows, which then get streamed into the model as large JSON payloads. At that point, execution tokens dwarf everything else."},"2881":{"id":"/developer-updates/reduce-token-consumption-with-pochi-59","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The failure mode is asking the model to reason over this raw data. For example, we asked Pochi:"},"2882":{"id":"/developer-updates/reduce-token-consumption-with-pochi-60","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"In the first attempt, the agent queried the database, fetched all matching rows, and streamed them into the model so it could filter and count them."},"2883":{"id":"/developer-updates/reduce-token-consumption-with-pochi-61","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Your browser does not support the video tag."},"2884":{"id":"/developer-updates/reduce-token-consumption-with-pochi-62","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"The answer was correct, but thousands of records flowed through the context just so the model could compute a single number."},"2885":{"id":"/developer-updates/reduce-token-consumption-with-pochi-63","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"A better approach is to separate what needs to be computed from how it is computed. Instead of reasoning over data, the model should generate code that performs the computation and returns only the result."},"2886":{"id":"/developer-updates/reduce-token-consumption-with-pochi-64","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Your browser does not support the video tag."},"2887":{"id":"/developer-updates/reduce-token-consumption-with-pochi-65","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Pochi generated the following script:"},"2888":{"id":"/developer-updates/reduce-token-consumption-with-pochi-66","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#5-when-execution-dominates-move-heavy-data-processing-out-of-the-model","content":"Now when prompted again to fetch the number of failed orders, the model never sees the raw records. Only a short summary enters the context, dropping execution tokens from tens of thousands to a few hundred."},"2889":{"id":"/developer-updates/reduce-token-consumption-with-pochi-67","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"At this point, it’s reasonable to think that the agent can run the SQL query directly:"},"2890":{"id":"/developer-updates/reduce-token-consumption-with-pochi-68","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Why do we need to get the agent to write a separate script?"},"2891":{"id":"/developer-updates/reduce-token-consumption-with-pochi-69","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"And you’re right. Expect that agents often choose the least expensive path. Even when a database can do aggregation, agents frequently fall back to pull-and-process patterns:"},"2892":{"id":"/developer-updates/reduce-token-consumption-with-pochi-70","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"This is where token usage explodes, for several reasons:"},"2893":{"id":"/developer-updates/reduce-token-consumption-with-pochi-71","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Schema uncertainty: If the agent isn’t confident about column names, enums, joins, indexes, it plays it safe by fetching rows and reasoning in-text."},"2894":{"id":"/developer-updates/reduce-token-consumption-with-pochi-72","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Ambiguous instructions: If the prompt says: “Find refunded orders and tell me how many there are”, the agent may fetch records first, inspect fields, and thenthen count, Instead of jumping straight to COUNT(*)"},"2895":{"id":"/developer-updates/reduce-token-consumption-with-pochi-73","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Tool abstraction: Many MCP database tools expose run query, fetch rows, but don’t strongly bias the model toward aggregation-first queries. So the model takes the path it can reason about most reliably."},"2896":{"id":"/developer-updates/reduce-token-consumption-with-pochi-74","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Multi-step reasoning: If the question is slightly more complex: “How many refunded orders from customers who signed up last quarter?”. The agent might fetch orders, fetch users, join in its head and then count. That’s almost guaranteed to stream a lot of data."},"2897":{"id":"/developer-updates/reduce-token-consumption-with-pochi-75","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Databases are cheap at filtering and counting while language models are not. The solution is simple - let the model decide what to compute, and let code handle how the computation happens. Only the final result should enter the context. Having a script lets us review the code and make sure that it runs the same computation every time the same prompt is called."},"2898":{"id":"/developer-updates/reduce-token-consumption-with-pochi-76","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"This keeps execution costs predictable, even when working with large datasets."},"2899":{"id":"/developer-updates/reduce-token-consumption-with-pochi-77","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Steps:"},"2900":{"id":"/developer-updates/reduce-token-consumption-with-pochi-78","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Detect when tool results exceed ~100 rows."},"2901":{"id":"/developer-updates/reduce-token-consumption-with-pochi-79","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Instead of asking the model to reason over raw data, ask it to generate code that computes the result."},"2902":{"id":"/developer-updates/reduce-token-consumption-with-pochi-80","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Return only the final result to the model (summary, count, aggregation)."},"2903":{"id":"/developer-updates/reduce-token-consumption-with-pochi-81","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#why-not-just-run-a-count-query","content":"Use aggregation-first queries when possible."},"2904":{"id":"/developer-updates/reduce-token-consumption-with-pochi-82","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#conclusion","content":"If there’s one theme across all five guides, it’s that token usage is shaped long before a prompt is sent.\nMost token blowups don’t come from bad prompts or choosing the wrong model. They come from workflows that allow too much context, too many tools, and too many competing ideas to accumulate in the same place."},"2905":{"id":"/developer-updates/reduce-token-consumption-with-pochi-83","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#conclusion","content":"When each task has a clear goal, well-suited tools, and a clean context, the agent doesn’t have to waste tokens reconciling noise. It can converge faster, reason more clearly, and produce better results at lower cost."},"2906":{"id":"/developer-updates/reduce-token-consumption-with-pochi-84","page_id":"/developer-updates/reduce-token-consumption-with-pochi","type":"text","url":"/developer-updates/reduce-token-consumption-with-pochi#conclusion","content":"At Pochi, this philosophy is baked into the product. The goal isn’t to make you think about tokens because we tailor an experience that naturally keeps context small, intent clear, and costs predictable."},"2907":{"id":"/developer-updates/reinforcement-learning-in-ai-coding","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"page","content":"Closing the Loop: How Reinforcement Learning is Changing AI Coding","url":"/developer-updates/reinforcement-learning-in-ai-coding"},"2908":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-0","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding","content":"Developers are trying to make LLMs write code, but few are teaching them how to engineer"},"2909":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-1","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#closing-the-loop-how-reinforcement-learning-is-changing-ai-coding","content":"Closing the Loop: How Reinforcement Learning is Changing AI Coding"},"2910":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-2","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"TL;DR"},"2911":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-3","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-data-problem","content":"The Data Problem"},"2912":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-4","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-signal-sparsity-problem","content":"The Signal Sparsity Problem"},"2913":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-5","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"The State Problem: Building a Code World Model"},"2914":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-6","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"heading","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"Takeaway: Moving Toward Verifiable Agents"},"2915":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-7","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"Using SFT teaches models how to write code, but it is RL that is necessary to teach them what works. On the other hand, introducing RL in software engineering brings its own specific challenges:  data availability, signal sparsity, and state tracking. In this post, we’ll break down how recent works address these challenges."},"2916":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-8","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"So far, the focus of RL driven improvements had been based on competitive coding. For example, in LeetCode-style tasks, the model works in a closed loop. It generally receives a clear problem statement and in turn, it generates a single, self-contained solution."},"2917":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-9","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"This means there are no dependencies involved, no files systems to navigate, and no legacy code that can break. It is exactly like solving a logic puzzle in isolation rather than understanding the engineering implications on the overall codebase."},"2918":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-10","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"However, the field of Software Engineering (SWE) in real-world is fundamentally different. It is a stateful, multi-turn interactive problem. A day-to-day involves much more than just writing the correct functions. You often need to navigate a file system, check up on dependency graphs, run the proper tests, and interpret logs in case of errors. This implies, an agent effectively needs to maintain coherence across a long horizon of interactions."},"2919":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-11","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"Which is why RL is an ideal candidate for SWE since agent actions produce verifiable results. At the same time, it also introduces challenges that are not present in single-turn tasks. For example,"},"2920":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-12","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"Data Availability: We cannot easily simulate millions of environmental interactions like we can with math problems."},"2921":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-13","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"Signal Sparsity: Often, success signals appear at the very end of a long sequence of edits."},"2922":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-14","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"State Tracking: Along with the static text of the code, the model must understand the dynamic state of the runtime environment"},"2923":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-15","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#tldr","content":"Recent works from Meta and Moonshot AI surfaced how the industry is pivoting from general reasoning RL to domain-specific SWE-RL to address these challenges."},"2924":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-16","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-data-problem","content":"In order to learn trial and error, the standard RL requires an agent to interact with an environment. For coding, this means running a test suite or compiling code. As compared to verifying math proof, this simulation will be prohibitively slow and expensive in a real-world setting. Here, the engineering challenges arises to figure out how to bootstrap the entire learning process without being dependent on costly online simulation."},"2925":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-17","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-data-problem","content":"Meta proved that you can bypass the online bottleneck by using the massive offline history of Github. In its recent work on SWE-RL they talked through this approach instead of setting up a live sandbox for every training step."},"2926":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-18","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-data-problem","content":"But offline data lacks a reward signal. For every historical Pull Request, you cannot easily go back in time and execute tests. SWE-RL solves this by creating a process proxy reward. They calculate the fine grained text similarity  between the generated patch and the actual developer ground truth solution instead of just checking if the code runs."},"2927":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-19","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-data-problem","content":"Depending on how closely the generated format matches the human solution, the model receives a continuous reward. On the other hand, if the model generates an invalid patch format, it receives a penalty. This demonstrates that even before touching a compiler, you can teach a model complex engineering behaviours like navigating file structures and adhering to project conventions using static history."},"2928":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-20","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-signal-sparsity-problem","content":"Next, we have the credit assignment problem while facing online training within executable environments. That means it is difficult to indentify which step really contributed to the final success of the model and which step should get the reward. This reflects on software engineering as any agent can fail after 50 steps of editing and testing. Standard RL struggles to identify which specific step caused the failure."},"2929":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-21","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-signal-sparsity-problem","content":"The Kimi-Dev paper addresses this through task decomposition. It treats software engineering as a composition of atomic skills: the BugFixer (editing logic) and the TestWriter (verifying logic) instead of training an end-to-end agent to solve the issue immediately."},"2930":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-22","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-signal-sparsity-problem","content":"Their solution starts with Agentless RL. They train the model specifically on these short horizon atomic tasks using outcome based rewards. They look for signals on whether the patch passed the test or did the test reproduce the bug. And since the tasks are scoped down, the feedback signal becomes dense and clear."},"2931":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-23","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-signal-sparsity-problem","content":"Kimi-Dev shows that with minimal additional data, a model having these pre-trained capabilities can be adapted to a complex multi-turn agent framework. This suggests that the most efficient path to autonomous agents is rigorous skill acquisition’s followed by workflow adaptation rather than brute force end to end training."},"2932":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-24","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"Coming to the final challenge, which is also arguably the most profound. Engineers generally do not just read code as text but also think about the execution loops in their mind. This involves tracking how variables change in memory and how functions interact between files. Meanwhile, since current code LLMs lack this internal compiler engine, they just merely predict the next token based on statistical likelihood."},"2933":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-25","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"Meta Code World Model addresses this by fundamentally changing the training curriculum. They realized that waiting until the RL phase to teach execution dynamics is too late. The rewards are too sparse and the gradient vanishes on hard problems."},"2934":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-26","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"Instead, in the mid-training stage, they inject process supervision directly. To teach the physics of code, they constructed two massive datasets:"},"2935":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-27","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"Python Execution Traces: With over 120 million examples, the model is trained to predict not just the next line of code, but also the exact state of runtime variables (the values in memory) after every single line."},"2936":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-28","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"ForagerAgent Trajectories: Agents with 3 million trajectories that interact with a Docker environment to solve tasks."},"2937":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-29","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"This forces the model to internalise a Code World Model. By the time the model enters the final RL stage it is no longer starting from scratch. It already understands if I write X then variable Y changes to Z."},"2938":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-30","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#the-state-problem-building-a-code-world-model","content":"Consequently, the RL stage becomes a process of Goal Alignment. It uses sparse result rewards like passing tests simply to guide a model.  It already understands execution physics to select the specific path that satisfies the verification requirement."},"2939":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-31","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"This progression from SWE-RL (offline proxy rewards) to Kimi-Dev (decomposed skill learning) and CWM (execution-trace world models) outlines a clear engineering roadmap for the next generation of code models and agentic RL frameworks."},"2940":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-32","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"We are seeing a shift from generic reasoning to specialized engineering. Future models will be more than just smart. They will be grounded in repository history, capable of self-verification through test writing, and possess an explicit internal model of runtime state."},"2941":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-33","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"At TabbyML we view these developments as the foundation for Verifiable Engineering. The future value of AI in software development lies in building agents that understand and respect the state of your system."},"2942":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-34","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"Related Papers:"},"2943":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-35","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"SWE-RL: Advancing LLM Reasoning via Reinforcement Learning on Open Software Evolution"},"2944":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-36","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"Kimi-Dev: Agentless Training as Skill Prior for SWE-Agents"},"2945":{"id":"/developer-updates/reinforcement-learning-in-ai-coding-37","page_id":"/developer-updates/reinforcement-learning-in-ai-coding","type":"text","url":"/developer-updates/reinforcement-learning-in-ai-coding#takeaway-moving-toward-verifiable-agents","content":"CWM: An Open-Weights LLM for Research on Code Generation with World Models"},"2946":{"id":"/developer-updates/request-management-in-nes","page_id":"/developer-updates/request-management-in-nes","type":"page","content":"NES Series (Part 3): The Request Management Lifecycle Under Continuous Typing","url":"/developer-updates/request-management-in-nes"},"2947":{"id":"/developer-updates/request-management-in-nes-0","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes","content":"In this post, we'll explore how NES decides what to suggest and when those suggestions should appear at the right time"},"2948":{"id":"/developer-updates/request-management-in-nes-1","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"NES Series (Part 3): The Request Management Lifecycle Under Continuous Typing"},"2949":{"id":"/developer-updates/request-management-in-nes-2","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"The NES Request Management Lifecycle"},"2950":{"id":"/developer-updates/request-management-in-nes-3","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"Debouncing: Requesting the Model at the Right Moment"},"2951":{"id":"/developer-updates/request-management-in-nes-4","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#cancellation-correctness-over-completion","content":"Cancellation: Correctness Over Completion"},"2952":{"id":"/developer-updates/request-management-in-nes-5","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Speculative Prediction: Staying One Step Ahead of the User"},"2953":{"id":"/developer-updates/request-management-in-nes-6","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#conclusion","content":"Conclusion"},"2954":{"id":"/developer-updates/request-management-in-nes-7","page_id":"/developer-updates/request-management-in-nes","type":"heading","url":"/developer-updates/request-management-in-nes#whats-next","content":"What’s next?"},"2955":{"id":"/developer-updates/request-management-in-nes-8","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"In Part 1, we talked about how we trained our NES model to predict the next meaningful edit you’re likely to make in your code."},"2956":{"id":"/developer-updates/request-management-in-nes-9","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"In Part 2, we then covered what the model takes as context to make this edit. This included deep dives into editable regions, user’s edit history, and using the overall project context."},"2957":{"id":"/developer-updates/request-management-in-nes-10","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"Together, these two pieces (model + context) form the core intelligence foundation of the NES system. But incorporating them into an end-to-end real-time engineering system requires more thinking about real developer coding behaviour."},"2958":{"id":"/developer-updates/request-management-in-nes-11","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"A code editor is a continuously changing space. Developers type, pause, delete, move the cursor, undo, redo, and essentially keep editing, often faster than any model can respond. Even a fast model call involves network latency, debouncing delays, server-side scheduling, and decoding / streaming time."},"2959":{"id":"/developer-updates/request-management-in-nes-12","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"If not careful, a request that was correct when it was sent can return a response that arrives a few hundred milliseconds too late. Which means now you end up with edit suggestions for code that no longer exists. This is something that’s termed “haunted” for being technically right but not at the right place."},"2960":{"id":"/developer-updates/request-management-in-nes-13","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"This means, in practice, a correct edit shown at the wrong moment is perceived as wrong by the user. So even with proper context and a good model, it is equally important to have the correct timing. Then only can the product actually feel useful without being distracting."},"2961":{"id":"/developer-updates/request-management-in-nes-14","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"But getting timing right is challenging, due to the ever evolving nature of the user’s editing state. To make NES feel real-time and helpful, we had to reason about what happens before a request is sent, while it’s in-flight, and after the model responds. This is what we call request management."},"2962":{"id":"/developer-updates/request-management-in-nes-15","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#nes-series-part-3-the-request-management-lifecycle-under-continuous-typing","content":"Let’s look at it in more detail."},"2963":{"id":"/developer-updates/request-management-in-nes-16","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"Request Management of a NES prediction happens in three stages:"},"2964":{"id":"/developer-updates/request-management-in-nes-17","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"Before the request: waiting until the user actually pauses"},"2965":{"id":"/developer-updates/request-management-in-nes-18","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"While the request is in-flight: discard anything that becomes outdated"},"2966":{"id":"/developer-updates/request-management-in-nes-19","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"After the model responds: keep the suggestion alive if the user continues along the same trajectory"},"2967":{"id":"/developer-updates/request-management-in-nes-20","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"These map to what we technically implement as debouncing, cancellation, and speculative-prediction caching."},"2968":{"id":"/developer-updates/request-management-in-nes-21","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#the-nes-request-management-lifecycle","content":"This structure helps bring the intelligent results (what we get with context + model) to users reliably, even as they type continuously. NES continues to run this loop as you type.\nLet’s take a closer look at how we handle timing at each stage."},"2969":{"id":"/developer-updates/request-management-in-nes-22","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"The first question we had to tackle was, “When is the right time to send a request?” When a developer is typing continuously, a request on every keystroke has little value and is wasteful. At the same time, waiting too long would make the system feel unresponsive and slow. We had to find that sweet spot that lies in detecting the exact moment the user actually paused typing."},"2970":{"id":"/developer-updates/request-management-in-nes-23","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"Most systems solve this with a fixed interval, (say, 100ms), but real-world typing isn’t this predictable. Instead, we decided to adapt the debounce interval based on how the user is behaving right at that moment."},"2971":{"id":"/developer-updates/request-management-in-nes-24","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"To achieve this, we made NES pay attention to a handful of lightweight signals."},"2972":{"id":"/developer-updates/request-management-in-nes-25","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"For example, typing a . often means the developer is about to pause to access a method of an object,  so we get the signal to shorten the debounce delay. Whereas, if the user is continuously typing through a variable name, we stretch the delay a bit to avoid jumping in too early. And if the model’s recent response times have been slower due to network conditions, we account for that too, so suggestions land at the exact moment the user expects them."},"2973":{"id":"/developer-updates/request-management-in-nes-26","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#debouncing-requesting-the-model-at-the-right-moment","content":"This way, the result is a debounce time window that changes with the user’s rhythm. It is short when the user has paused, and long when they’re in flow, all while making sure it never exceeds 1 second."},"2974":{"id":"/developer-updates/request-management-in-nes-27","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#cancellation-correctness-over-completion","content":"Once a request is finally sent, the editor doesn’t stop moving. A user can continue typing, move the cursor, or undo and redo steps before the model has even started responding. When that happens, the original request becomes stale instantly."},"2975":{"id":"/developer-updates/request-management-in-nes-28","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#cancellation-correctness-over-completion","content":"In such a case, we cancel the original request from the client-side, and in turn, the server propagates the cancellation, with any late responses being discarded without ever getting them rendered to the UI.\n\nThis is a deliberate design decision that optimises and enforces correctness in a live, ever-evolving editing system. We would prefer that NES show nothing rather than something misleading."},"2976":{"id":"/developer-updates/request-management-in-nes-29","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#cancellation-correctness-over-completion","content":"If you’re interested in how this works end-to-end, including streaming behaviour, we’ve written more about it here."},"2977":{"id":"/developer-updates/request-management-in-nes-30","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Traditional caching is straightforward. If nothing has changed, just reuse the previous response. In the case of NES, this helps to avoid duplicate requests. And to think about it, throwing work away all the time would be expensive if we didn’t balance it out elsewhere."},"2978":{"id":"/developer-updates/request-management-in-nes-31","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"But we go a step further. When the model returns an edit suggestion, we don’t just cache it for the exact context that produced it, but also speculate on the next few contexts the user is likely to enter."},"2979":{"id":"/developer-updates/request-management-in-nes-32","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Now, if the user continues typing along the same trajectory, NES doesn't need to call the model again and can continue serving the speculated suggestion. We call this speculative prediction."},"2980":{"id":"/developer-updates/request-management-in-nes-33","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"A speculated prediction remains valid as long as the user is essentially still typing into the suggestion and the surrounding context hasn't changed."},"2981":{"id":"/developer-updates/request-management-in-nes-34","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"It’ll be better to illustrate this with the help of an example. Suppose a user types:"},"2982":{"id":"/developer-updates/request-management-in-nes-35","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"NES sends a request and gets the following suggestion:"},"2983":{"id":"/developer-updates/request-management-in-nes-36","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"If the user then continues to type, resulting in:"},"2984":{"id":"/developer-updates/request-management-in-nes-37","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"This user edit is part of the received suggestion. Therefore, the suggestion should still be displayed (unless the user has explicitly rejected it by pressing esc)."},"2985":{"id":"/developer-updates/request-management-in-nes-38","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"By retrieving this result from the forward prediction cache, we can display the suggestion faster and reduce LLM request usage."},"2986":{"id":"/developer-updates/request-management-in-nes-39","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#speculative-prediction-staying-one-step-ahead-of-the-user","content":"Of course, if the user is not satisfied with the cached suggestion, they still have the option to send a new request to get multiple choices. In essence, forward caching helps accelerate the common path, improving the overall experience."},"2987":{"id":"/developer-updates/request-management-in-nes-40","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#conclusion","content":"By the time a suggestion appears in NES, a lot has already happened. Debouncing decides when is the right time to make a request, cancellation makes sure outdated intent never surfaces in the UI, and speculative prediction lets us reuse good existing predictions when the user naturally moves through them."},"2988":{"id":"/developer-updates/request-management-in-nes-41","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#conclusion","content":"While you’d find these techniques are familiar in distributed systems, applying them inside a code editor was a challenge of its own. The primary driving factor wasn’t about throughput or load but about every evolving human intent under motion."},"2989":{"id":"/developer-updates/request-management-in-nes-42","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#whats-next","content":"So far, we’ve focused on how NES decides what to suggest and when those suggestions should appear. With request management in place, we now have a system that ensures LLM-powered edits reach the user only when they’re truly helpful."},"2990":{"id":"/developer-updates/request-management-in-nes-43","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#whats-next","content":"But now that brings us to the next stage of the process: How should these edits be presented?"},"2991":{"id":"/developer-updates/request-management-in-nes-44","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#whats-next","content":"NES suggestions aren’t always a single line near the cursor. Sometimes the relevant edit is several lines or even several files away. Presenting enough information for a quick action without breaking the developer’s flow is a surprisingly deep design and engineering challenge."},"2992":{"id":"/developer-updates/request-management-in-nes-45","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#whats-next","content":"This is especially tricky inside a code editor like VS Code, where rendering options are limited. In such cases, how do we preview multi-line edits precisely? How do we make them feel lightweight, immediate, and skimmable, without being modal or disruptive?"},"2993":{"id":"/developer-updates/request-management-in-nes-46","page_id":"/developer-updates/request-management-in-nes","type":"text","url":"/developer-updates/request-management-in-nes#whats-next","content":"In Part 4, we’ll dive into how we approached these constraints and built a rendering system that enables richer previews and lower-latency interactions for code edits."},"2994":{"id":"/developer-updates/ssh-database-access","page_id":"/developer-updates/ssh-database-access","type":"page","content":"How to Give Coding Agents Access to SSH and Databases (Without Breaking Production)","url":"/developer-updates/ssh-database-access"},"2995":{"id":"/developer-updates/ssh-database-access-0","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access","content":"This blog illustrates ways to give coding agents access to your databases and SSH servers safely."},"2996":{"id":"/developer-updates/ssh-database-access-1","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"How to Give Coding Agents Access to SSH and Databases (Without Breaking Production)"},"2997":{"id":"/developer-updates/ssh-database-access-2","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"Why database-level controls fail"},"2998":{"id":"/developer-updates/ssh-database-access-3","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#agents-route-around-blocked-tools","content":"Agents route around blocked tools"},"2999":{"id":"/developer-updates/ssh-database-access-4","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#what-actually-holds-up-in-production","content":"What actually holds up in production"},"3000":{"id":"/developer-updates/ssh-database-access-5","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"1. Read-only access still allows irreversible damage"},"3001":{"id":"/developer-updates/ssh-database-access-6","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#2-writes-must-flow-through-existing-deployment-pipelines","content":"2. Writes must flow through existing deployment pipelines"},"3002":{"id":"/developer-updates/ssh-database-access-7","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#3-isolated-writable-environments-enable-safe-iteration","content":"3. Isolated writable environments enable safe iteration"},"3003":{"id":"/developer-updates/ssh-database-access-8","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#why-shells-make-safety-undefined","content":"Why shells make safety undefined"},"3004":{"id":"/developer-updates/ssh-database-access-9","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#disposable-environments","content":"Disposable environments"},"3005":{"id":"/developer-updates/ssh-database-access-10","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"Restricted hosts and forced commands"},"3006":{"id":"/developer-updates/ssh-database-access-11","page_id":"/developer-updates/ssh-database-access","type":"heading","url":"/developer-updates/ssh-database-access#conclusion","content":"Conclusion"},"3007":{"id":"/developer-updates/ssh-database-access-12","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"As AI agents become more capable, teams are trying to limit the damage they can do when given access to SSH or production databases.\nCommon approaches include:"},"3008":{"id":"/developer-updates/ssh-database-access-13","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"Command allowlists: allow ls, cat, grep, tail; block rm, mv, chmod."},"3009":{"id":"/developer-updates/ssh-database-access-14","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"SQL filters: Allow SELECT; block INSERT, DELETE, DROP."},"3010":{"id":"/developer-updates/ssh-database-access-15","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"Manual approval flows: Run everything in read-only mode until a human explicitly accepts changes."},"3011":{"id":"/developer-updates/ssh-database-access-16","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"These practices assume that constraining agent behaviour through rules, filters, and approvals can prevent dangerous actions."},"3012":{"id":"/developer-updates/ssh-database-access-17","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"This assumption is wrong."},"3013":{"id":"/developer-updates/ssh-database-access-18","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"Allowlists, prompts, and approval dialogs are control surfaces that influence what an agent chooses to do. Shells, credentials, runtimes, and database roles function as execution surfaces, defining what the system can do."},"3014":{"id":"/developer-updates/ssh-database-access-19","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"Risk is determined by execution surfaces, not control surfaces."},"3015":{"id":"/developer-updates/ssh-database-access-20","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#how-to-give-coding-agents-access-to-ssh-and-databases-without-breaking-production","content":"Enforcing safety at the behavior layer isn’t the solution. What follows is why these approaches fail in practice - and what actually holds up in production."},"3016":{"id":"/developer-updates/ssh-database-access-21","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"Human engineers rarely connect to primary databases with full access. They query replicas or views that cannot change production data. The same principle must apply to agents, but it is not enough to enforce this only at the query level."},"3017":{"id":"/developer-updates/ssh-database-access-22","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"There are several reasons for this."},"3018":{"id":"/developer-updates/ssh-database-access-23","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"First, SQL filtering is unreliable. Even if you block write statements, many databases still support queries that trigger full table scans. Constructs like SELECT INTO can introduce new tables, and functions can produce side effects."},"3019":{"id":"/developer-updates/ssh-database-access-24","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"Second, read access alone is dangerous. It can expose authentication tokens, PII, or operational metadata. This is why databases themselves do not rely on client-side query validation and instead implement safety through roles, views, and replicas."},"3020":{"id":"/developer-updates/ssh-database-access-25","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-database-level-controls-fail","content":"Re-implementing parts of this logic in the agent layer with regexes or heuristics is both fragile and incomplete."},"3021":{"id":"/developer-updates/ssh-database-access-26","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#agents-route-around-blocked-tools","content":"An agent’s goal is task completion. Blocking individual tools does not mean entire classes of state changes are prevented. For example, if the agent finds that direct deletion within a database schema is blocked, it will reach the same outcome by putting together other allowed operations."},"3022":{"id":"/developer-updates/ssh-database-access-27","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#agents-route-around-blocked-tools","content":"In this case, even though direct access to the tool is blocked, it doesn't prevent many other possible walkarounds that could apply undesired changes to the production system."},"3023":{"id":"/developer-updates/ssh-database-access-28","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#agents-route-around-blocked-tools","content":"In practice, this can include writing a script that performs deletion or just invoking a different tool that indirectly gives the expected outcome. This is not adversarial behavior. Instructions, allowlists, and approval dialogs influence behavior, but they do not define what the system is capable of doing."},"3024":{"id":"/developer-updates/ssh-database-access-29","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#agents-route-around-blocked-tools","content":"For that reason, safety cannot live solely inside the model. It must be enforced outside the model through OS permissions, roles, and tool interfaces. Access control is not a prompting problem. It's an infrastructure problem that will require explicit separation between reasoning and execution, with enforcement applied at deterministic execution boundaries."},"3025":{"id":"/developer-updates/ssh-database-access-30","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"In one setup, we exposed production data to an agent exclusively through a read-only tool interface backed by a SELECT-only database role. On paper, this appeared safe - the agent could inspect data but had no explicit write tools."},"3026":{"id":"/developer-updates/ssh-database-access-31","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"However, as long as the agent retained access to a general execution surface (shell access, runtime file system, or database credentials), it simply routed around the restriction, generating its own script and updating the database through an unintended path."},"3027":{"id":"/developer-updates/ssh-database-access-32","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"Your browser does not support the video tag."},"3028":{"id":"/developer-updates/ssh-database-access-33","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"We removed the execution surface entirely and enforced read-only access at the infrastructure level. This involved revoking database write permissions and disabling shell execution. Post this, the agent could reason freely but could no longer apply any changes."},"3029":{"id":"/developer-updates/ssh-database-access-34","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"Your browser does not support the video tag."},"3030":{"id":"/developer-updates/ssh-database-access-35","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"Even when read-only access is enforced at the infrastructure level, production access still depends on human approval. Over time, these approvals tend to degrade into procedural steps. Auto-approve paths appear, reviews become mechanical, and the safety boundary weakens."},"3031":{"id":"/developer-updates/ssh-database-access-36","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"As a result, granting agents direct access to production databases, even in read-only mode, is best avoided. Agents are non-deterministic by design, and production systems should not be exposed to that uncertainty."},"3032":{"id":"/developer-updates/ssh-database-access-37","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#1-read-only-access-still-allows-irreversible-damage","content":"The challenge is that many legitimate tasks still require writes."},"3033":{"id":"/developer-updates/ssh-database-access-38","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#2-writes-must-flow-through-existing-deployment-pipelines","content":"Many engineering tasks involve backfills, schema updates, and data correction. All of these require write access."},"3034":{"id":"/developer-updates/ssh-database-access-39","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#2-writes-must-flow-through-existing-deployment-pipelines","content":"Giving an agent write access to production data under these circumstances is rarely acceptable. A more robust pattern is to let agents propose changes, generate and test migration scripts, and iterate freely. But applying those same changes to production will still wait on explicit human approval."},"3035":{"id":"/developer-updates/ssh-database-access-40","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#2-writes-must-flow-through-existing-deployment-pipelines","content":"This mirrors standard engineering practice. It avoids giving production credentials to agents and ensures all changes are auditable and reversible."},"3036":{"id":"/developer-updates/ssh-database-access-41","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#2-writes-must-flow-through-existing-deployment-pipelines","content":"The tradeoff is slower iteration, because agents can’t validate assumptions against real production data. This is where isolated writable environments become important."},"3037":{"id":"/developer-updates/ssh-database-access-42","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#3-isolated-writable-environments-enable-safe-iteration","content":"Isolated Writable Environments (IWEs) are disposable database instances that mirror production schema and data. Within these environments, agents can evolve schemas, validate queries, and test migrations freely. Once the changes are ready, the same test and migration scripts can be replayed through the original production pipelines."},"3038":{"id":"/developer-updates/ssh-database-access-43","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#3-isolated-writable-environments-enable-safe-iteration","content":"In practice, combining IWEs with gated production deployment yields the best results. You get the agent to perform actions against isolated databases while production remains gated by standard deployment processes."},"3039":{"id":"/developer-updates/ssh-database-access-44","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#3-isolated-writable-environments-enable-safe-iteration","content":"The same principle applies outside the database layer. With SSH and shell access, the execution surface becomes effectively unbounded unless similar infrastructure-level boundaries are enforced."},"3040":{"id":"/developer-updates/ssh-database-access-45","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-shells-make-safety-undefined","content":"A shell is a general-purpose programming environment. Once exposed, safety boundaries become undefined."},"3041":{"id":"/developer-updates/ssh-database-access-46","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-shells-make-safety-undefined","content":"An agent can use cat to overwrite files, using grep can exfiltrate secrets, and tail -f, if used on the wrong file, can leak sensitive data indefinitely. On the other hand, having an allowlist to control which binaries are executed does not automatically constrain the kind of operations that are possible on the system."},"3042":{"id":"/developer-updates/ssh-database-access-47","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-shells-make-safety-undefined","content":"Having a shell exposed grants access to the file system, process creation, and the environment state. And once a shell exists, the boundary of what is allowed is no longer clear."},"3043":{"id":"/developer-updates/ssh-database-access-48","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#why-shells-make-safety-undefined","content":"The safest designs accept this and shift the focus from preventing mistakes to containing them."},"3044":{"id":"/developer-updates/ssh-database-access-49","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#disposable-environments","content":"The simplest and most reliable pattern is to treat any machine an agent can access as disposable. This way when something goes wrong, you just replace the whole thing and not spend time to fix it. This is already how CI systems operate, and increasingly how dev environments are provisioned."},"3045":{"id":"/developer-updates/ssh-database-access-50","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#disposable-environments","content":"Instead of connecting agents to long-lived servers, teams route them to short-lived containers, ephemeral VMs or dev sandboxes per task or per session. This way agents are free to modify files, install packages and experiment with configurations.  But this introduces infrastructure cost while reducing production impact."},"3046":{"id":"/developer-updates/ssh-database-access-51","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"Some teams still require agents for log inspection, operational debugging, or controlled maintenance. But even in these cases, full interactive shells are rarely necessary. Common restrictions can include:"},"3047":{"id":"/developer-updates/ssh-database-access-52","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"SSH users with no home directory and limited permissions"},"3048":{"id":"/developer-updates/ssh-database-access-53","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"forced commands in authorized_keys so only specific scripts can run"},"3049":{"id":"/developer-updates/ssh-database-access-54","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"wrapper binaries that expose narrow actions instead of general shells"},"3050":{"id":"/developer-updates/ssh-database-access-55","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"For example, instead of allowing:"},"3051":{"id":"/developer-updates/ssh-database-access-56","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"the key may enforce:"},"3052":{"id":"/developer-updates/ssh-database-access-57","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"This reduces damage area but comes with its own pitfalls. Debugging can become harder and workflows might require constant tooling updates."},"3053":{"id":"/developer-updates/ssh-database-access-58","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"Structured tools and APIs provide stronger safety guarantees than shells.. A shell exposes the file system, environment variables and network access - making it impossible to create boundaries without building a second operating system around it."},"3054":{"id":"/developer-updates/ssh-database-access-59","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#restricted-hosts-and-forced-commands","content":"This approach already mirrors how human access to infrastructure has evolved as well. We now have fewer SSH sessions, more pipelines, dashboards, and automation APIs. Agents benefit from the same shift, for the same reasons."},"3055":{"id":"/developer-updates/ssh-database-access-60","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#conclusion","content":"Throughout this post, we saw the same pattern repeat across different systems. When the agent was instructed to follow safety, through instructions, prompts, or behavioral constraints, it failed. Whereas, when safety was enforced through infrastructure (roles, isolation, and execution boundaries), it held."},"3056":{"id":"/developer-updates/ssh-database-access-61","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#conclusion","content":"Many teams make this fundamental mistake of treating access control as a prompting problem instead of a system problem."},"3057":{"id":"/developer-updates/ssh-database-access-62","page_id":"/developer-updates/ssh-database-access","type":"text","url":"/developer-updates/ssh-database-access#conclusion","content":"The only reliable way to make agents safe is to design environments where destructive actions are physically unreachable, and all state changes flow through auditable, deterministic systems. Once safety is achieved by design, mistakes become recoverable, contained, and reviewable - and only then can agents be given meaningful autonomy across real production use cases."},"3058":{"id":"/tutorials/connect-to-tabby-server","page_id":"/tutorials/connect-to-tabby-server","type":"page","content":"Connect to Tabby Server for Enhanced Enterprise Experience","url":"/tutorials/connect-to-tabby-server"},"3059":{"id":"/tutorials/connect-to-tabby-server-0","page_id":"/tutorials/connect-to-tabby-server","type":"heading","url":"/tutorials/connect-to-tabby-server#connect-to-tabby-server-for-enhanced-enterprise-experience","content":"Connect to Tabby Server for Enhanced Enterprise Experience"},"3060":{"id":"/tutorials/connect-to-tabby-server-1","page_id":"/tutorials/connect-to-tabby-server","type":"heading","url":"/tutorials/connect-to-tabby-server#prerequisites","content":"Prerequisites"},"3061":{"id":"/tutorials/connect-to-tabby-server-2","page_id":"/tutorials/connect-to-tabby-server","type":"heading","url":"/tutorials/connect-to-tabby-server#configuration","content":"Configuration"},"3062":{"id":"/tutorials/connect-to-tabby-server-3","page_id":"/tutorials/connect-to-tabby-server","type":"heading","url":"/tutorials/connect-to-tabby-server#parameters","content":"Parameters"},"3063":{"id":"/tutorials/connect-to-tabby-server-4","page_id":"/tutorials/connect-to-tabby-server","type":"heading","url":"/tutorials/connect-to-tabby-server#conclusion","content":"Conclusion"},"3064":{"id":"/tutorials/connect-to-tabby-server-5","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#connect-to-tabby-server-for-enhanced-enterprise-experience","content":"This tutorial will guide you through the process of connecting Pochi to your self-hosted Tabby server. By connecting Pochi to your self-hosted Tabby server, you can take advantage of several benefits, including centralized account management, self-hosted tracking, and the ability to use your own custom models."},"3065":{"id":"/tutorials/connect-to-tabby-server-6","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#prerequisites","content":"Before you start, make sure you have a running Tabby server instance. If you don't have one, you can follow the instructions on the Tabby website to set one up."},"3066":{"id":"/tutorials/connect-to-tabby-server-7","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#configuration","content":"Pochi uses a configuration file to connect to different model providers. To connect to Tabby, you'll need to add a new provider configuration to your ~/.pochi/config.json file."},"3067":{"id":"/tutorials/connect-to-tabby-server-8","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#configuration","content":"Here's a sample configuration for connecting to a Tabby server:"},"3068":{"id":"/tutorials/connect-to-tabby-server-9","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#parameters","content":"You'll need to change the following parameters in the configuration:"},"3069":{"id":"/tutorials/connect-to-tabby-server-10","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#parameters","content":"baseURL: Change this to the URL of your Tabby server instance."},"3070":{"id":"/tutorials/connect-to-tabby-server-11","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#parameters","content":"apiKey: Change this to your own auth token from the Tabby UI. You can find your token in the \"Token\" section of the Tabby admin panel, as shown in the screenshot below."},"3071":{"id":"/tutorials/connect-to-tabby-server-12","page_id":"/tutorials/connect-to-tabby-server","type":"text","url":"/tutorials/connect-to-tabby-server#conclusion","content":"Once you have updated the configuration file, Pochi will be able to connect to your Tabby server and use the models you have configured."},"3072":{"id":"/tutorials/handy","page_id":"/tutorials/handy","type":"page","content":"Voice-Driven Development with Handy and Pochi","url":"/tutorials/handy"},"3073":{"id":"/tutorials/handy-0","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#voice-driven-development-with-handy-and-pochi","content":"Voice-Driven Development with Handy and Pochi"},"3074":{"id":"/tutorials/handy-1","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#what-you-will-learn","content":"What You Will Learn"},"3075":{"id":"/tutorials/handy-2","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#prerequisites","content":"Prerequisites"},"3076":{"id":"/tutorials/handy-3","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#how-it-works","content":"How It Works"},"3077":{"id":"/tutorials/handy-4","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Step 1: Install and Configure Handy"},"3078":{"id":"/tutorials/handy-5","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Step 2: The Voice Coding Workflow in Action"},"3079":{"id":"/tutorials/handy-6","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#tips-and-troubleshooting","content":"Tips and Troubleshooting"},"3080":{"id":"/tutorials/handy-7","page_id":"/tutorials/handy","type":"heading","url":"/tutorials/handy#conclusion","content":"Conclusion"},"3081":{"id":"/tutorials/handy-8","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#voice-driven-development-with-handy-and-pochi","content":"This tutorial guides you through setting up an efficient, voice-driven development workflow by combining two powerful tools: Handy for local voice transcription and Pochi as your AI coding assistant."},"3082":{"id":"/tutorials/handy-9","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#voice-driven-development-with-handy-and-pochi","content":"This setup allows you to speak commands, have them transcribed into text by Handy, and then have Pochi execute those commands, creating a seamless, hands-free coding experience that keeps your audio on-device."},"3083":{"id":"/tutorials/handy-10","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#what-you-will-learn","content":"How to install and configure Handy for offline voice-to-text transcription."},"3084":{"id":"/tutorials/handy-11","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#what-you-will-learn","content":"How to integrate Handy with Pochi to create a voice-driven development workflow."},"3085":{"id":"/tutorials/handy-12","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#what-you-will-learn","content":"Tips for optimizing your setup for accuracy and efficiency."},"3086":{"id":"/tutorials/handy-13","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#prerequisites","content":"Pochi: You should have Pochi installed and running in your editor."},"3087":{"id":"/tutorials/handy-14","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#prerequisites","content":"Handy: Downloadable for macOS, Windows, and Linux from the official releases page."},"3088":{"id":"/tutorials/handy-15","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#prerequisites","content":"Microphone and accessibility permissions: Handy needs access to your microphone and the ability to paste text into other applications."},"3089":{"id":"/tutorials/handy-16","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#how-it-works","content":"Handy listens to your voice and converts it into text using on-device transcription models (Whisper or Parakeet)."},"3090":{"id":"/tutorials/handy-17","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#how-it-works","content":"Pochi takes the text generated by Handy as a command and processes it using its configured AI model."},"3091":{"id":"/tutorials/handy-18","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#how-it-works","content":"For a Fully Private Workflow\nThis tutorial focuses on the voice input aspect. For complete privacy and offline use, you can configure Pochi to use a local Large Language Model (LLM). See Pochi's documentation on model configuration for more details."},"3092":{"id":"/tutorials/handy-19","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Handy is a cross-platform desktop application built with Tauri that records your voice via a keyboard shortcut and pastes the transcribed text into any application."},"3093":{"id":"/tutorials/handy-20","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Download Handy: Get the latest version from the official releases page or the project website handy.computer."},"3094":{"id":"/tutorials/handy-21","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Install and Grant Permissions:"},"3095":{"id":"/tutorials/handy-22","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"macOS: Open the downloaded .dmg, drag Handy into your Applications folder, and launch it once. Grant Microphone and Accessibility permissions when prompted so Handy can record audio and paste text."},"3096":{"id":"/tutorials/handy-23","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Windows: Run the installer, then allow Handy to access the microphone. You may need to approve the accessibility overlay so Handy can send keystrokes."},"3097":{"id":"/tutorials/handy-24","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Linux: Make the AppImage executable (e.g., chmod +x Handy-x86_64.AppImage), run it, and approve microphone/input permissions as required by your desktop environment."},"3098":{"id":"/tutorials/handy-25","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Configure Handy Settings:"},"3099":{"id":"/tutorials/handy-26","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"A. Set Your Hotkey\nChoose a shortcut that does not conflict with other apps. Handy supports both push-to-talk and toggle behaviors. Enable Push to Talk if you want to hold the shortcut while speaking; otherwise, use the default press-to-start, press-again-to-stop mode."},"3100":{"id":"/tutorials/handy-27","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"B. Select Your Transcription Engine\nHandy can run multiple local transcription models:"},"3101":{"id":"/tutorials/handy-28","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Whisper models (Small/Medium/Turbo/Large) for GPU-accelerated accuracy on macOS, Windows, and Linux."},"3102":{"id":"/tutorials/handy-29","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"Parakeet V3 for fast CPU-only transcription with automatic language detection."},"3103":{"id":"/tutorials/handy-30","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"C. Download Your Model"},"3104":{"id":"/tutorials/handy-31","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"The first time you pick a model, Handy downloads and optimizes it. This may take several minutes and will temporarily increase CPU usage."},"3105":{"id":"/tutorials/handy-32","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-1-install-and-configure-handy","content":"D. Customize Output Behavior\nTune options such as automatic text pasting, capitalization, and whether Handy should clear or append text after each recording."},"3106":{"id":"/tutorials/handy-33","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"With Handy installed, let's try the workflow."},"3107":{"id":"/tutorials/handy-34","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Open Pochi: Launch Pochi's chat interface in your code editor."},"3108":{"id":"/tutorials/handy-35","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Activate Handy: Click inside Pochi's input box, then use the shortcut you configured for Handy. Handy shows an on-screen indicator when it is listening."},"3109":{"id":"/tutorials/handy-36","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Speak Your Command: Clearly state the task you want Pochi to perform. For example:"},"3110":{"id":"/tutorials/handy-37","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Write a TypeScript function that takes an array of strings and returns the longest one."},"3111":{"id":"/tutorials/handy-38","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Transcription: When you stop recording, Handy transcribes your speech and pastes the text into Pochi's input box (or copies it to the clipboard, depending on your settings)."},"3112":{"id":"/tutorials/handy-39","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#step-2-the-voice-coding-workflow-in-action","content":"Execution: Pochi sends the text to its configured AI model for processing. The generated code or response appears in the chat."},"3113":{"id":"/tutorials/handy-40","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#tips-and-troubleshooting","content":"Inaccurate Transcription?\nTry switching to a larger Whisper model or to Parakeet V3 for improved accuracy on CPU-only systems."},"3114":{"id":"/tutorials/handy-41","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#tips-and-troubleshooting","content":"Performance Concerns?\nSmaller Whisper models consume fewer resources. If latency is high, choose a smaller model or use Parakeet V3."},"3115":{"id":"/tutorials/handy-42","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#tips-and-troubleshooting","content":"Need Help with Handy?\nOpen an issue on the GitHub repository."},"3116":{"id":"/tutorials/handy-43","page_id":"/tutorials/handy","type":"text","url":"/tutorials/handy#conclusion","content":"By combining Handy and Pochi, you've created a fast and efficient voice-powered programming environment. This setup gives you a modern, hands-free way to translate your ideas into code while keeping the entire transcription pipeline on your device."},"3117":{"id":"/tutorials","page_id":"/tutorials","type":"page","content":"Tutorials","url":"/tutorials"},"3118":{"id":"/tutorials-0","page_id":"/tutorials","type":"heading","url":"/tutorials#tutorials","content":"Tutorials"},"3119":{"id":"/tutorials-1","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Welcome to the Pochi tutorials section. Here you will find step-by-step guides to help you get the most out of Pochi."},"3120":{"id":"/tutorials-2","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Secure Production DB Access in Pochi"},"3121":{"id":"/tutorials-3","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Vibe Coding a macOS GitHub Client in Pochi"},"3122":{"id":"/tutorials-4","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Connect to Tabby Server for Enhanced Enterprise Experience"},"3123":{"id":"/tutorials-5","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Build a Custom MCP Server to Query Supabase with Natural Language in Pochi"},"3124":{"id":"/tutorials-6","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Visual Communication with Mermaid Graphs"},"3125":{"id":"/tutorials-7","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Voice-Driven Development with Handy and Pochi"},"3126":{"id":"/tutorials-8","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Practical Guide to Building Parallel Agents Workflow"},"3127":{"id":"/tutorials-9","page_id":"/tutorials","type":"text","url":"/tutorials#tutorials","content":"Manage Library Migration At Team Scale"},"3128":{"id":"/tutorials/manage-library-migration-at-team-scale","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"page","content":"Manage Library Migration At Team Scale","url":"/tutorials/manage-library-migration-at-team-scale"},"3129":{"id":"/tutorials/manage-library-migration-at-team-scale-0","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#manage-library-migration-at-team-scale","content":"Manage Library Migration At Team Scale"},"3130":{"id":"/tutorials/manage-library-migration-at-team-scale-1","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"Project Setup"},"3131":{"id":"/tutorials/manage-library-migration-at-team-scale-2","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"One-Shot Migration Prompt"},"3132":{"id":"/tutorials/manage-library-migration-at-team-scale-3","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Migration Skill"},"3133":{"id":"/tutorials/manage-library-migration-at-team-scale-4","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#enforcing-the-standard-with-eslint","content":"Enforcing the Standard with ESLint"},"3134":{"id":"/tutorials/manage-library-migration-at-team-scale-5","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"heading","url":"/tutorials/manage-library-migration-at-team-scale#conclusion","content":"Conclusion"},"3135":{"id":"/tutorials/manage-library-migration-at-team-scale-6","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#manage-library-migration-at-team-scale","content":"Library  migration is a common but tedious part of maintaining production systems in an engineering team. It often involves coordinating changes across source code, dependencies, configuration, Docker images, and CI pipelines. When these changes need to be repeated across multiple repositories, keeping everything consistent quickly becomes difficult."},"3136":{"id":"/tutorials/manage-library-migration-at-team-scale-7","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#manage-library-migration-at-team-scale","content":"Structured migration prompts in Pochi can automate much of this work by applying coordinated changes across a repository in a single execution. However, a successful migration is only part of the solution. If the upgrade logic remains inside a prompt, it is not reusable, version-controlled, or enforceable across repositories."},"3137":{"id":"/tutorials/manage-library-migration-at-team-scale-8","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#manage-library-migration-at-team-scale","content":"In this article, we demonstrate how we evolve the migration solution into a reusable Skill,  and eventually enforce it with CI and lint checks to become an executable engineering standard."},"3138":{"id":"/tutorials/manage-library-migration-at-team-scale-9","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#manage-library-migration-at-team-scale","content":"Let's take the  runtime upgrade from Node 18 to Node 20 as a working example."},"3139":{"id":"/tutorials/manage-library-migration-at-team-scale-10","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"We have two small sample repositories (backend-service and admin-cli) running Node 18 + CommonJS with Docker and GitHub Actions pinned to Node 18."},"3140":{"id":"/tutorials/manage-library-migration-at-team-scale-11","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"The goal was to migrate them to Node 20 + strict ESM."},"3141":{"id":"/tutorials/manage-library-migration-at-team-scale-12","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"For some variation, the structure of backend-service repository looked like this:"},"3142":{"id":"/tutorials/manage-library-migration-at-team-scale-13","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"Here’s an example of the current CommonJS usage we had in it:"},"3143":{"id":"/tutorials/manage-library-migration-at-team-scale-14","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"It built and passed tests successfully:"},"3144":{"id":"/tutorials/manage-library-migration-at-team-scale-15","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"Your browser does not support the video tag."},"3145":{"id":"/tutorials/manage-library-migration-at-team-scale-16","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#project-setup","content":"The admin-cli repo was intentionally a bit different. It used a CLI entry point and had a slightly modified tsconfig and Jest files. It even had a small Scripts folder."},"3146":{"id":"/tutorials/manage-library-migration-at-team-scale-17","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"We started with the most straightforward approach. Inside backend-service, we ran a Pochi task with the following prompt:"},"3147":{"id":"/tutorials/manage-library-migration-at-team-scale-18","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"We did this using a strong model (claude-4-5-opus), and the migration completed successfully."},"3148":{"id":"/tutorials/manage-library-migration-at-team-scale-19","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"Your browser does not support the video tag."},"3149":{"id":"/tutorials/manage-library-migration-at-team-scale-20","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"The build passed, tests succeeded, and a quick grep confirmed no require() or node:18 references remained."},"3150":{"id":"/tutorials/manage-library-migration-at-team-scale-21","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"Your browser does not support the video tag."},"3151":{"id":"/tutorials/manage-library-migration-at-team-scale-22","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"The one-shot migration worked. But the upgrade logic lived entirely inside that prompt."},"3152":{"id":"/tutorials/manage-library-migration-at-team-scale-23","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#one-shot-migration-prompt","content":"Reusing it across repositories or evolving it later (Node 22, new testing rules, etc.), would mean rewriting and re-running prompts manually. Instead of keeping standards in chat history, we encoded them as a reusable Skill."},"3153":{"id":"/tutorials/manage-library-migration-at-team-scale-24","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"We moved the migration spec into a reusable Skill stored in a central repository. A Skill in Pochi is a version-controlled set of instructions that agents can execute when performing a task."},"3154":{"id":"/tutorials/manage-library-migration-at-team-scale-25","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"By encoding the migration as a Skill instead of keeping it in a prompt, the upgrade logic becomes reusable across repositories, shared across the team, and actively maintained in one place as the standard evolves."},"3155":{"id":"/tutorials/manage-library-migration-at-team-scale-26","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"To store this shared standard, we created a small repository that contains the Skill definition:"},"3156":{"id":"/tutorials/manage-library-migration-at-team-scale-27","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Inside the repository, we created the following structure:"},"3157":{"id":"/tutorials/manage-library-migration-at-team-scale-28","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Inside skills/node20-esm-org-standard/SKILL.md, we defined the full specification for our Node 20 + strict ESM standard."},"3158":{"id":"/tutorials/manage-library-migration-at-team-scale-29","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Now that the Skill was defined, we applied it to one of our existing repositories. First, we switched back to admin-cli:"},"3159":{"id":"/tutorials/manage-library-migration-at-team-scale-30","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Then we added the Skill from the central standards repository:"},"3160":{"id":"/tutorials/manage-library-migration-at-team-scale-31","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"This installed the Skill into:"},"3161":{"id":"/tutorials/manage-library-migration-at-team-scale-32","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Your browser does not support the video tag."},"3162":{"id":"/tutorials/manage-library-migration-at-team-scale-33","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"By default, this got added as a symlink. That means if we update the Skill in org-engineering-standards, those updates are automatically reflected in every repository using it."},"3163":{"id":"/tutorials/manage-library-migration-at-team-scale-34","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"The standard now lives in one place."},"3164":{"id":"/tutorials/manage-library-migration-at-team-scale-35","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#migration-skill","content":"Once the Skill is installed, repositories can share the same migration logic without copying prompts between projects. Any repository that adopts the Skill inherits the standard defined in the central repository."},"3165":{"id":"/tutorials/manage-library-migration-at-team-scale-36","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#enforcing-the-standard-with-eslint","content":"The Skill defines how the migration should happen, but it doesn’t prevent someone from accidentally reintroducing CommonJS later. To deploy this in a team setting, we'd prefer having it more natively embedded in our CI as part of our code standard, so it can be autonomously running to enforce using the latest library for all future code changes."},"3166":{"id":"/tutorials/manage-library-migration-at-team-scale-37","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#enforcing-the-standard-with-eslint","content":"To do so, we added ESLint rules that reject require() and module.exports. The repository now runs npm run lint in CI on every push and pull request."},"3167":{"id":"/tutorials/manage-library-migration-at-team-scale-38","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#enforcing-the-standard-with-eslint","content":"If CommonJS appears again, the lint step fails and the pipeline stops. This turns the standard into something that is automatically enforced rather than something developers have to remember."},"3168":{"id":"/tutorials/manage-library-migration-at-team-scale-39","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#enforcing-the-standard-with-eslint","content":"Your browser does not support the video tag."},"3169":{"id":"/tutorials/manage-library-migration-at-team-scale-40","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#conclusion","content":"At this point the migration, the standard, and its enforcement all live inside the repository itself.  The migration itself wasn’t the interesting part. The interesting part was moving from a one-off prompt that upgrades a repo to a reusable, version-controlled, executable standard."},"3170":{"id":"/tutorials/manage-library-migration-at-team-scale-41","page_id":"/tutorials/manage-library-migration-at-team-scale","type":"text","url":"/tutorials/manage-library-migration-at-team-scale#conclusion","content":"Node 20 was just the example. The real experiment was looking at how we can treat engineering standards as code and how Pochi’s Skills system helps us achieve that."},"3171":{"id":"/tutorials/mermaid-graph","page_id":"/tutorials/mermaid-graph","type":"page","content":"Visualizing the Dialogue: How Pochi Uses Mermaid Graphs to Communicate","url":"/tutorials/mermaid-graph"},"3172":{"id":"/tutorials/mermaid-graph-0","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#visualizing-the-dialogue-how-pochi-uses-mermaid-graphs-to-communicate","content":"Visualizing the Dialogue: How Pochi Uses Mermaid Graphs to Communicate"},"3173":{"id":"/tutorials/mermaid-graph-1","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#a-visual-conversation-for-complex-tasks","content":"A Visual Conversation for Complex Tasks"},"3174":{"id":"/tutorials/mermaid-graph-2","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#example-pochi-proposes-a-complex-refactor","content":"Example: Pochi Proposes a Complex Refactor"},"3175":{"id":"/tutorials/mermaid-graph-3","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#core-components","content":"Core Components:"},"3176":{"id":"/tutorials/mermaid-graph-4","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"SSR Challenges Identified:"},"3177":{"id":"/tutorials/mermaid-graph-5","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"Example: Pochi Clarifies Business Logic with a Flowchart"},"3178":{"id":"/tutorials/mermaid-graph-6","page_id":"/tutorials/mermaid-graph","type":"heading","url":"/tutorials/mermaid-graph#conclusion-your-dialogue-with-pochi","content":"Conclusion: Your Dialogue with Pochi"},"3179":{"id":"/tutorials/mermaid-graph-7","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#visualizing-the-dialogue-how-pochi-uses-mermaid-graphs-to-communicate","content":"When Pochi tackles a large-scale code change, a monologue of text and code is not an effective way to collaborate. To have a clear dialogue with you, Pochi translates its plans into Mermaid graphs."},"3180":{"id":"/tutorials/mermaid-graph-8","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#visualizing-the-dialogue-how-pochi-uses-mermaid-graphs-to-communicate","content":"Think of these diagrams as Pochi's whiteboard, where it sketches out its ideas for you to review. It's a communication tool designed to turn a complex plan into a simple, visual conversation. This allows you to understand, approve, and guide Pochi's approach before it writes a single line of code."},"3181":{"id":"/tutorials/mermaid-graph-9","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#a-visual-conversation-for-complex-tasks","content":"Pochi automatically generates Mermaid graphs when it needs to discuss its plan for complex tasks, such as:"},"3182":{"id":"/tutorials/mermaid-graph-10","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#a-visual-conversation-for-complex-tasks","content":"Architectural Changes: Showing how the overall structure of your application will be modified."},"3183":{"id":"/tutorials/mermaid-graph-11","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#a-visual-conversation-for-complex-tasks","content":"Complex Refactoring: Breaking down a large function or class into smaller pieces."},"3184":{"id":"/tutorials/mermaid-graph-12","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#a-visual-conversation-for-complex-tasks","content":"New Feature Implementation: Visualizing how a new feature will interact with existing components."},"3185":{"id":"/tutorials/mermaid-graph-13","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-proposes-a-complex-refactor","content":"When preparing for a significant refactoring, Pochi uses a diagram to discuss the proposed architecture with you. In this example, Pochi was asked to refactor a component for Server-Side Rendering (SSR). It first analyzed the code, then generated the following diagram to explain its findings and get your feedback."},"3186":{"id":"/tutorials/mermaid-graph-14","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-proposes-a-complex-refactor","content":"This diagram provides a clear overview of the system, which was then used to formulate a refactoring plan. The analysis highlighted several key areas:"},"3187":{"id":"/tutorials/mermaid-graph-15","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#core-components","content":"ToolInvocationPart: The main entry point that routes tools to the correct renderer."},"3188":{"id":"/tutorials/mermaid-graph-16","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#core-components","content":"Tools Registry: A static mapping of tool names to their corresponding React components."},"3189":{"id":"/tutorials/mermaid-graph-17","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#core-components","content":"McpToolCall: A specialized renderer for tools using the Model Context Protocol (MCP)."},"3190":{"id":"/tutorials/mermaid-graph-18","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#core-components","content":"Shared UI Components: A library of reusable components like containers, icons, and badges."},"3191":{"id":"/tutorials/mermaid-graph-19","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"The diagram helped identify three major challenges for implementing SSR:"},"3192":{"id":"/tutorials/mermaid-graph-20","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"Client-Side State Dependencies: Heavy reliance on React hooks (useState, useCallback) and context providers for managing the tool lifecycle, which are not available on the server."},"3193":{"id":"/tutorials/mermaid-graph-21","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"Browser/Environment Dependencies: Components with direct dependencies on browser-specific features like XTerm.js, VS Code APIs, and file system interactions."},"3194":{"id":"/tutorials/mermaid-graph-22","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"Dynamic Component Resolution: The architecture relies on a runtime tool registry and conditional rendering based on the tool's execution state, which is difficult to resolve on the server."},"3195":{"id":"/tutorials/mermaid-graph-23","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#ssr-challenges-identified","content":"By visualizing the architecture, Pochi enabled the user to quickly understand the problem and approve the proposed strategy."},"3196":{"id":"/tutorials/mermaid-graph-24","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"For changes to business logic, a code diff can be hard to follow. Pochi uses flowcharts to walk you through the new logic step-by-step. When asked to modify a task persistence feature, Pochi generated this flowchart to explain the new process."},"3197":{"id":"/tutorials/mermaid-graph-25","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"This visual explanation makes it much easier to verify the correctness of the new logic:"},"3198":{"id":"/tutorials/mermaid-graph-26","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"Time Check: The process starts with a throttling mechanism to prevent spamming the API."},"3199":{"id":"/tutorials/mermaid-graph-27","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"API Call: If the check passes, it queries messages and calls the persistence API."},"3200":{"id":"/tutorials/mermaid-graph-28","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"Error Handling: It includes a clear path for what happens if the API call fails."},"3201":{"id":"/tutorials/mermaid-graph-29","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"State Update: It shows how the local state is updated with a shareId upon success."},"3202":{"id":"/tutorials/mermaid-graph-30","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#example-pochi-clarifies-business-logic-with-a-flowchart","content":"This turns a code review into a collaborative check of the logic, ensuring you and Pochi are on the same page."},"3203":{"id":"/tutorials/mermaid-graph-31","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#conclusion-your-dialogue-with-pochi","content":"Mermaid graphs are more than just diagrams; they are the bridge for communication between you and Pochi. They transform a potential monologue of code into a clear, interactive dialogue about the best path forward."},"3204":{"id":"/tutorials/mermaid-graph-32","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#conclusion-your-dialogue-with-pochi","content":"When you see Pochi generate a Mermaid graph, it's an invitation to collaborate. Take a moment to review it—your feedback is crucial for guiding the AI and ensuring the final result meets your exact expectations."},"3205":{"id":"/tutorials/mermaid-graph-33","page_id":"/tutorials/mermaid-graph","type":"text","url":"/tutorials/mermaid-graph#conclusion-your-dialogue-with-pochi","content":"And remember, this is a two-way conversation. If you ever feel that Pochi's plan is unclear, you can proactively ask it to generate a Mermaid graph. Just say, \"Can you explain that with a Mermaid diagram?\" This puts you in control, allowing you to request visual clarity whenever you need it."},"3206":{"id":"/tutorials/parallel-agent-guidance","page_id":"/tutorials/parallel-agent-guidance","type":"page","content":"Practical Guide to Building Parallel Agents Workflow","url":"/tutorials/parallel-agent-guidance"},"3207":{"id":"/tutorials/parallel-agent-guidance-0","page_id":"/tutorials/parallel-agent-guidance","type":"text","url":"/tutorials/parallel-agent-guidance","content":"A practical guide to using Pochi's Parallel Agents for concurrent development - learn best practices through a hands-on project."},"3208":{"id":"/tutorials/parallel-agent-guidance-1","page_id":"/tutorials/parallel-agent-guidance","type":"heading","url":"/tutorials/parallel-agent-guidance#practical-guide-to-building-parallel-agents-workflow","content":"Practical Guide to Building Para